<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- RS0041: Razor's generated BuildRenderTree overrides use nullable-oblivious types. -->
    <NoWarn>$(NoWarn);CA1812;RS0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
    <ProjectReference Include="..\Sheddueller\Sheddueller.csproj" />
  </ItemGroup>

  <!-- Hosted services shared with Sheddueller.Worker. -->
  <ItemGroup>
    <Compile Include="..\Shared\Hosting\*.cs" LinkBase="Shared\Hosting" />
  </ItemGroup>
</Project>
