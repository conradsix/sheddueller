@implements IAsyncDisposable
@inject IJSRuntime Js
@inject IDashboardThroughputReader ThroughputReader

@{
    var view = _snapshot is null ? null : DashboardThroughputView.Create(_snapshot, Window);
}

<Card Title="Throughput" Description="@Description(view)" Class="throughput-card">
    @if (view is null)
    {
        <div class="throughput-chart throughput-chart--empty">
            <Icon Name="chart-line" />
            <span>Waiting for throughput data</span>
        </div>
    }
    else
    {
        var totals = view.Totals;

        <div class="throughput-legend" role="group" aria-label="Show or hide series">
            @foreach (var series in SeriesDefinitions)
            {
                var visible = IsSeriesVisible(series.Key);
                <button type="button" class="throughput-legend__item" style="@SwatchStyle(series)"
                        aria-pressed="@(visible ? "true" : "false")"
                        data-sd-tooltip="@(visible ? $"Hide {series.Label}" : $"Show {series.Label}")"
                        @onclick="() => ToggleSeries(series.Key)">
                    <span class="throughput-legend__key" aria-hidden="true"></span>
                    <span class="throughput-legend__label">@series.Label</span>
                    <span class="throughput-legend__total">@DashboardFormat.Count(series.Value(totals))</span>
                </button>
            }
        </div>

        <div class="throughput-chart">
            <div class="throughput-chart__plot" @ref="_chartElement"></div>
            @if (!view.HasActivity)
            {
                <div class="throughput-chart__empty">No job events in this period</div>
            }
        </div>
    }
</Card>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    // Colours are design tokens, validated as a set for adjacent-series separation in both themes; the legend shows
    // the same token. Queued is the low-chroma context line on purpose.
    private static readonly ThroughputSeriesDefinition[] SeriesDefinitions =
    [
        new("queued", "Queued", "--state-queued", static bucket => bucket.QueuedCount),
        new("started", "Started", "--chart-1", static bucket => bucket.StartedCount),
        new("succeeded", "Succeeded", "--state-completed", static bucket => bucket.SucceededCount),
        new("failed", "Failed", "--chart-4", static bucket => bucket.FailedCount),
        new("canceled", "Canceled", "--chart-5", static bucket => bucket.CanceledCount),
        new("failedAttempts", "Failed attempts", "--state-waiting", static bucket => bucket.FailedAttemptCount),
    ];

    private readonly CancellationTokenSource _refreshCancellation = new();
    private readonly HashSet<string> _hiddenSeriesKeys = new(StringComparer.Ordinal);

    private DashboardThroughputSnapshot? _snapshot;
    private ElementReference _chartElement;
    private PeriodicTimer? _refreshTimer;
    private Task? _refreshTask;
    private bool _chartRendered;
    private bool _disposed;

    /// <summary>
    /// The metrics window the chart follows. The chart covers at most the history the dashboard keeps.
    /// </summary>
    [Parameter]
    public TimeSpan Window { get; set; } = TimeSpan.FromHours(1);

    /// <summary>
    /// Whether the page's auto-refresh is on; the chart refreshes only while it is. Always on when not set.
    /// </summary>
    [Parameter]
    public Func<bool>? AutoRefreshEnabledProvider { get; set; }

    private bool IsAutoRefreshEnabled
      => this.AutoRefreshEnabledProvider?.Invoke() ?? true;

    protected override void OnInitialized()
      => this._snapshot = ThroughputReader.GetSnapshot();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.StartRefreshTimer();
        }

        if (this._snapshot is null)
        {
            return;
        }

        var view = DashboardThroughputView.Create(this._snapshot, this.Window);
        await Js.InvokeVoidAsync("shedduellerThroughputChart.render", this._chartElement, this.CreateModel(view));
        this._chartRendered = true;
    }

    public async ValueTask DisposeAsync()
    {
        this._disposed = true;
        await this._refreshCancellation.CancelAsync().ConfigureAwait(false);
        this._refreshTimer?.Dispose();

        if (this._refreshTask is not null)
        {
            await this._refreshTask.ConfigureAwait(false);
        }

        this._refreshCancellation.Dispose();

        if (this._chartRendered)
        {
            try
            {
                await Js.InvokeVoidAsync("shedduellerThroughputChart.destroy", this._chartElement);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        GC.SuppressFinalize(this);
    }

    private void StartRefreshTimer()
    {
        this._refreshTimer = new PeriodicTimer(RefreshInterval);
        this._refreshTask = this.RunRefreshTimerAsync(this._refreshTimer, this._refreshCancellation.Token);
    }

    private async Task RunRefreshTimerAsync(
        PeriodicTimer timer,
        CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
            {
                if (this.IsAutoRefreshEnabled)
                {
                    await this.RefreshSnapshotAsync(cancellationToken).ConfigureAwait(false);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshSnapshotAsync(CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        var snapshot = ThroughputReader.GetSnapshot();
        await this.InvokeAsync(() =>
        {
            if (!this._disposed)
            {
                this._snapshot = snapshot;
                this.StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    private static string Description(DashboardThroughputView? view)
      => view is null
        ? "Job events as they happen"
        : view.CoverageNote is { } note ? string.Concat(view.Caption, ". ", note) : view.Caption;

    private bool IsSeriesVisible(string key)
      => !this._hiddenSeriesKeys.Contains(key);

    // Each legend item switches its own series on or off; the others keep their state and colour.
    private void ToggleSeries(string key)
    {
        if (!this._hiddenSeriesKeys.Remove(key))
        {
            this._hiddenSeriesKeys.Add(key);
        }
    }

    private static string SwatchStyle(ThroughputSeriesDefinition series)
      => string.Concat("--series-color: var(", series.ColorToken, ")");

    private ThroughputChartModel CreateModel(DashboardThroughputView view)
      => new(
        (int)view.BucketSize.TotalSeconds,
        view.WindowStartUtc?.ToUnixTimeSeconds() ?? 0,
        view.WindowEndUtc?.ToUnixTimeSeconds() ?? 0,
        [.. view.Buckets.Select(static bucket => bucket.StartedAtUtc.ToUnixTimeSeconds())],
        [
            .. SeriesDefinitions.Select(series => new ThroughputChartSeries(
              series.Label,
              series.ColorToken,
              this.IsSeriesVisible(series.Key),
              [.. view.Buckets.Select(series.Value)])),
        ]);

    private sealed record ThroughputChartModel(
        int BucketSizeSeconds,
        long WindowStartUnixSeconds,
        long WindowEndUnixSeconds,
        long[] Timestamps,
        ThroughputChartSeries[] Series);

    private sealed record ThroughputChartSeries(
        string Label,
        string ColorToken,
        bool Visible,
        int[] Values);

    private sealed record ThroughputSeriesDefinition(
        string Key,
        string Label,
        string ColorToken,
        Func<DashboardThroughputBucket, int> Value);
}
