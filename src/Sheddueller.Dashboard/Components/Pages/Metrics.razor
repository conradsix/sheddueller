@page "/metrics"
@inherits DashboardPageComponent
@inject IDashboardMetricsReader Reader

<div class="sd-page metrics-page">
    <PageHeader Title="Metrics" Description="Scheduler health and throughput. Rates and latencies cover the selected window.">
        <Actions>
            <Tabs TValue="TimeSpan" Items="WindowTabs" Value="_selectedWindow" Label="Metrics window" />
        </Actions>
    </PageHeader>

    @if (_metricsUnsupported)
    {
        <EmptyState Icon="chart-line" Title="Metrics aren't available">
            The configured job store doesn't provide rolling metrics.
        </EmptyState>
    }
    else if (_loadError is not null)
    {
        <Alert Tone="AlertTone.Destructive" Title="Metrics couldn't be loaded">
            <ChildContent>@_loadError</ChildContent>
            <Actions>
                <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="LoadAsync">Try again</Button>
            </Actions>
        </Alert>
    }
    else if (_isLoading && _snapshot is null)
    {
        <div class="metrics-stats" aria-busy="true" aria-label="Loading metrics">
            @for (var index = 0; index < SkeletonTileCount; index++)
            {
                <div class="metrics-stat" aria-hidden="true">
                    <Skeleton Width="45%" />
                    <Skeleton Width="35%" Height="28px" />
                    <Skeleton Width="70%" Height="12px" />
                </div>
            }
        </div>
    }
    else if (Windows.Count == 0)
    {
        <EmptyState Icon="chart-line" Title="No metrics yet">
            The job store returned no metric windows.
        </EmptyState>
    }
    else if (SelectedWindow is { } selectedWindow)
    {
        @if (LiveRefresh.RefreshError is not null)
        {
            <Alert Tone="AlertTone.Warning" Meta="StaleDataNote" Title="Couldn't refresh metrics">
                <ChildContent>@LiveRefresh.RefreshError</ChildContent>
                <Actions>
                    <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="RetryRefreshAsync">Try again</Button>
                </Actions>
            </Alert>
        }

        <section class="metrics-section" aria-labelledby="metrics-now-title">
            <header class="metrics-section__header">
                <h2 id="metrics-now-title" class="metrics-section__title">Now</h2>
                <p class="metrics-section__description">Current counts, whatever the window.</p>
            </header>
            <div class="metrics-stats">
                <a class="metrics-stat" href="@QueuedHref">
                    <span class="metrics-stat__label"><span class="sd-state-dot sd-state-dot--queued" aria-hidden="true"></span>Queued</span>
                    <span class="metrics-stat__value">@DashboardFormat.Count(selectedWindow.QueuedCount)</span>
                    <span class="metrics-stat__detail">@OldestQueuedText(selectedWindow)</span>
                </a>
                <a class="metrics-stat" href="@RunningHref">
                    <span class="metrics-stat__label"><span class="sd-state-dot sd-state-dot--claimed" aria-hidden="true"></span>Running</span>
                    <span class="metrics-stat__value">@DashboardFormat.Count(selectedWindow.ClaimedCount)</span>
                    <span class="metrics-stat__detail">@ActiveNodesText(selectedWindow)</span>
                </a>
                <a class="@AttentionStatClass(selectedWindow.StaleNodeCount + selectedWindow.DeadNodeCount, AttentionTone.Warning)" href="nodes">
                    <span class="metrics-stat__label"><Icon Name="server" />Active nodes</span>
                    <span class="metrics-stat__value">@DashboardFormat.Count(selectedWindow.ActiveNodeCount)</span>
                    <span class="metrics-stat__detail">@UnhealthyNodesText(selectedWindow)</span>
                </a>
                <a class="@AttentionStatClass(selectedWindow.SaturatedConcurrencyGroupCount, AttentionTone.Warning)" href="@SaturatedGroupsHref">
                    <span class="metrics-stat__label"><Icon Name="layers" />Saturated groups</span>
                    <span class="metrics-stat__value">@DashboardFormat.Count(selectedWindow.SaturatedConcurrencyGroupCount)</span>
                    <span class="metrics-stat__detail">At their concurrency limit</span>
                </a>
            </div>
        </section>

        <section class="metrics-section" aria-labelledby="metrics-window-title">
            <header class="metrics-section__header">
                <h2 id="metrics-window-title" class="metrics-section__title">@WindowTitle(selectedWindow.Window)</h2>
                <p class="metrics-section__description">Rates and latencies for the selected window.</p>
            </header>

            @if (DashboardMetricsFormat.HasNoActivity(selectedWindow))
            {
                <Alert Tone="AlertTone.Info" Title="@($"No job activity in the {WindowPhrase(selectedWindow.Window)}")">
                    Counts show zero and latencies show a dash until jobs run.
                </Alert>
            }

            <div class="metrics-stats">
                <div class="metrics-stat">
                    <span class="metrics-stat__label"><span class="sd-state-dot sd-state-dot--completed" aria-hidden="true"></span>Completed</span>
                    <span class="metrics-stat__value">@DashboardMetricsFormat.Rate(selectedWindow.SuccessRatePerMinute)</span>
                    <span class="metrics-stat__detail">
                        Enqueued @DashboardMetricsFormat.Rate(selectedWindow.EnqueueRatePerMinute), started @DashboardMetricsFormat.Rate(selectedWindow.ClaimRatePerMinute)
                    </span>
                </div>
                <a class="@AttentionStatClass(selectedWindow.FailedCount, AttentionTone.Destructive)" href="@FailedHref">
                    <span class="metrics-stat__label"><span class="sd-state-dot sd-state-dot--failed" aria-hidden="true"></span>Failed</span>
                    <span class="metrics-stat__value">@DashboardFormat.Count(selectedWindow.FailedCount)</span>
                    <span class="metrics-stat__detail">
                        Failing @DashboardMetricsFormat.Rate(selectedWindow.FailureRatePerMinute), retrying @DashboardMetricsFormat.Rate(selectedWindow.RetryRatePerMinute)
                    </span>
                </a>
                <div class="metrics-stat">
                    <span class="metrics-stat__label"><Icon Name="hourglass" />Queue latency, p95</span>
                    <span class="metrics-stat__value">@DashboardMetricsFormat.Duration(selectedWindow.P95QueueLatency)</span>
                    <span class="metrics-stat__detail">Median @DashboardMetricsFormat.Duration(selectedWindow.P50QueueLatency)</span>
                </div>
                <div class="metrics-stat">
                    <span class="metrics-stat__label"><Icon Name="timer" />Run time, p95</span>
                    <span class="metrics-stat__value">@DashboardMetricsFormat.Duration(selectedWindow.P95ExecutionDuration)</span>
                    <span class="metrics-stat__detail">Median @DashboardMetricsFormat.Duration(selectedWindow.P50ExecutionDuration)</span>
                </div>
                <div class="metrics-stat">
                    <span class="metrics-stat__label"><Icon Name="calendar-clock" />Schedule lag, p95</span>
                    <span class="metrics-stat__value">@DashboardMetricsFormat.Duration(selectedWindow.P95ScheduleFireLag)</span>
                    <span class="metrics-stat__detail">How late schedules fired</span>
                </div>
            </div>

            <ThroughputChart Window="selectedWindow.Window" AutoRefreshEnabledProvider="@(() => LiveRefresh.AutoRefreshEnabled)" />
        </section>

        <Card Flush="true" Title="All windows" Description="Compare the windows side by side. Rates are per minute; latencies are the 95th percentile."
              Class="metrics-compare">
            <div class="sd-table-scroll">
                <table class="sd-table metrics-compare__table">
                    <thead>
                        <tr class="metrics-compare__groups">
                            <th rowspan="2" scope="col">Window</th>
                            <th colspan="2" scope="colgroup" class="metrics-compare__group">Jobs</th>
                            <th colspan="5" scope="colgroup" class="metrics-compare__group">Rate</th>
                            <th colspan="3" scope="colgroup" class="metrics-compare__group">95th percentile</th>
                        </tr>
                        <tr>
                            <th scope="col" class="metrics-compare__num metrics-compare__start">Failed</th>
                            <th scope="col" class="metrics-compare__num">Canceled</th>
                            <th scope="col" class="metrics-compare__num metrics-compare__start">Enqueued</th>
                            <th scope="col" class="metrics-compare__num">Started</th>
                            <th scope="col" class="metrics-compare__num">Completed</th>
                            <th scope="col" class="metrics-compare__num">Failed</th>
                            <th scope="col" class="metrics-compare__num">Retried</th>
                            <th scope="col" class="metrics-compare__num metrics-compare__start">Queue latency</th>
                            <th scope="col" class="metrics-compare__num">Run time</th>
                            <th scope="col" class="metrics-compare__num">Schedule lag</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var window in Windows)
                        {
                            var selected = window.Window == selectedWindow.Window;
                            <tr @key="window.Window" class="@(selected ? "metrics-compare__row--selected" : null)" aria-current="@(selected ? "true" : null)">
                                <td class="metrics-compare__window">
                                    @DashboardMetricsFormat.WindowLabel(window.Window)
                                    @if (selected)
                                    {
                                        <span class="sd-sr-only">(selected)</span>
                                    }
                                </td>
                                <td class="metrics-compare__num metrics-compare__start">
                                    <span class="@DashboardMetricsFormat.AttentionValueClass(window.FailedCount)">@DashboardFormat.Count(window.FailedCount)</span>
                                </td>
                                <td class="metrics-compare__num">@DashboardFormat.Count(window.CanceledCount)</td>
                                <td class="metrics-compare__num metrics-compare__start">@DashboardMetricsFormat.Rate(window.EnqueueRatePerMinute)</td>
                                <td class="metrics-compare__num">@DashboardMetricsFormat.Rate(window.ClaimRatePerMinute)</td>
                                <td class="metrics-compare__num">@DashboardMetricsFormat.Rate(window.SuccessRatePerMinute)</td>
                                <td class="metrics-compare__num">
                                    <span class="@DashboardMetricsFormat.AttentionValueClass(window.FailureRatePerMinute)">@DashboardMetricsFormat.Rate(window.FailureRatePerMinute)</span>
                                </td>
                                <td class="metrics-compare__num">
                                    <span class="@DashboardMetricsFormat.WarningValueClass(window.RetryRatePerMinute)">@DashboardMetricsFormat.Rate(window.RetryRatePerMinute)</span>
                                </td>
                                <td class="metrics-compare__num metrics-compare__start">@DashboardMetricsFormat.Duration(window.P95QueueLatency)</td>
                                <td class="metrics-compare__num">@DashboardMetricsFormat.Duration(window.P95ExecutionDuration)</td>
                                <td class="metrics-compare__num">@DashboardMetricsFormat.Duration(window.P95ScheduleFireLag)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
    }
</div>

@code {
    private static readonly RenderFragment StaleDataNote = @<span class="sd-alert__meta">The values below are from the last successful refresh.</span>;

    private static readonly TimeSpan PageRefreshInterval = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan[] DefaultMetricWindows = [TimeSpan.FromMinutes(5), TimeSpan.FromHours(1), TimeSpan.FromHours(24)];
    private static readonly TimeSpan DefaultSelectedWindow = TimeSpan.FromHours(1);
    private const int SkeletonTileCount = 4;

    // The window lives in the URL (metrics?window=5m); the tabs are links, so Back and shared links restore it.
    private static readonly IReadOnlyList<TabItem<TimeSpan>> WindowTabs =
    [
        .. DefaultMetricWindows.Select(window => new TabItem<TimeSpan>(
          window,
          DashboardMetricsFormat.WindowLabel(window),
          Href: DashboardMetricsWindowQuery.ToHref(window, DefaultSelectedWindow))),
    ];

    private static readonly string QueuedHref = DashboardJobFilterQuery.StateHref(JobState.Queued);
    private static readonly string RunningHref = DashboardJobFilterQuery.StateHref(JobState.Claimed);
    private static readonly string FailedHref = CreateFailedHref();
    private static readonly string SaturatedGroupsHref = DashboardConcurrencyGroupFilterQuery.ToHref(
      new DashboardConcurrencyGroupFilters { SaturatedOnly = true });

    private MetricsInspectionSnapshot? _snapshot;
    private string? _loadError;
    private TimeSpan _selectedWindow = DefaultSelectedWindow;
    private bool _isLoading;
    private bool _metricsUnsupported;

    private enum AttentionTone
    {
        Warning,
        Destructive,
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private IReadOnlyList<MetricsInspectionWindow> Windows
      => this._snapshot?.Windows ?? [];

    private MetricsInspectionWindow? SelectedWindow
      => this.Windows.FirstOrDefault(window => window.Window == this._selectedWindow)
        ?? this.Windows.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        this._selectedWindow = DashboardMetricsWindowQuery.ParseUri(this.Navigation.Uri, DefaultMetricWindows, DefaultSelectedWindow);
        this.TrackLocation(this.Navigation, DashboardMetricsWindowQuery.Path, this.ApplyLocationAsync);
        this.InitializeLiveRefresh(
          this.RefreshCurrentQueryAsync,
          showRefreshing: false,
          lastUpdatedUtc: nowUtc => this.LiveRefresh.LastUpdatedUtc ?? (this._snapshot is null ? null : nowUtc));

        await this.LoadAsync();
        this.StartPeriodicRefresh(PageRefreshInterval);
    }

    private Task ApplyLocationAsync(string location)
    {
        this._selectedWindow = DashboardMetricsWindowQuery.ParseUri(location, DefaultMetricWindows, DefaultSelectedWindow);
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        this._loadError = null;
        this._metricsUnsupported = false;
        this.LiveRefresh.ClearError();
        this._isLoading = true;

        try
        {
            var snapshot = await Reader.GetMetricsAsync(
              new MetricsInspectionQuery(DefaultMetricWindows),
              CancellationToken.None);
            this.ApplySnapshot(snapshot);
            this.LiveRefresh.MarkUpdated();
        }
        catch (NotSupportedException)
        {
            this._metricsUnsupported = true;
        }
        catch (Exception exception)
        {
            this._loadError = exception.Message;
        }
        finally
        {
            this._isLoading = false;
            this.NotifyShellRefreshChanged();
        }
    }

    private Task RetryRefreshAsync()
      => this.LiveRefresh.RefreshNowAsync();

    private async Task RefreshCurrentQueryAsync(CancellationToken cancellationToken)
    {
        var snapshot = await Reader.GetMetricsAsync(
          new MetricsInspectionQuery(DefaultMetricWindows),
          cancellationToken);
        await this.ApplyPageStateAsync(() => this.ApplySnapshot(snapshot));
    }

    private void ApplySnapshot(MetricsInspectionSnapshot snapshot)
    {
        this._snapshot = snapshot;
        this._loadError = null;
        this._metricsUnsupported = false;

        if (snapshot.Windows.Count > 0 && !snapshot.Windows.Any(window => window.Window == this._selectedWindow))
        {
            this._selectedWindow = snapshot.Windows[0].Window;
        }
    }

    private static string CreateFailedHref()
    {
        var filters = new DashboardJobFilters();
        _ = filters.ReplaceStates([JobState.Failed]);
        _ = filters.SetSort(JobInspectionSort.NewestFirst);
        return DashboardJobFilterQuery.ToHref(filters);
    }

    private static string WindowPhrase(TimeSpan window)
      => string.Concat("last ", DashboardMetricsFormat.Period(window));

    private static string WindowTitle(TimeSpan window)
      => string.Concat("Last ", DashboardMetricsFormat.Period(window));

    private static string OldestQueuedText(MetricsInspectionWindow window)
      => window.OldestQueuedAge is { } age
        ? string.Concat("Oldest waiting ", DashboardMetricsFormat.Duration(age))
        : "Nothing waiting";

    private static string ActiveNodesText(MetricsInspectionWindow window)
      => window.ActiveNodeCount == 1
        ? "On 1 active node"
        : string.Create(CultureInfo.InvariantCulture, $"On {DashboardFormat.Count(window.ActiveNodeCount)} active nodes");

    private static string UnhealthyNodesText(MetricsInspectionWindow window)
      => window.StaleNodeCount == 0 && window.DeadNodeCount == 0
        ? "None stale or dead"
        : string.Create(
          CultureInfo.InvariantCulture,
          $"{DashboardFormat.Count(window.StaleNodeCount)} stale, {DashboardFormat.Count(window.DeadNodeCount)} dead");

    private static string AttentionStatClass(
        int count,
        AttentionTone tone)
      => count <= 0
        ? "metrics-stat"
        : tone == AttentionTone.Destructive
          ? "metrics-stat metrics-stat--destructive"
          : "metrics-stat metrics-stat--warning";
}
