@page "/jobs"
@inherits DashboardPageComponent
@inject IJobInspectionReader Reader
@inject IJobManager JobManager
@inject DashboardLiveUpdateStream LiveUpdates
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject Microsoft.Extensions.Options.IOptions<ShedduellerDashboardOptions> DashboardOptions

<div class="jobs-page">
    <header class="jobs-header">
        <div>
            <h1>Jobs</h1>
            <p>@HeaderText</p>
        </div>

        <button class="jobs-clear-queued-button" type="button" title="@ClearQueuedButtonTitle"
                aria-label="@ClearQueuedButtonTitle" @onclick="ClearQueuedJobsAsync" disabled="@IsClearQueuedDisabled">
            <Icon Name="@ClearQueuedButtonIcon" />
            <span>@ClearQueuedButtonText</span>
        </button>
    </header>

    <section class="jobs-view-bar" aria-label="Job view">
        <label class="jobs-view-select">
            <span class="jobs-filter-label">View</span>
            <select class="sd-table-select" value="@_selectedViewKey" @onchange="SetViewAsync" aria-label="Select job view">
                <optgroup label="Built-in">
                    <option value="@DashboardJobViews.BuiltInKey">@DashboardJobViews.BuiltInName</option>
                </optgroup>
                @if (SharedViews.Count > 0)
                {
                    <optgroup label="Shared Presets">
                        @foreach (var view in SharedViews)
                        {
                            <option value="@view.Key" @key="view.Key">@view.Name</option>
                        }
                    </optgroup>
                }
                @if (PersonalViews.Count > 0)
                {
                    <optgroup label="My Views">
                        @foreach (var view in PersonalViews)
                        {
                            <option value="@view.Key" @key="view.Key">@view.Name</option>
                        }
                    </optgroup>
                }
            </select>
        </label>
        <span class="jobs-view-status">@CurrentViewStatus</span>
        <div class="jobs-view-actions">
            <button @ref="_columnsButton" type="button" @onclick="OpenColumnEditor" aria-expanded="@_isColumnEditorOpen">
                <Icon Name="view_column" />
                <span>Columns</span>
            </button>
            @if (CurrentView?.Source == DashboardJobViewSource.Personal)
            {
                <button type="button" @onclick="SaveCurrentViewAsync" disabled="@(!CanSaveCurrentView)">
                    <Icon Name="save" />
                    <span>Save</span>
                </button>
                <button type="button" @onclick="SaveViewAsAsync">
                    <Icon Name="save_as" />
                    <span>Save As</span>
                </button>
            }
            else
            {
                <button type="button" @onclick="SaveViewAsAsync">
                    <Icon Name="save_as" />
                    <span>Save As</span>
                </button>
            }
            <button type="button" @onclick="SetPreferredViewAsync" disabled="@(!CanSetPreferredView)">
                <Icon Name="home" />
                <span>Set Default</span>
            </button>
            @if (CurrentView?.Source == DashboardJobViewSource.Personal)
            {
                <button type="button" @onclick="RenameCurrentViewAsync">
                    <Icon Name="edit" />
                    <span>Rename</span>
                </button>
                <button class="jobs-view-delete" type="button" @onclick="DeleteCurrentViewAsync">
                    <Icon Name="delete" />
                    <span>Delete</span>
                </button>
            }
        </div>
    </section>

    <JobColumnConfigurator IsOpen="_isColumnEditorOpen" Columns="_columns"
                           HiddenBuiltInColumns="HiddenBuiltInColumns" ObservedTagNames="ObservedTagNames"
                           IsPersonalView="@(CurrentView?.Source == DashboardJobViewSource.Personal)" IsDirty="_isViewDirty"
                           CloseRequested="CloseColumnEditorAsync" SaveRequested="SaveCurrentViewAsync"
                           SaveAsRequested="SaveViewAsAsync" ResetRequested="ResetColumns"
                           AutoFitRequested="AutoFitAllColumnsAsync" ResetWidthsRequested="ResetColumnWidths"
                           ColumnMoved="MoveColumn" VisibilityChanged="SetBuiltInColumnVisible"
                           TagColumnEdited="EditTagColumn" TagColumnRemoved="RemoveColumn"
                           TagColumnAdded="AddTagColumn" ColumnWidthResetRequested="ResetColumnWidth" />

    <section class="jobs-filter-bar" aria-label="Job filters">
        <div class="jobs-status-filter" role="group" aria-label="Filter by status">
            <span class="jobs-filter-label">Status</span>
            @foreach (var state in Enum.GetValues<JobState>())
            {
                <label class="@StatusFilterClass(state)">
                    <input type="checkbox" checked="@_filters.IsStateSelected(state)" @onchange="eventArgs => SetStateFilterAsync(state, eventArgs)" />
                    <span>@state</span>
                </label>
            }
        </div>

        <div class="jobs-text-filters">
            <select class="sd-table-select jobs-sort-filter" aria-label="Sort jobs"
                    value="@_filters.Sort" @onchange="SetSortAsync">
                <option value="@JobInspectionSort.Operational">Operational Order</option>
                <option value="@JobInspectionSort.NewestFirst">Newest First</option>
            </select>
            <DashboardSearchBox Value="@_filters.HandlerContains" ValueChanged="SetHandlerContainsAsync"
                                Placeholder="Handler contains..." AriaLabel="Filter by handler substring" />
            <DashboardSearchBox Value="@_filters.TagContains" ValueChanged="SetTagContainsAsync"
                                Placeholder="Tag contains..." AriaLabel="Filter by tag substring" />
            <DashboardSearchBox Value="@_filters.ConcurrencyGroupContains" ValueChanged="SetConcurrencyGroupContainsAsync"
                                Placeholder="Group contains..." AriaLabel="Filter by concurrency group substring" />
            <button class="jobs-clear-button" type="button" @onclick="ClearAllAsync" disabled="@(!_filters.HasAppliedFilters)">
                Clear Filters
            </button>
        </div>
    </section>

    @if (_actionMessage is not null)
    {
        <DashboardInlineAlert CssClass="@ActionAlertClass" Icon="@ActionAlertIcon">
            <span>@_actionMessage</span>
        </DashboardInlineAlert>
    }

    @if (_error is not null)
    {
        <section class="jobs-message jobs-message--error" aria-live="polite">
            <Icon Name="error" />
            <div>
                <h2>Jobs failed to load</h2>
                <p>@_error</p>
            </div>
        </section>
    }
    else if (_page is null)
    {
        <section class="jobs-message" aria-live="polite">
            <Icon Name="progress_activity" />
            <div>
                <h2>Loading jobs</h2>
                <p>Reading scheduler job records.</p>
            </div>
        </section>
    }
    else
    {
        @if (LiveRefresh.RefreshError is not null)
        {
            <DashboardInlineAlert CssClass="jobs-inline-alert jobs-inline-alert--error" Icon="warning">
                <span>Refresh failed: @LiveRefresh.RefreshError</span>
            </DashboardInlineAlert>
        }

        @if (_pendingNewJobCount > 0)
        {
            <button class="jobs-load-more-button" type="button" @onclick="ShowPendingJobsAsync">@PendingJobsButtonText</button>
        }

        <div class="jobs-table-shell">
            <div class="jobs-table-wrap">
                <table class="jobs-table" style="@TableStyle">
                    <colgroup>
                        @foreach (var column in _columns)
                        {
                            <col style="@ColumnWidthStyle(column)" @key="ColumnKey(column)" />
                        }
                        <col class="jobs-table__filler" />
                    </colgroup>
                    <thead>
                        <tr>
                            @for (var index = 0; index < _columns.Count; index++)
                            {
                                var columnIndex = index;
                                var column = _columns[columnIndex];
                                <th class="@ColumnHeaderClass(column)" @key="ColumnKey(column)">
                                    <span>@DashboardJobViews.Heading(column)</span>
                                    <span class="jobs-table__resize-handle" role="separator" tabindex="0"
                                          title="Drag to resize. Double-click to fit loaded values."
                                          aria-label="Resize @DashboardJobViews.Heading(column) column"
                                          aria-orientation="vertical" aria-valuemin="@DashboardJobColumnWidths.MinimumOverride"
                                          aria-valuemax="@DashboardJobColumnWidths.MaximumOverride" aria-valuenow="@ColumnWidth(column)"
                                          data-sd-column-resizer data-column-index="@columnIndex"
                                          data-min-width="@DashboardJobColumnWidths.MinimumOverride"
                                          data-max-width="@DashboardJobColumnWidths.MaximumOverride"
                                          @ondblclick="() => AutoFitColumnAsync(columnIndex)"
                                          @onkeydown="eventArgs => HandleColumnWidthKeyAsync(columnIndex, eventArgs)"></span>
                                </th>
                            }
                            <th class="jobs-table__filler" aria-hidden="true"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_jobs.Count == 0)
                        {
                            <tr>
                                <td class="jobs-empty-row" colspan="@(_columns.Count + 1)">@EmptyText</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in _jobs)
                            {
                                <tr @key="job.JobId">
                                    @foreach (var column in _columns)
                                    {
                                        @switch (column.Kind)
                                        {
                                            case ShedduellerDashboardJobColumnKind.JobId:
                                                <td><JobLink CssClass="jobs-id-link" JobId="job.JobId" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Enqueued:
                                                <td><TimestampBlock BaseClass="jobs-timestamp" Value="job.EnqueuedAtUtc" AllowFutureRelative="false" Inline /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.TerminalTime:
                                                <td><TimestampBlock BaseClass="jobs-timestamp" Value="DashboardFormat.TerminalTimestamp(job)" AllowFutureRelative="false" Inline /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.State:
                                                <td><StateBadge BaseClass="jobs-state" State="job.State" Href="@StateFilterHref(job.State)"
                                                                Title="@StateFilterTitle(job.State)" AriaLabel="@StateFilterTitle(job.State)" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Queue:
                                                <td><span class="@QueuePositionClass(job)" title="@QueuePositionTitle(job)">@QueuePositionText(job)</span></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Handler:
                                                <td><a class="jobs-handler jobs-filter-link" href="@HandlerFilterHref(job)"
                                                       title="@DashboardFormat.FullHandler(job)"
                                                       aria-label="@HandlerFilterTitle(job)">@DashboardFormat.ShortHandler(job)</a></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Tags:
                                                <td><TagChipList ClassPrefix="jobs-chip" Tags="@ResidualTags(job)" HrefFactory="TagFilterHref"
                                                                 LinkAriaLabelPrefix="Filter jobs by tag" MaxVisible="2" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Progress:
                                                <td><ProgressIndicator BaseClass="jobs-progress" Progress="job.LatestProgress" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Disposition:
                                                <td><span class="jobs-disposition @GetDispositionClass(job)"
                                                          title="@DashboardFormat.Disposition(job)">@DashboardFormat.Disposition(job)</span></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Groups:
                                                <td><ChipList ClassPrefix="jobs-chip" Values="job.ConcurrencyGroupKeys"
                                                              Title="@DashboardFormat.GroupKeysTitle(job.ConcurrencyGroupKeys)"
                                                              HrefFactory="GroupFilterHref" LinkAriaLabelPrefix="Filter jobs by group"
                                                              MaxVisible="2" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Priority:
                                                <td class="jobs-table__number">@job.Priority</td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Attempts:
                                                <td class="jobs-table__number">@DashboardFormat.Attempts(job, compact: true)</td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Tag:
                                                var values = TagValues(job, column);
                                                <td><ChipList ClassPrefix="jobs-derived-tag" Values="values"
                                                              Title="@TagValuesTitle(values)" MaxVisible="2"
                                                              HrefFactory="value => TagValueFilterHref(column, value)"
                                                              LinkAriaLabelPrefix="Filter jobs by tag value" /></td>
                                                break;
                                        }
                                    }
                                    <td class="jobs-table__filler" aria-hidden="true"></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <footer class="jobs-pagination">
                <span>@ResultRangeText</span>
                @if (_page.ContinuationToken is not null)
                {
                    <button class="jobs-load-more-button" type="button" @onclick="LoadMoreAsync" disabled="@(_isLoading || _isLoadingMore)">
                        @(_isLoadingMore ? "Loading Records" : "Load More Records")
                    </button>
                }
            </footer>
            @if (_loadMoreError is not null)
            {
                <DashboardInlineAlert CssClass="jobs-inline-alert jobs-inline-alert--error" Icon="warning">
                    <span>Load more failed: @_loadMoreError</span>
                </DashboardInlineAlert>
            }
        </div>
    }
</div>

<style>
    /* Fills the shell's content area so only the table scrolls. */
    .jobs-page {
        display: flex;
        flex: 1 1 auto;
        min-height: 0;
        flex-direction: column;
        gap: var(--sd-gutter);
    }

    .jobs-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .jobs-header p {
        margin-top: 4px;
        color: var(--sd-on-surface-variant);
        font-size: 12px;
        line-height: 16px;
    }

    .jobs-view-bar {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: var(--sd-radius);
        background: var(--sd-surface-lowest);
        padding: 8px;
    }

    .jobs-view-select {
        display: flex;
        min-width: 220px;
        align-items: center;
        gap: 8px;
    }

    .jobs-view-select .sd-table-select {
        min-width: 160px;
    }

    .jobs-view-status {
        flex: 1 1 auto;
        overflow: hidden;
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        line-height: 16px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .jobs-view-actions {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .jobs-view-actions button {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: var(--radius-md);
        background: var(--sd-surface-lowest);
        color: var(--sd-on-surface);
        padding: 6px 8px;
        font-size: 12px;
        font-weight: 500;
        line-height: 16px;
    }

    .jobs-view-actions button:hover:not(:disabled) {
        border-color: var(--sd-primary);
        color: var(--sd-primary);
    }

    .jobs-view-actions button:disabled {
        cursor: default;
        opacity: 0.5;
    }

    .jobs-view-actions .sd-icon {
        font-size: 16px;
    }

    .jobs-view-actions .jobs-view-delete {
        color: var(--sd-error);
    }

    .jobs-filter-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 12px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: var(--sd-radius);
        background: var(--sd-surface-lowest);
        padding: 8px;
    }

    .jobs-status-filter,
    .jobs-text-filters {
        display: flex;
        min-width: 0;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .jobs-text-filters {
        flex: 1 1 560px;
    }

    .jobs-filter-label {
        color: var(--sd-on-surface-variant);
        font-size: 12px;
        font-weight: 500;
        line-height: 16px;
    }

    .jobs-status-option {
        position: relative;
        display: inline-flex;
        cursor: pointer;
    }

    .jobs-status-option input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .jobs-status-option span {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        border: 1px solid var(--sd-outline-variant);
        border-radius: var(--radius-md);
        background: var(--sd-surface-container);
        color: var(--sd-on-surface-variant);
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 500;
        line-height: 16px;
        transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }

    .jobs-status-option input:checked+span {
        border-color: var(--sd-primary);
        background: var(--sd-secondary-container);
        color: var(--sd-on-secondary-container);
    }

    .jobs-status-option input:focus-visible+span {
        outline: 2px solid var(--sd-primary);
        outline-offset: 2px;
    }

    .jobs-filter-bar .sd-table-search {
        flex: 1 1 190px;
        width: auto;
        min-width: 180px;
    }

    .jobs-filter-bar .sd-table-select {
        flex: 0 0 166px;
        min-width: 150px;
    }

    button.jobs-clear-button,
    button.jobs-clear-queued-button,
    button.jobs-load-more-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        min-height: 32px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 6px;
        background: var(--sd-surface-lowest);
        color: var(--sd-on-surface);
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 500;
        line-height: 16px;
    }

    button.jobs-clear-queued-button {
        border-color: var(--sd-error);
        background: var(--sd-error-container);
        color: var(--sd-on-error-container);
    }

    button.jobs-clear-queued-button .sd-icon {
        font-size: 17px;
    }

    button.jobs-load-more-button {
        min-width: 160px;
    }

    button.jobs-clear-button:hover,
    button.jobs-clear-queued-button:hover,
    button.jobs-load-more-button:hover {
        color: var(--sd-primary);
    }

    button.jobs-clear-queued-button:hover:not(:disabled) {
        border-color: var(--sd-error);
        color: var(--sd-error);
    }

    .jobs-page button:disabled,
    .jobs-page input:disabled {
        cursor: progress;
        opacity: 0.65;
    }

    .jobs-message,
    .jobs-inline-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: calc(var(--radius) + 2px);
        box-shadow: var(--shadow-sm);
        background: var(--sd-surface-lowest);
        padding: 16px;
    }

    .jobs-message .sd-icon,
    .jobs-inline-alert .sd-icon {
        color: var(--sd-primary);
    }

    .jobs-message--error,
    .jobs-inline-alert--error {
        border-color: var(--sd-error);
        background: var(--sd-error-container);
        color: var(--sd-on-error-container);
    }

    .jobs-message--error .sd-icon,
    .jobs-inline-alert--error .sd-icon {
        color: var(--sd-error);
    }

    .jobs-inline-alert--success {
        border-color: var(--sd-success);
        background: var(--sd-success-container);
        color: var(--sd-success);
    }

    .jobs-inline-alert--success .sd-icon {
        color: var(--sd-success);
    }

    .jobs-inline-alert--warning {
        border-color: var(--sd-warning);
        background: var(--sd-warning-container);
        color: var(--sd-warning);
    }

    .jobs-inline-alert--warning .sd-icon {
        color: var(--sd-warning);
    }

    .jobs-message p,
    .jobs-inline-alert {
        color: var(--sd-on-surface-variant);
    }

    .jobs-inline-alert--error {
        color: var(--sd-on-error-container);
    }

    .jobs-inline-alert--success {
        color: var(--sd-success);
    }

    .jobs-inline-alert--warning {
        color: var(--sd-warning);
    }

    .jobs-table-shell {
        display: flex;
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--sd-outline-variant);
        border-radius: calc(var(--radius) + 2px);
        box-shadow: var(--shadow-sm);
        background: var(--sd-surface-lowest);
    }

    .jobs-table-wrap {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }

    .jobs-table {
        width: 100%;
        min-width: 0;
        border-collapse: collapse;
        table-layout: fixed;
        white-space: nowrap;
    }

    .jobs-table thead {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--sd-surface-low);
    }

    .jobs-table th,
    .jobs-table td {
        border-bottom: 1px solid var(--sd-outline-variant);
        padding: 6px 8px;
        text-align: left;
        vertical-align: middle;
    }

    /* Empty trailing column that absorbs spare width so the table spans the card. */
    .jobs-table .jobs-table__filler {
        padding: 0;
    }

    .jobs-table th {
        position: relative;
        color: var(--sd-on-surface-variant);
        font-size: 12px;
        font-weight: 500;
        line-height: 16px;
    }

    .jobs-table__resize-handle {
        position: absolute;
        inset: 0 -4px 0 auto;
        z-index: 3;
        display: block;
        width: 9px;
        cursor: col-resize;
        outline: none;
        touch-action: none;
    }

    .jobs-table__resize-handle::after {
        position: absolute;
        top: 20%;
        right: 4px;
        width: 1px;
        height: 60%;
        background: transparent;
        content: "";
    }

    .jobs-table__resize-handle:hover::after,
    .jobs-table__resize-handle:focus-visible::after,
    .jobs-table--resizing .jobs-table__resize-handle::after {
        width: 2px;
        background: var(--sd-primary);
    }

    .jobs-table--resizing {
        user-select: none;
    }

    .jobs-table td {
        height: 40px;
        color: var(--sd-on-surface);
        font-size: 12px;
        line-height: 16px;
    }

    .jobs-table tbody tr:hover {
        background: var(--sd-surface-low);
    }

    .jobs-table__number {
        text-align: right;
    }

    .jobs-id-link,
    .jobs-handler,
    .jobs-disposition,
    .jobs-chip,
    .jobs-progress-text,
    .jobs-timestamp__absolute {
        font-family: var(--font-mono);
    }

    .jobs-id-link {
        display: block;
        overflow: hidden;
        color: var(--sd-primary);
        font-size: 13px;
        line-height: 18px;
        text-overflow: ellipsis;
        text-decoration-color: var(--sd-outline-variant);
        text-underline-offset: 2px;
        white-space: nowrap;
    }

    .jobs-id-link:hover {
        text-decoration-color: var(--sd-primary);
    }

    .jobs-handler {
        display: block;
        width: 100%;
        overflow: hidden;
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        text-decoration: none;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    a.jobs-handler:hover {
        color: var(--sd-primary);
        text-decoration: underline;
        text-decoration-color: var(--sd-primary);
        text-underline-offset: 2px;
    }

    .jobs-chip-list {
        display: flex;
        width: 100%;
        min-width: 0;
        align-items: center;
        gap: 4px;
        overflow: visible;
    }

    .jobs-table .sd-chip-list {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        align-content: center;
        flex-wrap: wrap;
    }

    .jobs-table .sd-chip-list>.sd-chip {
        display: -webkit-box;
        min-width: 0;
        max-width: 100%;
        flex: 0 1 auto;
        overflow: hidden;
        overflow-wrap: anywhere;
        text-overflow: clip;
        white-space: normal;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .jobs-table .sd-chip-overflow {
        min-width: 0;
        max-width: 100%;
    }

    .jobs-chip {
        display: inline-block;
        max-width: 180px;
        overflow: hidden;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 6px;
        background: var(--sd-surface-low);
        color: var(--sd-on-surface-variant);
        font-size: 10px;
        line-height: 14px;
