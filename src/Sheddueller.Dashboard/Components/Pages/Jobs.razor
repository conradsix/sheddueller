@page "/jobs"
@inherits DashboardPageComponent
@inject IJobInspectionReader Reader
@inject IJobManager JobManager
@inject DashboardLiveUpdateStream LiveUpdates
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject Microsoft.Extensions.Options.IOptions<ShedduellerDashboardOptions> DashboardOptions

<div class="sd-page sd-page--fill jobs-page">
    <PageHeader Title="Jobs" Description="@HeaderDescription">
        <TitleAddon>
            <DropdownMenu Label="Job views" Variant="ButtonVariant.Ghost" AlignStart="true" Class="jobs-view-trigger">
                <TriggerContent>
                    <span class="sd-muted">View:</span>
                    <strong>@(_viewSession.CurrentView?.Name ?? "Custom")</strong>
                    @if (_viewSession.IsDirty)
                    {
                        <Badge Variant="BadgeVariant.Secondary">Edited</Badge>
                    }
                </TriggerContent>
                <ChildContent>
                    @foreach (var group in _viewSession.ViewGroups)
                    {
                        <MenuLabel>@group.Label</MenuLabel>
                        @foreach (var view in group.Views)
                        {
                            var selected = view.Key == _viewSession.SelectedKey;
                            <button type="button" role="menuitemradio" class="sd-menu__item" aria-checked="@(selected ? "true" : "false")"
                                    @key="view.Key" @onclick="() => SelectViewAsync(view)">
                                <span class="jobs-view-option__check" aria-hidden="true">
                                    @if (selected)
                                    {
                                        <Icon Name="check" />
                                    }
                                </span>
                                <span>@view.Name</span>
                                @if (view.Key == _viewSession.PreferredKey)
                                {
                                    <span class="sd-menu__hint">default</span>
                                }
                            </button>
                        }
                    }
                    <MenuSeparator />
                    @if (_viewSession.IsPersonalView)
                    {
                        <MenuItem Icon="save" Disabled="@(!_viewSession.CanSaveCurrentView)" OnClick="SaveCurrentViewAsync">Save changes</MenuItem>
                    }
                    <MenuItem Icon="save-all" OnClick="OpenSaveAsDialog">Save as new view…</MenuItem>
                    @if (_viewSession.IsPersonalView)
                    {
                        <MenuItem Icon="pencil" OnClick="OpenRenameDialog">Rename…</MenuItem>
                    }
                    <MenuItem Icon="house" Disabled="@(!_viewSession.CanSetPreferredView)" OnClick="SetPreferredViewAsync">Open this view by default</MenuItem>
                    @if (_viewSession.IsPersonalView)
                    {
                        <MenuSeparator />
                        <MenuItem Icon="trash-2" Destructive="true" OnClick="OpenDeleteDialog">Delete view…</MenuItem>
                    }
                </ChildContent>
            </DropdownMenu>
        </TitleAddon>
        <Actions>
            <Button Icon="columns-3" OnClick="OpenColumnEditor">Columns</Button>
            <Button Variant="ButtonVariant.DestructiveOutline" Icon="ban" Disabled="_isClearQueuedRunning"
                    OnClick="OpenClearQueuedDialog">Cancel queued…</Button>
        </Actions>
    </PageHeader>

    <div class="sd-toolbar jobs-toolbar">
        <SearchInput Class="jobs-search" Value="@_filters.HandlerContains" ValueChanged="SetHandlerContainsAsync"
                     Placeholder="Filter by handler, or paste a job ID" Label="Filter jobs by handler, or open a job by ID"
                     Shortcut="true" @onkeydown="HandleSearchKeyDown" />
        @if (SearchJobId is { } searchJobId)
        {
            <Button Variant="ButtonVariant.Link" Href="@DashboardFormat.JobHref(searchJobId)" IconEnd="chevron-right">
                Open job @DashboardFormat.JobId(searchJobId)
            </Button>
        }
        <FacetedFilter TValue="JobState" Title="Status" Options="StatusOptions" Selected="_filters.SelectedStates"
                       OnToggle="ToggleStateAsync" OnClear="ClearStatesAsync" />
        <TextFilterMenu Fields="TextFilterFields" OnApply="ApplyTextFilterAsync" />
        @if (!string.IsNullOrWhiteSpace(_filters.TagContains))
        {
            <FilterChip Label="Tag" Value="@_filters.TagContains" OnRemove="@(() => ApplyTextFilterAsync((TagFilterKey, string.Empty)))" />
        }
        @if (!string.IsNullOrWhiteSpace(_filters.ConcurrencyGroupContains))
        {
            <FilterChip Label="Group" Value="@_filters.ConcurrencyGroupContains"
                        OnRemove="@(() => ApplyTextFilterAsync((GroupFilterKey, string.Empty)))" />
        }
        @if (_filters.HasAppliedFilters)
        {
            <Button Variant="ButtonVariant.Ghost" Icon="x" OnClick="ClearAllAsync">Reset</Button>
        }
        <span class="sd-toolbar__spacer"></span>
        <DropdownMenu Label="Sort jobs" Variant="ButtonVariant.Ghost" ShowChevron="false">
            <TriggerContent>
                <Icon Name="arrow-up-down" />
                <span>@SortLabel(_filters.Sort)</span>
            </TriggerContent>
            <ChildContent>
                <MenuLabel>Sort by</MenuLabel>
                @foreach (var sort in SortOptions)
                {
                    var selected = sort == _filters.Sort;
                    <button type="button" role="menuitemradio" class="sd-menu__item" aria-checked="@(selected ? "true" : "false")"
                            @onclick="() => SetSortAsync(sort)">
                        <span class="jobs-view-option__check" aria-hidden="true">
                            @if (selected)
                            {
                                <Icon Name="check" />
                            }
                        </span>
                        <span>@SortLabel(sort)</span>
                    </button>
                }
            </ChildContent>
        </DropdownMenu>
    </div>

    @if (_jobs.LoadError is not null)
    {
        <Alert Tone="AlertTone.Destructive" Title="Jobs couldn't be loaded">
            <ChildContent>@_jobs.LoadError</ChildContent>
            <Actions>
                <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="RetryAsync">Try again</Button>
            </Actions>
        </Alert>
    }

    @if (_jobs.HasPage || _jobs.LoadError is null)
    {
        <Card Flush="true" Class="@DashboardTableFormat.CardClass("jobs-table-card", _jobs.IsReloading)">
            @if (_pendingNewJobCount > 0)
            {
                <button type="button" class="sd-new-rows" @onclick="ShowPendingJobsAsync">
                    <Icon Name="arrow-up" />
                    @PendingJobsButtonText
                </button>
            }
            <div class="jobs-table-wrap">
                <table class="sd-table jobs-table" style="@TableStyle" data-sd-keyboard="true" aria-busy="@(_jobs.IsLoading ? "true" : "false")">
                    <colgroup>
                        <col class="jobs-table__select-col" />
                        @for (var index = 0; index < _columns.Count; index++)
                        {
                            var column = _columns[index];
                            <col style="@ColumnWidthStyle(column)" data-sd-col="@index" @key="ColumnKey(column)" />
                        }
                        <col class="jobs-table__filler" />
                        <col class="jobs-table__actions-col" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="jobs-table__select">
                                <label class="jobs-table__select-label">
                                    <input type="checkbox" class="sd-checkbox" checked="@AllLoadedSelected" disabled="@(_jobs.Rows.Count == 0)"
                                           aria-label="Select all loaded jobs" @onchange="ToggleAllSelected" />
                                </label>
                            </th>
                            @for (var index = 0; index < _columns.Count; index++)
                            {
                                var columnIndex = index;
                                var column = _columns[columnIndex];
                                <th class="@ColumnHeaderClass(column)" data-sd-col="@columnIndex" @key="ColumnKey(column)">
                                    <span>@DashboardJobViews.Heading(column)</span>
                                    <span class="jobs-table__resize-handle" role="separator" tabindex="0"
                                          title="Drag to resize. Double-click to fit loaded values."
                                          aria-label="Resize @DashboardJobViews.Heading(column) column"
                                          aria-orientation="vertical" aria-valuemin="@DashboardJobColumnWidths.MinimumOverride"
                                          aria-valuemax="@DashboardJobColumnWidths.MaximumOverride" aria-valuenow="@ColumnWidth(column)"
                                          data-sd-column-resizer data-column-index="@columnIndex"
                                          data-min-width="@DashboardJobColumnWidths.MinimumOverride"
                                          data-max-width="@DashboardJobColumnWidths.MaximumOverride"
                                          @ondblclick="() => AutoFitColumnAsync(columnIndex)"
                                          @onkeydown="eventArgs => HandleColumnWidthKeyAsync(columnIndex, eventArgs)"></span>
                                </th>
                            }
                            <th class="jobs-table__filler" aria-hidden="true"></th>
                            <th class="jobs-table__actions"><span class="sd-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_jobs.HasPage)
                        {
                            @for (var row = 0; row < SkeletonRowCount; row++)
                            {
                                <tr class="jobs-table__skeleton" aria-hidden="true">
                                    <td class="jobs-table__select"></td>
                                    @for (var index = 0; index < _columns.Count; index++)
                                    {
                                        <td><Skeleton Width="@DashboardTableFormat.SkeletonWidth(row, index)" /></td>
                                    }
                                    <td class="jobs-table__filler"></td>
                                    <td class="jobs-table__actions"></td>
                                </tr>
                            }
                        }
                        else if (_jobs.Rows.Count == 0)
                        {
                            <tr class="sd-table__empty">
                                <td colspan="@(_columns.Count + 3)">
                                    <EmptyState Flat="true" Icon="search" Title="@EmptyTitle">
                                        <ChildContent>@EmptyText</ChildContent>
                                        <Actions>
                                            @if (SearchJobId is { } emptyJobId)
                                            {
                                                <Button Variant="ButtonVariant.Primary" Href="@DashboardFormat.JobHref(emptyJobId)">Open job @DashboardFormat.JobId(emptyJobId)</Button>
                                            }
                                            @if (_filters.HasAppliedFilters)
                                            {
                                                <Button OnClick="ClearAllAsync">Reset filters</Button>
                                            }
                                        </Actions>
                                    </EmptyState>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in _jobs.Rows)
                            {
                                var selected = _selected.Contains(job.JobId);
                                <tr @key="job.JobId" data-href="@DashboardFormat.JobHref(job.JobId)" aria-selected="@(selected ? "true" : "false")">
                                    <td class="jobs-table__select">
                                        <label class="jobs-table__select-label">
                                            <input type="checkbox" class="sd-checkbox" checked="@selected"
                                                   aria-label="@($"Select job {DashboardFormat.JobId(job.JobId)}")"
                                                   @onchange="eventArgs => SetSelected(job.JobId, eventArgs)" />
                                        </label>
                                    </td>
                                    @foreach (var column in _columns)
                                    {
                                        @switch (column.Kind)
                                        {
                                            case ShedduellerDashboardJobColumnKind.JobId:
                                                <td><JobLink CssClass="jobs-id-link" JobId="job.JobId" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Enqueued:
                                                <td><TimestampBlock BaseClass="sd-timestamp" Value="job.EnqueuedAtUtc" AllowFutureRelative="false" Inline /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.TerminalTime:
                                                <td><TimestampBlock BaseClass="sd-timestamp" Value="DashboardFormat.TerminalTimestamp(job)" AllowFutureRelative="false" Inline /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.State:
                                                <td><StatusBadge State="job.State" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Queue:
                                                <td><span class="@DashboardFormat.QueuePositionClass(job)" title="@DashboardFormat.QueuePositionTitle(job)">@DashboardFormat.QueuePositionText(job)</span></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Handler:
                                                <td><span class="jobs-handler" title="@DashboardFormat.FullHandler(job)">@DashboardFormat.ShortHandler(job)</span></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Tags:
                                                <td><TagList Values="@ResidualTagValues(job)" Title="@ResidualTagsTitle(job)" HrefFactory="TagFilterHref" TooltipPrefix="Show only tag" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Progress:
                                                <td>
                                                    @if (job.LatestProgress?.Percent is { } percent)
                                                    {
                                                        <span class="jobs-progress" title="@job.LatestProgress.Message">
                                                            <Progress Value="percent" Label="@($"Progress {percent:0}%")" />
                                                            <span class="sd-num">@DashboardFormat.ProgressText(job.LatestProgress, string.Empty)</span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="sd-muted" title="@job.LatestProgress?.Message">@(job.LatestProgress?.Message ?? "—")</span>
                                                    }
                                                </td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Disposition:
                                                <td><span class="jobs-disposition @DashboardFormat.DispositionClass(job)"
                                                          title="@DashboardFormat.Disposition(job)">@DashboardFormat.Disposition(job)</span></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Groups:
                                                <td><TagList Values="job.ConcurrencyGroupKeys" Title="@DashboardFormat.GroupKeysTitle(job.ConcurrencyGroupKeys)"
                                                             HrefFactory="GroupFilterHref" TooltipPrefix="Show only group" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Priority:
                                                <td class="sd-table__num">@job.Priority</td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Attempts:
                                                <td class="sd-table__num">@DashboardFormat.Attempts(job, compact: true)</td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Tag:
                                                var values = TagValues(job, column);
                                                <td><TagList Values="values" Title="@TagValuesTitle(values)" HrefFactory="value => TagValueFilterHref(column, value)"
                                                             TooltipPrefix="@($"Show only {DashboardJobViews.Heading(column)}")" /></td>
                                                break;
                                        }
                                    }
                                    <td class="jobs-table__filler" aria-hidden="true"></td>
                                    <td class="jobs-table__actions">
                                        <DropdownMenu Label="@($"Actions for job {DashboardFormat.JobId(job.JobId)}")" Icon="ellipsis" Size="ButtonSize.Small">
                                            <MenuItem Icon="chevron-right" Href="@DashboardFormat.JobHref(job.JobId)">Open job</MenuItem>
                                            <MenuItem Icon="copy" data-sd-copy="@job.JobId.ToString("D")" data-sd-copy-label="job ID">Copy job ID</MenuItem>
                                            <MenuSeparator />
                                            <MenuItem Icon="list-filter" Href="@HandlerFilterHref(job)">Only @DashboardFormat.ShortHandler(job)</MenuItem>
                                            @if (job.ConcurrencyGroupKeys.Count > 0)
                                            {
                                                <MenuItem Icon="layers" Href="@GroupFilterHref(job.ConcurrencyGroupKeys[0])">Only group @job.ConcurrencyGroupKeys[0]</MenuItem>
                                            }
                                            @if (DashboardJobActions.IsCancellable(job))
                                            {
                                                <MenuSeparator />
                                                <MenuItem Icon="ban" Destructive="true" OnClick="() => OpenCancelDialog([job.JobId])">Cancel job…</MenuItem>
                                            }
                                        </DropdownMenu>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <LoadMoreFooter Text="@FooterText" Error="@_jobs.LoadMoreError" CanLoadMore="_jobs.CanLoadMore"
                            IsLoading="_jobs.IsLoading" IsLoadingMore="_jobs.IsLoadingMore" OnLoadMore="LoadMoreAsync" />
        </Card>
    }
</div>

<BulkActionBar Count="_selected.Count" OnClear="ClearSelection">
    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Icon="copy" data-sd-copy="@SelectedJobIdsText"
            data-sd-copy-label="@($"{_selected.Count} job IDs")">Copy IDs</Button>
    <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Icon="ban" Disabled="@(CancellableSelectedIds.Count == 0)"
            OnClick="() => OpenCancelDialog(CancellableSelectedIds)">@BulkCancelLabel</Button>
</BulkActionBar>

<JobColumnConfigurator IsOpen="_isColumnEditorOpen" Columns="_columns"
                       HiddenBuiltInColumns="HiddenBuiltInColumns" ObservedTagNames="ObservedTagNames"
                       IsPersonalView="_viewSession.IsPersonalView" IsDirty="_viewSession.IsDirty"
                       CloseRequested="CloseColumnEditor" SaveRequested="SaveCurrentViewAsync"
                       SaveAsRequested="OpenSaveAsDialog" ResetRequested="ResetColumns"
                       AutoFitRequested="AutoFitAllColumnsAsync" ResetWidthsRequested="ResetColumnWidths"
                       ColumnMoved="MoveColumn" VisibilityChanged="SetBuiltInColumnVisible"
                       TagColumnEdited="EditTagColumn" TagColumnRemoved="RemoveColumn"
                       TagColumnAdded="AddTagColumn" ColumnWidthResetRequested="ResetColumnWidth" />

<ConfirmDialog @bind-Open="_clearQueuedDialogOpen" Title="Cancel all queued jobs?" ConfirmLabel="Cancel queued jobs"
               CancelLabel="Keep them" Destructive="true" RequireText="@ClearQueuedConfirmationText" Busy="_isClearQueuedRunning"
               OnConfirm="ClearQueuedJobsAsync">
    <p>Every queued job ends as canceled, including delayed jobs and jobs waiting to retry. Running jobs keep running, and job history is kept. You can't undo this.</p>
</ConfirmDialog>

<ConfirmDialog @bind-Open="_cancelDialogOpen" Title="@CancelDialogTitle" ConfirmLabel="@CancelDialogConfirmLabel" CancelLabel="Keep running"
               Destructive="true" Busy="_isCancelling" OnConfirm="CancelJobsAsync">
    <p>@CancelDialogDescription</p>
</ConfirmDialog>

<ConfirmDialog @bind-Open="_discardDialogOpen" Title="@($"Discard changes to “{_viewSession.CurrentView?.Name}”?")" ConfirmLabel="Discard changes"
               CancelLabel="Keep editing" Destructive="true" OnConfirm="ConfirmSwitchViewAsync">
    <p>Your filter and column changes to this view haven't been saved.</p>
</ConfirmDialog>

<InputDialog @bind-Open="_saveAsDialogOpen" Title="Save as new view" Label="Name" InitialValue="@_viewSession.SuggestedViewName"
             ConfirmLabel="Save view" Validate="name => _viewSession.ValidateViewName(name, exceptKey: null)" OnConfirm="SaveViewAsAsync">
    <p>Saves the current filters, sort, and columns as a view in this browser.</p>
</InputDialog>

<InputDialog @bind-Open="_renameDialogOpen" Title="Rename view" Label="Name" InitialValue="@(_viewSession.CurrentView?.Name ?? string.Empty)"
             ConfirmLabel="Rename" Validate="name => _viewSession.ValidateViewName(name, _viewSession.SelectedKey)" OnConfirm="RenameCurrentViewAsync" />

<ConfirmDialog @bind-Open="_deleteDialogOpen" Title="@($"Delete “{_viewSession.CurrentView?.Name}”?")" ConfirmLabel="Delete view"
               Destructive="true" OnConfirm="DeleteCurrentViewAsync">
    <p>The view is removed from this browser. Jobs aren't affected.</p>
</ConfirmDialog>

@code {
    private static readonly TimeSpan FilterDebounce = TimeSpan.FromMilliseconds(300);
    private const int DefaultPageSize = 25;
    private const string ClearQueuedConfirmationText = "cancel queued";
    private const string TagFilterKey = "tag";
    private const string GroupFilterKey = "group";
    private const int SkeletonRowCount = 8;

    private static readonly IReadOnlyList<FacetOption<JobState>> StatusOptions =
    [
        .. Enum.GetValues<JobState>().Select(state => new FacetOption<JobState>(
          state,
          StatusBadge.StateLabel(state),
          string.Concat("sd-state-dot sd-state-dot--", DashboardFormat.StateCssModifier(state)))),
    ];

    private static readonly JobInspectionSort[] SortOptions = [JobInspectionSort.Operational, JobInspectionSort.NewestFirst];

    private readonly DashboardJobFilters _filters = new();
    private readonly DashboardPagedList<JobInspectionSummary> _jobs = new();
    private readonly DashboardDebouncer _filterDebouncer = new(FilterDebounce);
    private readonly HashSet<Guid> _selected = [];
    private DashboardJobViewSession _viewSession = null!;
    private JobInspectionQuery _lastQuery = new(PageSize: DefaultPageSize);
    private DashboardJobListLocation? _initialLocation;
    private IReadOnlyList<Guid> _cancelTargets = [];
    private DashboardResolvedJobView? _pendingView;
    private int _take = DefaultPageSize;
    private int _pendingNewJobCount;
    private bool _isClearQueuedRunning;
    private bool _isCancelling;
    private bool _clearQueuedDialogOpen;
    private bool _cancelDialogOpen;
    private bool _discardDialogOpen;
    private bool _saveAsDialogOpen;
    private bool _renameDialogOpen;
    private bool _deleteDialogOpen;
    private bool _initialLoadDeferred;
    private bool _viewStorageLoaded;

    [Inject]
    private DashboardNavigationState NavigationState { get; set; } = null!;

    private string? ViewParameter
      => this._viewSession.ViewParameter;

    private string PendingJobsButtonText
      => string.Create(
        CultureInfo.InvariantCulture,
        $"{DashboardFormat.Count(this._pendingNewJobCount)} new {(this._pendingNewJobCount == 1 ? "job" : "jobs")}");

    private IReadOnlyList<TextFilterField> TextFilterFields
      =>
      [
          new(TagFilterKey, "Tag contains", "tenant:acme", this._filters.TagContains),
          new(GroupFilterKey, "Concurrency group contains", "billing", this._filters.ConcurrencyGroupContains),
      ];

    private Guid? SearchJobId
      => DashboardJobActions.TryParseJobId(this._filters.HandlerContains, out var jobId) ? jobId : null;

    private bool AllLoadedSelected
      => this._jobs.Rows.Count > 0 && this._jobs.Rows.All(job => this._selected.Contains(job.JobId));

    private IReadOnlyList<Guid> CancellableSelectedIds
      => [.. this._jobs.Rows.Where(job => this._selected.Contains(job.JobId) && DashboardJobActions.IsCancellable(job)).Select(job => job.JobId)];

    private string SelectedJobIdsText
      => string.Join('\n', this._jobs.Rows.Where(job => this._selected.Contains(job.JobId)).Select(job => job.JobId.ToString("D")));

    private string BulkCancelLabel
      => CancellableSelectedIds.Count switch
      {
          0 => "Nothing to cancel",
          1 => "Cancel 1 job…",
          var count => string.Create(CultureInfo.InvariantCulture, $"Cancel {DashboardFormat.Count(count)} jobs…"),
      };

    private string CancelDialogTitle
      => this._cancelTargets.Count == 1
        ? "Cancel this job?"
        : string.Create(CultureInfo.InvariantCulture, $"Cancel {DashboardFormat.Count(this._cancelTargets.Count)} jobs?");

    private string CancelDialogConfirmLabel
      => this._cancelTargets.Count == 1 ? "Cancel job" : "Cancel jobs";

    private string CancelDialogDescription
      => this._cancelTargets.Count == 1
        ? "A queued job ends as canceled straight away. A running job stops at its next cancellation check. You can't undo this."
        : "Queued jobs end as canceled straight away; running jobs stop at their next cancellation check. You can't undo this.";

    private string HeaderDescription
    {
        get
        {
            if (this._jobs.TotalCount is not { } total)
            {
                return this._jobs.LoadError is null ? "Loading jobs…" : "Jobs couldn't be loaded.";
            }

            var jobs = string.Create(CultureInfo.InvariantCulture, $"{DashboardFormat.Count(total)} {(total == 1 ? "job" : "jobs")}");
            return this._filters.HasAppliedFilters
              ? string.Concat(jobs, total == 1 ? " matches the filters" : " match the filters")
              : jobs;
        }
    }

    private string FooterText
      => string.Create(
        CultureInfo.InvariantCulture,
        $"Showing {DashboardFormat.Count(this._jobs.Rows.Count)} of {DashboardFormat.Count(this._jobs.TotalCount ?? this._jobs.Rows.Count)}");

    private string EmptyTitle
      => this.SearchJobId is not null
        ? "No handler matches that ID"
        : this._filters.HasAppliedFilters ? "No jobs match" : "No jobs yet";

    private string EmptyText
      => this.SearchJobId is not null
        ? "That looks like a job ID. Open the job directly, or clear the search."
        : this._filters.HasAppliedFilters
          ? "Nothing matches the current status and filters. Try removing a filter."
          : "Jobs appear here as soon as they're enqueued.";

    protected override async Task OnInitializedAsync()
    {
        this._viewSession = new DashboardJobViewSession(DashboardOptions.Value);
        this.ReplaceColumns(DashboardJobViews.GetColumns(this._viewSession.ConfiguredDefaultView.Definition));

        // The URL carries filters, the selected view (when it is not the preferred view), and the loaded depth.
        var location = DashboardJobListLocation.Parse(Navigation.Uri);
        this._initialLocation = location;
        this._take = location.Take;
        if (location.ViewKey is { } viewKey && this._viewSession.FindView(viewKey) is { } requestedView)
        {
            this.SelectView(requestedView);
        }

        _ = this._filters.ReplaceWith(location.Filters ?? this._viewSession.CurrentViewFilters());
        this.UpdateViewDirty();
        this.NavigationState.JobsListHref = Navigation.ToBaseRelativePath(Navigation.Uri);
        this.TrackLocation(Navigation, DashboardJobFilterQuery.JobsPath, this.ApplyLocationAsync);
        this.InitializeLiveRefresh(
          this.RefreshCurrentQueryAsync,
          showRefreshing: true,
          lastUpdatedUtc: nowUtc => this.LiveRefresh.LastUpdatedUtc ?? (this._jobs.HasPage ? nowUtc : null),
          queuedRefreshAsync: this.RefreshLiveAsync);
        this.RefreshOnJobEvents(LiveUpdates);

        // When the view depends on browser storage (the preferred view, or a personal view named in the URL), an
        // interactive render waits for storage after the first render and loads once with the resolved view,
        // instead of loading the configured default and then reloading with the preferred view.
        if (this.RendererInfo.IsInteractive && (location.ViewKey is null || this._viewSession.FindView(location.ViewKey) is null))
        {
            this._initialLoadDeferred = true;
            return;
        }

        await this.LoadAsync(this._take);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await this.RegisterColumnResizingAsync();

        if (firstRender && !this._viewStorageLoaded)
        {
            this._viewStorageLoaded = true;
            await this.LoadStoredViewsAsync();
            await this.ResolveInitialViewAsync();
        }

        await this.FlushToastsAsync();
    }

    private void ShowToastWarning(string message)
      => this.ShowToast(message, tone: AlertTone.Warning);

    private protected override async ValueTask DisposePageAsync()
    {
        this._filterDebouncer.Dispose();
        await this.UnregisterColumnResizingAsync();
    }

    private async Task LoadStoredViewsAsync()
    {
        try
        {
            var payload = await JsRuntime.InvokeAsync<DashboardJobViewStoragePayload?>(
              "sheddueller.jobViews.load",
              DashboardJobViewSession.StorageKey(Navigation.BaseUri));
            var loaded = this._viewSession.Load(payload);
            if (loaded == DashboardJobViewStorageLoad.UnsupportedVersion)
            {
                this.ShowToastWarning("Saved job views use an unsupported format and were ignored.");
            }
            else if (loaded == DashboardJobViewStorageLoad.SomeViewsInvalid)
            {
                this.ShowToastWarning("One or more invalid saved job views were ignored.");
            }
        }
        catch (JSException)
        {
            this.ShowToastWarning("Personal job views are unavailable because browser storage could not be read.");
        }
        catch (InvalidOperationException)
        {
            this.ShowToastWarning("Personal job views are unavailable in this rendering mode.");
        }
    }

    // Applies the view the initial URL asked for (or the preferred view when it named none) once browser storage
    // is known, then runs the initial load if it was deferred. Skipped if the user already changed the list.
    private async Task ResolveInitialViewAsync()
    {
        if (this._initialLocation is { } location)
        {
            this._initialLocation = null;
            var view = location.ViewKey is { } viewKey ? this._viewSession.FindView(viewKey) : null;
            if (location.ViewKey is not null && view is null)
            {
                this.ShowToastWarning("The job view in this link is not available, so the default view is shown.");
            }

            view ??= this._viewSession.PreferredOrDefaultView;
            if (!string.Equals(view.Key, this._viewSession.SelectedKey, StringComparison.Ordinal))
            {
                this.SelectView(view);
            }

            var filtersChanged = location.Filters is null && this._filters.ReplaceWith(this._viewSession.CurrentViewFilters());
            this.UpdateViewDirty();
            if (filtersChanged && !this._initialLoadDeferred)
            {
                await this.LoadAsync(this._take);
            }
        }

        if (this._initialLoadDeferred)
        {
            await this.LoadAsync(this._take);
        }

        this.StateHasChanged();
    }

    private async Task SelectViewAsync(DashboardResolvedJobView view)
    {
        if (view.Key == this._viewSession.SelectedKey)
        {
            return;
        }

        if (this._viewSession.IsDirty)
        {
            this._pendingView = view;
            this._discardDialogOpen = true;
            return;
        }

        await this.ActivateViewAsync(view, applyQuery: true);
    }

    private async Task ConfirmSwitchViewAsync()
    {
        if (this._pendingView is { } view)
        {
            this._pendingView = null;
            await this.ActivateViewAsync(view, applyQuery: true);
        }
    }

    private async Task ActivateViewAsync(
        DashboardResolvedJobView view,
        bool applyQuery)
    {
        this._initialLocation = null;
        this._filterDebouncer.Cancel();
        this.SelectView(view);

        if (applyQuery)
        {
            _ = this._filters.ReplaceWith(DashboardJobViews.CreateFilters(view.Definition));
            this._take = DefaultPageSize;
            this.UpdateViewDirty();
            this.NavigateToCurrentState(replace: false);
            await this.LoadAsync(this._take);
            return;
        }

        this.UpdateViewDirty();
    }

    private void SelectView(DashboardResolvedJobView view)
    {
        this._viewSession.Select(view);
        this.ReplaceColumns(DashboardJobViews.GetColumns(view.Definition));
    }

    private async Task SaveCurrentViewAsync()
    {
        if (this._viewSession.SaveCurrent(this._filters, this._columns) is not { } view)
        {
            return;
        }

        this.UpdateViewDirty();
        await this.PersistStoredViewsAsync(string.Concat("Saved changes to “", view.Name, "”"));
        this.NavigateToCurrentState(replace: true);
    }

    private void OpenSaveAsDialog()
      => this._saveAsDialogOpen = true;

    private void OpenRenameDialog()
      => this._renameDialogOpen = true;

    private void OpenDeleteDialog()
      => this._deleteDialogOpen = true;

    private async Task SaveViewAsAsync(string normalizedName)
    {
        _ = this._viewSession.SaveAs(normalizedName, this._filters, this._columns);
        this.UpdateViewDirty();
        await this.PersistStoredViewsAsync(string.Concat("Saved view “", normalizedName, "”"));
        this.NavigateToCurrentState(replace: true);
    }

    private async Task RenameCurrentViewAsync(string normalizedName)
    {
        if (this._viewSession.RenameCurrent(normalizedName) is null)
        {
            return;
        }

        await this.PersistStoredViewsAsync(string.Concat("Renamed view to “", normalizedName, "”"));
    }

    private async Task DeleteCurrentViewAsync()
    {
        if (this._viewSession.DeleteCurrent() is not { } deletedView)
        {
            return;
        }

        await this.ActivateViewAsync(this._viewSession.PreferredOrDefaultView, applyQuery: true);
        await this.PersistStoredViewsAsync(string.Concat("Deleted view “", deletedView.Name, "”"));
    }

    private async Task SetPreferredViewAsync()
    {
        if (this._viewSession.SetCurrentAsPreferred() is not { } view)
        {
            return;
        }

        await this.PersistStoredViewsAsync(string.Concat("“", view.Name, "” now opens by default"));
        this.NavigateToCurrentState(replace: true);
    }

    private async Task PersistStoredViewsAsync(string successMessage)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync(
              "sheddueller.jobViews.save",
              DashboardJobViewSession.StorageKey(Navigation.BaseUri),
              this._viewSession.ToPayload());
            this.ShowToast(successMessage, tone: AlertTone.Success);
        }
        catch (JSException)
        {
            this.ShowToast("Couldn't save to browser storage", "The view works for this session but won't be remembered.", AlertTone.Warning);
        }
    }

    private void UpdateViewDirty()
      => this._viewSession.UpdateDirty(this._filters, this._columns);

    private IReadOnlyList<JobTag> OrderedResidualTags(JobInspectionSummary job)
      => DashboardTagOrder.Apply(DashboardJobViews.GetResidualTags(job.Tags, this._columns), DashboardOptions.Value.TagDisplayOrder);

    private IReadOnlyList<string> ResidualTagValues(JobInspectionSummary job)
      => DashboardFormat.Tags(this.OrderedResidualTags(job));

    private string ResidualTagsTitle(JobInspectionSummary job)
      => DashboardFormat.TagsTitle(this.OrderedResidualTags(job));

    private static IReadOnlyList<string> TagValues(
        JobInspectionSummary job,
        ShedduellerDashboardJobColumn column)
      => [.. DashboardJobViews.GetTagValues(job.Tags, column.TagName!).Select(tag => tag.Value)];

    private static string TagValuesTitle(IReadOnlyList<string> values)
      => values.Count == 0 ? "No value" : string.Join(", ", values);

    private string TagValueFilterHref(
        ShedduellerDashboardJobColumn column,
        string value)
      => DashboardJobFilterQuery.WithTagHref(this._filters, string.Concat(column.TagName, ":", value), this.ViewParameter);

    private async Task ToggleStateAsync((JobState Value, bool Selected) change)
    {
        if (this._filters.SetStateSelected(change.Value, change.Selected))
        {
            await this.ApplyDiscreteFilterChangeAsync();
        }
    }

    private async Task ClearStatesAsync()
    {
        if (this._filters.ReplaceStates([]))
        {
            await this.ApplyDiscreteFilterChangeAsync();
        }
    }

    // Tag and group filters are applied from the "Add filter" menu or removed from their chip: discrete changes.
    private async Task ApplyTextFilterAsync((string Key, string Value) filter)
    {
        var changed = filter.Key switch
        {
            TagFilterKey => this._filters.SetTagContains(filter.Value),
            GroupFilterKey => this._filters.SetConcurrencyGroupContains(filter.Value),
            _ => false,
        };

        if (changed)
        {
            await this.ApplyDiscreteFilterChangeAsync();
        }
    }

    // Discrete changes (state toggles, sort, clear) push a history entry so Back steps through them.
    private async Task ApplyDiscreteFilterChangeAsync()
    {
        this._initialLocation = null;
        this._filterDebouncer.Cancel();
        this.UpdateViewDirty();
        this._take = DefaultPageSize;
        this.NavigateToCurrentState(replace: false);
        await this.LoadAsync(this._take);
    }

    private Task SetHandlerContainsAsync(string value)
      => this.SetTextFilterAsync(value, this._filters.SetHandlerContains);

    private async Task SetSortAsync(JobInspectionSort sort)
    {
        if (this._filters.SetSort(sort))
        {
            await this.ApplyDiscreteFilterChangeAsync();
        }
    }

    private static string SortLabel(JobInspectionSort sort)
      => sort == JobInspectionSort.NewestFirst ? "Newest first" : "Operational order";

    // Enter on a pasted job ID opens the job instead of filtering by it.
    private void HandleSearchKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Enter" && this.SearchJobId is { } jobId)
        {
            this._filterDebouncer.Cancel();
            Navigation.NavigateTo(DashboardFormat.JobHref(jobId));
        }
    }

    private Task SetTextFilterAsync(
        string value,
        Func<string, bool> setFilter)
    {
        if (setFilter(value))
        {
            this._initialLocation = null;
            this.UpdateViewDirty();
            this._filterDebouncer.Schedule(() => this.InvokeAsync(async () =>
            {
                // Typing replaces the current history entry rather than pushing one per keystroke burst.
                this._take = DefaultPageSize;
                this.NavigateToCurrentState(replace: true);
                await this.LoadAsync(this._take);
            }));
        }

        return Task.CompletedTask;
    }

    private async Task ClearAllAsync()
    {
        if (!this._filters.HasAppliedFilters)
        {
            return;
        }

        this._filters.Clear();
        await this.ApplyDiscreteFilterChangeAsync();
    }

    private async Task ClearQueuedJobsAsync()
    {
        if (this._isClearQueuedRunning)
        {
            return;
        }

        this._isClearQueuedRunning = true;

        try
        {
            var canceledCount = await JobManager.CancelQueuedJobsAsync();
            if (canceledCount == 0)
            {
                this.ShowToast("There were no queued jobs to cancel");
            }
            else
            {
                this.ShowToast(CreateClearQueuedSuccessMessage(canceledCount), tone: AlertTone.Success);
            }

            await this.LiveRefresh.RefreshNowAsync();
        }
        catch (Exception exception)
        {
            this.ShowToast("Couldn't cancel queued jobs", exception.Message, AlertTone.Destructive);
        }
        finally
        {
            this._isClearQueuedRunning = false;
        }
    }

    private async Task LoadAsync(int pageSize)
    {
        this._initialLoadDeferred = false;
        var query = this.CreateQuery(DashboardJobListLocation.NormalizeTake(pageSize), continuationToken: null);
        this._lastQuery = query;
        this.LiveRefresh.ClearError();
        var current = await this._jobs.LoadAsync(
          () => Reader.SearchJobsAsync(query),
          page =>
          {
              this.ReplaceJobs(page);
              this.LiveRefresh.MarkUpdated();
          });
        if (current)
        {
            this.NotifyShellRefreshChanged();
        }
    }

    // A failure keeps the loaded rows and is shown next to the Load more control.
    private async Task LoadMoreAsync()
    {
        var requested = await this._jobs.LoadMoreAsync(
          continuationToken => Reader.SearchJobsAsync(this._lastQuery with
          {
              PageSize = DefaultPageSize,
              ContinuationToken = continuationToken,
          }),
          page =>
          {
              this._jobs.SetRows(DashboardJobListMerge.Append(this._jobs.Rows, page.Jobs), page.ContinuationToken, page.TotalCount);
              this._take = DashboardJobListLocation.NormalizeTake(this._jobs.Rows.Count);
              this.NavigateToCurrentState(replace: true);
              this.LiveRefresh.MarkUpdated();
          });
        if (requested)
        {
            this.NotifyShellRefreshChanged();
        }
    }

    // Explicit refresh (manual refresh, "N new jobs — show", auto-refresh re-enabled, after an action): the fresh
    // result replaces the list.
    private Task RefreshCurrentQueryAsync(CancellationToken cancellationToken)
      => this.RefreshJobsAsync(mergeIntoDisplayedRows: false, cancellationToken);

    // Live-event refresh: displayed rows update in place and keep their order; new rows are held back and counted.
    private Task RefreshLiveAsync(CancellationToken cancellationToken)
      => this.RefreshJobsAsync(mergeIntoDisplayedRows: true, cancellationToken);

    private async Task RefreshJobsAsync(
        bool mergeIntoDisplayedRows,
        CancellationToken cancellationToken)
    {
        var queryVersion = this._jobs.QueryVersion;
        if (this._initialLoadDeferred)
        {
            return;
        }

        var visiblePageSize = Math.Max(DefaultPageSize, this._jobs.Rows.Count);
        var page = await Reader.SearchJobsAsync(this._lastQuery with
        {
            PageSize = visiblePageSize,
            ContinuationToken = null,
        }, cancellationToken);

        if (!this._jobs.IsCurrent(queryVersion))
        {
            return;
        }

        await this.ApplyPageStateAsync(() =>
        {
            if (!this._jobs.IsCurrent(queryVersion))
            {
                return;
            }

            if (mergeIntoDisplayedRows)
            {
                this.MergeLiveJobs(page);
            }
            else
            {
                this.ReplaceJobs(page);
            }
        });
    }

    private Task ShowPendingJobsAsync()
      => this.LiveRefresh.RefreshNowAsync();

    private void MergeLiveJobs(JobInspectionPage page)
    {
        // Nothing is on screen when the last load failed or nothing has loaded yet, so there is nothing to keep still.
        if (this._jobs.LoadError is not null || !this._jobs.HasPage || this._jobs.Rows.Count == 0)
        {
            this.ReplaceJobs(page);
            return;
        }

        // The merged rows keep the loaded depth, so the continuation still follows them.
        var merge = DashboardJobListMerge.Merge(this._jobs.Rows, page.Jobs);
        this._jobs.SetRows(merge.Rows, this._jobs.ContinuationToken, page.TotalCount);
        this.PruneSelection();
        this._pendingNewJobCount = merge.NewJobCount;
    }

    // Back/Forward, or a filter link on this page: the URL is the source of truth for filters, view, and depth.
    private async Task ApplyLocationAsync(string location)
    {
        this._initialLocation = null;
        this.NavigationState.JobsListHref = Navigation.ToBaseRelativePath(location);
        var next = DashboardJobListLocation.Parse(location);
        var view = this._viewSession.ResolveView(next.ViewKey);
        var viewChanged = !string.Equals(view.Key, this._viewSession.SelectedKey, StringComparison.Ordinal);
        if (viewChanged)
        {
            this.SelectView(view);
        }

        var filtersChanged = this._filters.ReplaceWith(next.Filters ?? DashboardJobViews.CreateFilters(view.Definition));
        var takeChanged = next.Take != this._take;
        this._take = next.Take;
        this.UpdateViewDirty();
        if (viewChanged || filtersChanged || takeChanged || this._initialLoadDeferred)
        {
            this._filterDebouncer.Cancel();
            await this.LoadAsync(this._take);
        }
    }

    private void NavigateToCurrentState(bool replace)
    {
        var href = DashboardJobListLocation.ToHref(
          this._filters,
          this._viewSession.CurrentViewFilters(),
          this.ViewParameter,
          this._take);
        this.NavigationState.JobsListHref = href;
        this.NavigateToLocation(href, replace);
    }

    private JobInspectionQuery CreateQuery(
        int pageSize,
        string? continuationToken)
      => this._filters.ToQuery(pageSize, continuationToken);

    private void ReplaceJobs(JobInspectionPage page)
    {
        this._jobs.Replace(page.Jobs, page.ContinuationToken, page.TotalCount);
        this.PruneSelection();
        this._pendingNewJobCount = 0;
    }

    private void PruneSelection()
    {
        if (this._selected.Count > 0)
        {
            this._selected.IntersectWith(this._jobs.Rows.Select(job => job.JobId));
        }
    }

    private void SetSelected(Guid jobId, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            _ = this._selected.Add(jobId);
        }
        else
        {
            _ = this._selected.Remove(jobId);
        }
    }

    private void ToggleAllSelected(ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            this._selected.UnionWith(this._jobs.Rows.Select(job => job.JobId));
        }
        else
        {
            this._selected.Clear();
        }
    }

    private void ClearSelection()
      => this._selected.Clear();

    private void OpenClearQueuedDialog()
      => this._clearQueuedDialogOpen = true;

    private void OpenCancelDialog(IReadOnlyList<Guid> jobIds)
    {
        if (jobIds.Count == 0)
        {
            return;
        }

        this._cancelTargets = jobIds;
        this._cancelDialogOpen = true;
    }

    // There is no batch cancel API, so each job is canceled in turn and the outcomes are summarised in one toast.
    private async Task CancelJobsAsync()
    {
        if (this._isCancelling || this._cancelTargets.Count == 0)
        {
            return;
        }

        this._isCancelling = true;
        var results = new List<JobCancellationResult>(this._cancelTargets.Count);
        try
        {
            foreach (var jobId in this._cancelTargets)
            {
                results.Add(await JobManager.CancelAsync(jobId));
            }

            var (title, description) = DashboardJobActions.DescribeCancellation(results);
            var tone = results.Any(result => result is JobCancellationResult.Canceled or JobCancellationResult.CancellationRequested)
              ? AlertTone.Success
              : AlertTone.Neutral;
            this.ShowToast(title, description, tone);
        }
        catch (Exception exception)
        {
            var (title, _) = DashboardJobActions.DescribeCancellation(results);
            this.ShowToast("Canceling stopped part way", string.Concat(results.Count > 0 ? string.Concat(title, ". ") : string.Empty, exception.Message), AlertTone.Destructive);
        }
        finally
        {
            this._selected.ExceptWith(this._cancelTargets);
            this._cancelTargets = [];
            this._isCancelling = false;
        }

        await this.LiveRefresh.RefreshNowAsync();
    }

    private Task RetryAsync()
      => this.LoadAsync(this._take);

    internal static string CreateClearQueuedSuccessMessage(int canceledCount)
      => string.Create(CultureInfo.InvariantCulture, $"Canceled {DashboardFormat.Count(canceledCount)} queued job(s).");

    // Filter links are plain hrefs, so they push history; they keep a non-preferred view in the URL.
    private string HandlerFilterHref(JobInspectionSummary job)
      => DashboardJobFilterQuery.WithHandlerHref(this._filters, DashboardFormat.ShortHandler(job), this.ViewParameter);

    private string TagFilterHref(string tag)
      => DashboardJobFilterQuery.WithTagHref(this._filters, tag, this.ViewParameter);

    private string GroupFilterHref(string group)
      => DashboardJobFilterQuery.WithGroupHref(this._filters, group, this.ViewParameter);
}
