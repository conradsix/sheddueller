    private async Task SetStateFilterAsync(
        JobState state,
        ChangeEventArgs eventArgs)
    {
        if (!this._filters.SetStateSelected(state, eventArgs.Value is bool selected && selected))
        {
            return;
        }

        await this.ApplyDiscreteFilterChangeAsync();
    }

    // Discrete changes (state toggles, sort, clear) push a history entry so Back steps through them.
    private async Task ApplyDiscreteFilterChangeAsync()
    {
        this._initialLocation = null;
        this.CancelPendingFilterLoad();
        this.UpdateViewDirty();
        this._take = DefaultPageSize;
        this.NavigateToCurrentState(replace: false);
        await this.LoadAsync(this._take);
    }

    private Task SetHandlerContainsAsync(string value)
      => this.SetTextFilterAsync(value, this._filters.SetHandlerContains);

    private Task SetTagContainsAsync(string value)
      => this.SetTextFilterAsync(value, this._filters.SetTagContains);

    private Task SetConcurrencyGroupContainsAsync(string value)
      => this.SetTextFilterAsync(value, this._filters.SetConcurrencyGroupContains);

    private async Task SetSortAsync(ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is not string value
            || !Enum.TryParse<JobInspectionSort>(value, ignoreCase: true, out var sort)
            || !Enum.IsDefined(sort)
            || !this._filters.SetSort(sort))
        {
            return;
        }

        await this.ApplyDiscreteFilterChangeAsync();
    }

    private Task SetTextFilterAsync(
        string value,
        Func<string, bool> setFilter)
    {
        if (setFilter(value))
        {
            this._initialLocation = null;
            this.UpdateViewDirty();
            this.ScheduleDebouncedLoad();
        }

        return Task.CompletedTask;
    }

    private async Task ClearAllAsync()
    {
        if (!this._filters.HasAppliedFilters)
        {
            return;
        }

        this._filters.Clear();
        await this.ApplyDiscreteFilterChangeAsync();
    }

    private async Task ClearQueuedJobsAsync()
    {
        if (this._isClearQueuedRunning)
        {
            return;
        }

        var confirmation = await JsRuntime.InvokeAsync<string?>("prompt", ClearQueuedPrompt);
        if (!string.Equals(confirmation?.Trim(), ClearQueuedConfirmationWord, StringComparison.Ordinal))
        {
            return;
        }

        this._isClearQueuedRunning = true;
        this.ClearActionAlert();

        try
        {
            var canceledCount = await JobManager.CancelQueuedJobsAsync();
            if (canceledCount == 0)
            {
                this.SetActionWarning("No queued jobs were available to cancel.");
            }
            else
            {
                this.SetActionSuccess(CreateClearQueuedSuccessMessage(canceledCount));
            }

            await this.LiveRefresh.RefreshNowAsync();
        }
        catch (Exception exception)
        {
            this.SetActionError(string.Create(CultureInfo.InvariantCulture, $"Clear queued jobs failed: {exception.Message}"));
        }
        finally
        {
            this._isClearQueuedRunning = false;
        }
    }

    private async Task LoadAsync(int pageSize)
    {
        this._initialLoadDeferred = false;
        var query = this.CreateQuery(DashboardJobListLocation.NormalizeTake(pageSize), continuationToken: null);
        var queryVersion = ++this._queryVersion;
        this._lastQuery = query;
        this._error = null;
        this.LiveRefresh.ClearError();
        this._isLoading = true;

        try
        {
            var page = await Reader.SearchJobsAsync(query);
            if (queryVersion != this._queryVersion)
            {
                return;
            }

            this.ReplaceJobs(page);
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            if (queryVersion == this._queryVersion)
            {
                this._error = exception.Message;
            }
        }
        finally
        {
            if (queryVersion == this._queryVersion)
            {
                this._isLoading = false;
                this.NotifyShellRefreshChanged();
            }
        }
    }

    private async Task LoadMoreAsync()
    {
        if (this._page?.ContinuationToken is null || this._isLoading || this._isLoadingMore)
        {
            return;
        }

        var queryVersion = this._queryVersion;
        this._loadMoreError = null;
        this._isLoadingMore = true;

        try
        {
            var page = await Reader.SearchJobsAsync(this._lastQuery with
            {
                PageSize = DefaultPageSize,
                ContinuationToken = this._page.ContinuationToken,
            });

            if (queryVersion != this._queryVersion)
            {
                return;
            }

            var rows = DashboardJobListMerge.Append(this._jobs, page.Jobs);
            this._jobs.Clear();
            this._jobs.AddRange(rows);
            this._page = page;
            this._take = DashboardJobListLocation.NormalizeTake(this._jobs.Count);
            this.NavigateToCurrentState(replace: true);
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            // Keep the loaded rows; the failure is shown next to the Load More control.
            if (queryVersion == this._queryVersion)
            {
                this._loadMoreError = exception.Message;
            }
        }
        finally
        {
            if (queryVersion == this._queryVersion)
            {
                this._isLoadingMore = false;
                this.NotifyShellRefreshChanged();
            }
        }
    }

    private async ValueTask OnJobEventPublishedAsync(
        JobEvent jobEvent,
        CancellationToken cancellationToken)
    {
        _ = cancellationToken;

        await this.ApplyPageStateAsync(() => this.LiveRefresh.MarkLiveActivity(jobEvent.OccurredAtUtc));
        this.LiveRefresh.QueueRefresh();
    }

    // Explicit refresh (manual refresh, "N new jobs — show", auto-refresh re-enabled, after an action): the fresh
    // result replaces the list.
    private Task RefreshCurrentQueryAsync(CancellationToken cancellationToken)
      => this.RefreshJobsAsync(mergeIntoDisplayedRows: false, cancellationToken);

    // Live-event refresh: displayed rows update in place and keep their order; new rows are held back and counted.
    private Task RefreshLiveAsync(CancellationToken cancellationToken)
      => this.RefreshJobsAsync(mergeIntoDisplayedRows: true, cancellationToken);

    private async Task RefreshJobsAsync(
        bool mergeIntoDisplayedRows,
        CancellationToken cancellationToken)
    {
        var queryVersion = this._queryVersion;
        if (this._initialLoadDeferred)
        {
            return;
        }

        var visiblePageSize = Math.Max(DefaultPageSize, this._jobs.Count);
        var page = await Reader.SearchJobsAsync(this._lastQuery with
        {
            PageSize = visiblePageSize,
            ContinuationToken = null,
        }, cancellationToken);

        if (queryVersion != this._queryVersion)
        {
            return;
        }

        await this.ApplyPageStateAsync(() =>
        {
            if (queryVersion != this._queryVersion)
            {
                return;
            }

            if (mergeIntoDisplayedRows)
            {
                this.MergeLiveJobs(page);
            }
            else
            {
                this.ReplaceJobs(page);
            }
        });
    }

    private Task ShowPendingJobsAsync()
      => this.LiveRefresh.RefreshNowAsync();

    private void MergeLiveJobs(JobInspectionPage page)
    {
        // Nothing is on screen when the last load failed or nothing has loaded yet, so there is nothing to keep still.
        if (this._error is not null || this._page is null || this._jobs.Count == 0)
        {
            this.ReplaceJobs(page);
            return;
        }

        var merge = DashboardJobListMerge.Merge(this._jobs, page.Jobs);
        this._jobs.Clear();
        this._jobs.AddRange(merge.Rows);
        this._pendingNewJobCount = merge.NewJobCount;
        this._page = this._page with { TotalCount = page.TotalCount };
    }

    private void ScheduleDebouncedLoad()
    {
        var previous = this._filterDebounceCts;
        previous?.Cancel();

        var next = new CancellationTokenSource();
        this._filterDebounceCts = next;
        _ = this.RunDebouncedLoadAsync(next);
    }

    private async Task RunDebouncedLoadAsync(CancellationTokenSource cancellationTokenSource)
    {
        try
        {
            await Task.Delay(FilterDebounce, cancellationTokenSource.Token);
            await this.InvokeAsync(async () =>
            {
                // Typing replaces the current history entry rather than pushing one per keystroke burst.
                this._take = DefaultPageSize;
                this.NavigateToCurrentState(replace: true);
                await this.LoadAsync(this._take);
            });
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(this._filterDebounceCts, cancellationTokenSource))
            {
                this._filterDebounceCts = null;
            }

            cancellationTokenSource.Dispose();
        }
    }

    private void CancelPendingFilterLoad()
    {
        var cancellationTokenSource = this._filterDebounceCts;
        this._filterDebounceCts = null;
        cancellationTokenSource?.Cancel();
    }

    // Back/Forward, or a filter link on this page: the URL is the source of truth for filters, view, and depth.
    private async Task ApplyLocationAsync(string location)
    {
        this._initialLocation = null;
        this.NavigationState.JobsListHref = Navigation.ToBaseRelativePath(location);
        var next = DashboardJobListLocation.Parse(location);
        var view = (next.ViewKey is { } viewKey ? this.FindView(viewKey) : null)
          ?? this.FindView(this._preferredViewKey)
          ?? this.ConfiguredDefaultView();
        var viewChanged = !string.Equals(view.Key, this._selectedViewKey, StringComparison.Ordinal);
        if (viewChanged)
        {
            this.SelectView(view);
        }

        var filtersChanged = this._filters.ReplaceWith(next.Filters ?? DashboardJobViews.CreateFilters(view.Definition));
        var takeChanged = next.Take != this._take;
        this._take = next.Take;
        this.UpdateViewDirty();
        if (viewChanged || filtersChanged || takeChanged || this._initialLoadDeferred)
        {
            this.CancelPendingFilterLoad();
            await this.LoadAsync(this._take);
        }
    }

    private void NavigateToCurrentState(bool replace)
    {
        var href = DashboardJobListLocation.ToHref(
          this._filters,
          this.CurrentViewFilters(),
          this.ViewParameter,
          this._take);
        this.NavigationState.JobsListHref = href;
        this.NavigateToLocation(href, replace);
    }

    private JobInspectionQuery CreateQuery(
        int pageSize,
        string? continuationToken)
      => this._filters.ToQuery(pageSize, continuationToken);

    private void ReplaceJobs(JobInspectionPage page)
    {
        this._jobs.Clear();
        this._jobs.AddRange(page.Jobs);
        this._page = page;
        this._pendingNewJobCount = 0;
        this._loadMoreError = null;
        this._error = null;
    }

    private void SetActionSuccess(string message)
    {
        this._actionSeverity = JobsActionSeverity.Success;
        this._actionMessage = message;
    }

    private void SetActionWarning(string message)
    {
        this._actionSeverity = JobsActionSeverity.Warning;
        this._actionMessage = message;
    }

    private void SetActionError(string message)
    {
        this._actionSeverity = JobsActionSeverity.Error;
        this._actionMessage = message;
    }

    private void ClearActionAlert()
      => this._actionMessage = null;

    internal static string CreateClearQueuedSuccessMessage(int canceledCount)
      => string.Create(CultureInfo.InvariantCulture, $"Canceled {DashboardFormat.Count(canceledCount)} queued job(s).");

