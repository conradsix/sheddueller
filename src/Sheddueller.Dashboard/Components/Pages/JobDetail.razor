@page "/jobs/{JobId:guid}"
@inherits DashboardPageComponent
@inject IJobInspectionReader Reader
@inject IJobManager JobManager
@inject DashboardLiveUpdateStream LiveUpdates
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<div class="sd-page job-detail-page">
    <a class="job-detail-back" href="@JobsListHref">
        <Icon Name="arrow-left" />
        <span>Jobs</span>
        @if (JobsListContext is { } listContext)
        {
            <span class="job-detail-back__context" title="@listContext">@listContext</span>
        }
    </a>

    @if (_detail is null)
    {
        @if (_error is not null)
        {
            <Alert Tone="AlertTone.Destructive" Title="Couldn't load the job">
                <ChildContent>@_error</ChildContent>
                <Actions>
                    <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="LoadAsync">Try again</Button>
                </Actions>
            </Alert>
        }
        else if (_isLoading || _loadedJobId != JobId)
        {
            <div class="job-detail-loading" aria-busy="true">
                <span class="sd-sr-only">Loading the job…</span>
                <Skeleton Width="min(320px, 70%)" Height="28px" />
                <Skeleton Width="min(520px, 90%)" />
                <Skeleton Height="64px" />
                <Skeleton Height="148px" />
            </div>
        }
        else
        {
            <EmptyState Icon="search-x" Title="Job not found">
                <ChildContent>
                    No job has the ID <span class="sd-mono">@DashboardFormat.JobId(JobId)</span>. Job retention may have removed it,
                    or the link is wrong.
                </ChildContent>
                <Actions>
                    <Button Href="@JobsListHref" Icon="arrow-left">Back to jobs</Button>
                </Actions>
            </EmptyState>
        }
    }
    else
    {
        var job = _detail.Summary;
        var logLines = AllLogLines;
        var visibleLogLines = DashboardJobLog.Filter(logLines, _logFilter);
        var lifecycleEvents = LifecycleEvents;
        var latestFailure = DashboardJobDetailFormat.LatestFailure(_eventLog.Events);
        var timing = DashboardJobTiming.From(_detail, _eventLog.Events);

        var call = _detail.Invocation is { } detailInvocation ? CallFor(detailInvocation) : null;

        <PageHeader Title="@DashboardFormat.ShortHandler(job)" Description="@(call is null ? DashboardFormat.FullHandler(job) : null)">
            <TitleAddon>
                <StatusBadge State="job.State" />
            </TitleAddon>
            <ChildContent>
                @if (call is not null)
                {
                    <div class="job-detail-call">
                        <code class="job-detail-call__code" title="@DashboardFormat.FullHandler(job)">
                            <span class="token function">@call.MethodName</span><span class="token punctuation">(</span>
                            @for (var index = 0; index < call.HeaderArguments.Count; index++)
                            {
                                @if (index > 0)
                                {
                                    @(" ")
                                }
                                <span class="job-detail-call__argument"><CodeTokens Tokens="call.HeaderArguments[index]" /></span>
                            }
                            <span class="token punctuation">)</span>
                        </code>
                        <CopyButton Value="@call.HeaderText" Label="method call" />
                    </div>
                }
                <div class="job-detail-meta">
                    <span class="@DashboardJobDetailFormat.AttemptClass(job)">@DashboardJobDetailFormat.Attempts(job)</span>
                    @if (!string.IsNullOrWhiteSpace(_detail.ClaimedByNodeId))
                    {
                        <span>Node <a class="sd-link sd-mono" href="@DashboardNodeFilterQuery.NodeHref(_detail.ClaimedByNodeId)">@_detail.ClaimedByNodeId</a></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(job.SourceScheduleKey))
                    {
                        <span>Schedule <a class="sd-link sd-mono" href="@DashboardScheduleFilterQuery.ScheduleHref(job.SourceScheduleKey)">@job.SourceScheduleKey</a></span>
                    }
                    <span class="job-detail-meta__id">
                        <span class="sd-mono">@DashboardFormat.JobId(job.JobId)</span>
                        <CopyButton Value="@DashboardFormat.JobId(job.JobId)" Label="job ID" />
                    </span>
                </div>
            </ChildContent>
            <Actions>
                @if (DashboardJobActions.IsCancellable(job))
                {
                    <Button Variant="ButtonVariant.DestructiveOutline" Icon="@(_isCancelRunning ? "loader-circle" : "ban")"
                            Disabled="_isCancelRunning" OnClick="OpenCancelDialog">Cancel job…</Button>
                }
                <DropdownMenu Label="More job actions" Icon="ellipsis" Variant="ButtonVariant.Outline">
                    <MenuItem Icon="copy" data-sd-copy="@DashboardFormat.JobId(job.JobId)" data-sd-copy-label="job ID">Copy job ID</MenuItem>
                    @if (call is not null)
                    {
                        <MenuItem Icon="copy" data-sd-copy="@call.FullText" data-sd-copy-label="invocation">Copy invocation</MenuItem>
                    }
                    <MenuSeparator />
                    <MenuItem Icon="list-filter" Href="@DashboardJobFilterQuery.HandlerHref(job)">Jobs with this handler</MenuItem>
                    @foreach (var group in job.ConcurrencyGroupKeys.Take(MenuGroupLimit))
                    {
                        <MenuItem Icon="layers" Href="@DashboardJobFilterQuery.GroupHref(group)">Jobs in group <span class="sd-mono">@group</span></MenuItem>
                    }
                </DropdownMenu>
            </Actions>
        </PageHeader>

        @if (LiveRefresh.RefreshError is not null)
        {
            <Alert Tone="AlertTone.Warning" Title="Couldn't refresh the job">
                Showing the last loaded state. @LiveRefresh.RefreshError
            </Alert>
        }

        @switch (job.State)
        {
            case JobState.Claimed:
                <Alert Tone="@(job.CancellationRequestedAtUtc is null ? AlertTone.Info : AlertTone.Warning)"
                       Icon="@(job.CancellationRequestedAtUtc is null ? "loader-circle" : "circle-pause")"
                       Title="@(job.CancellationRequestedAtUtc is null ? "Running" : "Running · cancellation requested")"
                       Class="job-detail-callout">
                    <ChildContent>
                        @if (job.CancellationRequestedAtUtc is not null)
                        {
                            <p>The job stops at its next cancellation check.</p>
                        }
                        <div class="job-detail-progress">
                            @if (job.LatestProgress?.Percent is { } percent)
                            {
                                <Progress Value="percent" Label="@($"Progress {DashboardFormat.ProgressPercent(job.LatestProgress)}")" />
                                <span class="job-detail-progress__percent sd-num">@DashboardFormat.ProgressPercent(job.LatestProgress)</span>
                            }
                            <span class="job-detail-progress__message">@(job.LatestProgress?.Message ?? (job.LatestProgress is null ? "No progress reported yet." : null))</span>
                        </div>
                        @if (job.LatestProgress is { } progress)
                        {
                            <div class="sd-alert__meta job-detail-callout__meta">
                                <span>Last update</span>
                                <TimestampBlock BaseClass="sd-timestamp" Value="progress.ReportedAtUtc" AllowFutureRelative="false" Inline />
                            </div>
                        }
                    </ChildContent>
                </Alert>
                break;

            case JobState.Failed:
                var failedAttempt = latestFailure?.AttemptNumber ?? job.AttemptCount;
                var failureErrorCount = DashboardJobLog.Count(logLines, new DashboardJobLogFilter(DashboardLogLevelFilter.Errors, failedAttempt));
                <Alert Tone="AlertTone.Destructive" Icon="circle-x" Title="@FailedTitle(job)" Class="job-detail-callout">
                    <ChildContent>
                        <p class="job-detail-failure">@(latestFailure?.Message is { Length: > 0 } failureMessage ? failureMessage : "No failure message was recorded.")</p>
                    </ChildContent>
                    <Actions>
                        <Button Size="ButtonSize.Small" Icon="list-filter" OnClick="() => ShowAttemptLogs(failedAttempt, failureErrorCount > 0)">
                            @(failureErrorCount > 0 ? $"Show error lines ({DashboardFormat.Count(failureErrorCount)})" : "Show this attempt's logs")
                        </Button>
                    </Actions>
                </Alert>
                break;

            case JobState.Completed:
                // The status badge and the timing tiles say it all.
                break;

            case JobState.Canceled:
                <Alert Tone="AlertTone.Neutral" Icon="ban" Title="Canceled" Class="job-detail-callout">
                    <ChildContent>
                        <p>@CanceledText(_detail)</p>
                    </ChildContent>
                </Alert>
                break;

            default:
                var queueKind = job.QueuePosition?.Kind;
                <Alert Tone="@QueuedTone(job)" Icon="@QueuedIcon(job)" Title="@DashboardJobDetailFormat.QueueTitle(job)" Class="job-detail-callout">
                    <ChildContent>
                        <p>@QueuedText(job, latestFailure)</p>
                        @if (queueKind == JobQueuePositionKind.BlockedByConcurrency && job.ConcurrencyGroupKeys.Count > 0)
                        {
                            <div class="sd-tags job-detail-callout__tags">
                                @foreach (var group in job.ConcurrencyGroupKeys)
                                {
                                    <Tag Value="@group" Href="@DashboardConcurrencyGroupFilterQuery.GroupHref(group)" data-sd-tooltip="@($"Open concurrency group {group}")" />
                                }
                            </div>
                        }
                        @if (job.NotBeforeUtc is not null && queueKind is JobQueuePositionKind.Delayed or JobQueuePositionKind.RetryWaiting)
                        {
                            <div class="sd-alert__meta job-detail-callout__meta">
                                <span>Runs</span>
                                <TimestampBlock BaseClass="sd-timestamp" Value="job.NotBeforeUtc" Inline />
                            </div>
                        }
                    </ChildContent>
                    <Actions>
                        @if (queueKind == JobQueuePositionKind.WaitingForDependencies && _detail.PrerequisiteJobIds.Count > 0)
                        {
                            <Button Size="ButtonSize.Small" Href="@TabHref(DashboardJobDetailTab.Related)" IconEnd="chevron-right">Show prerequisites</Button>
                        }
                    </Actions>
                </Alert>
                break;
        }

        <Card Flush="true" Class="job-detail-stats-card">
            <dl class="job-detail-stats">
                <div class="job-detail-stat">
                    <dt>@(timing.IsWaiting ? "Waiting" : "Waited")</dt>
                    <dd class="job-detail-stat__value">
                        @if (timing.IsWaiting)
                        {
                            <LiveElapsed Since="timing.EnqueuedAtUtc" />
                        }
                        else if (timing.Waited is { } waited)
                        {
                            @DashboardMetricsFormat.Duration(waited)
                        }
                        else
                        {
                            <span class="sd-muted">—</span>
                        }
                    </dd>
                    <dd class="job-detail-stat__sub">
                        <TimestampBlock BaseClass="sd-timestamp" Value="timing.EnqueuedAtUtc" AllowFutureRelative="false" Prefix="enqueued" Inline />
                    </dd>
                </div>
                <div class="job-detail-stat">
                    <dt>@timing.LastRunLabel</dt>
                    @if (timing.LastRunAtUtc is { } lastRunAtUtc)
                    {
                        <dd><TimestampBlock BaseClass="job-detail-when" Value="lastRunAtUtc" AllowFutureRelative="false" /></dd>
                    }
                    else
                    {
                        <dd class="job-detail-stat__value sd-muted">Not run yet</dd>
                    }
                </div>
                <div class="job-detail-stat">
                    <dt>@(timing.IsRunning ? "Running for" : "Run time")</dt>
                    <dd class="job-detail-stat__value">
                        @if (timing.IsRunning && timing.LastStartedAtUtc is { } runningSinceUtc)
                        {
                            <LiveElapsed Since="runningSinceUtc" />
                        }
                        else if (timing.RunTime is { } runTime)
                        {
                            @DashboardMetricsFormat.Duration(runTime)
                        }
                        else
                        {
                            <span class="sd-muted">—</span>
                        }
                    </dd>
                    @if (!timing.IsRunning && timing.LastStartedAtUtc is { } lastStartedAtUtc)
                    {
                        <dd class="job-detail-stat__sub">
                            <TimestampBlock BaseClass="sd-timestamp" Value="lastStartedAtUtc" AllowFutureRelative="false" Prefix="started" Inline />
                        </dd>
                    }
                </div>
                <div class="job-detail-stat">
                    <dt>Tags</dt>
                    <dd>
                        <TagList Values="@DashboardFormat.Tags(job.Tags)" Title="@DashboardFormat.TagsTitle(job.Tags)"
                                 HrefFactory="DashboardJobFilterQuery.TagHref" TooltipPrefix="Show jobs with tag" MaxVisible="8" EmptyText="No tags" />
                    </dd>
                </div>
            </dl>
            <dl class="job-detail-details">
                <div>
                    <dt>Priority</dt>
                    <dd class="sd-num">@job.Priority.ToString(CultureInfo.InvariantCulture)</dd>
                </div>
                @if (job.ConcurrencyGroupKeys.Count > 0)
                {
                    <div>
                        <dt>Concurrency groups</dt>
                        <dd>
                            <TagList Values="job.ConcurrencyGroupKeys" Title="@DashboardFormat.GroupKeysTitle(job.ConcurrencyGroupKeys)"
                                     HrefFactory="DashboardConcurrencyGroupFilterQuery.GroupHref" TooltipPrefix="Open concurrency group" MaxVisible="3" />
                        </dd>
                    </div>
                }
                @if (timing.IsRunning && _detail.LeaseExpiresAtUtc is not null)
                {
                    <div>
                        <dt>Lease expires</dt>
                        <dd><TimestampBlock BaseClass="sd-timestamp" Value="_detail.LeaseExpiresAtUtc" Inline /></dd>
                    </div>
                }
                @if (_detail.ScheduledFireAtUtc is not null)
                {
                    <div>
                        <dt>Schedule fired</dt>
                        <dd><TimestampBlock BaseClass="sd-timestamp" Value="_detail.ScheduledFireAtUtc" AllowFutureRelative="false" Inline /></dd>
                    </div>
                }
            </dl>
        </Card>

        <section class="job-detail-sections">
            <div class="job-detail-sticky">
                <div class="job-detail-sticky__bar">
                    <Tabs TValue="DashboardJobDetailTab" Items="TabItems(DashboardJobLog.Count(logLines, new DashboardJobLogFilter()), lifecycleEvents.Count)" Value="ActiveTab"
                          Variant="TabsVariant.Line" Label="Job sections" />

                    @if (ActiveTab == DashboardJobDetailTab.Logs && logLines.Count > 0)
                    {
                        @LogToolbar(job, logLines, visibleLogLines)
                    }
                </div>
            </div>

            <div class="job-detail-panel" role="tabpanel" aria-label="@ActiveTab.ToString()">
                @switch (ActiveTab)
                {
                    case DashboardJobDetailTab.Timeline:
                        @TimelinePanel(lifecycleEvents)
                        break;

                    case DashboardJobDetailTab.Invocation:
                        @InvocationPanel(_detail, call)
                        break;

                    case DashboardJobDetailTab.Related:
                        @RelatedPanel(_detail)
                        break;

                    default:
                        @LogsPanel(logLines, visibleLogLines)
                        break;
                }
            </div>
        </section>
    }
</div>

<ConfirmDialog @bind-Open="_cancelDialogOpen" Title="Cancel this job?" ConfirmLabel="Cancel job" CancelLabel="Keep job"
               Destructive="true" Busy="_isCancelRunning" OnConfirm="CancelJobAsync">
    <p>@CancelDialogDescription</p>
</ConfirmDialog>

@code {
    // Each tab's markup. The tabs' state and behaviour live in JobDetail.Logs.cs, JobDetail.Events.cs (the event log
    // behind the logs and timeline), JobDetail.Invocation.cs, and JobDetail.Related.cs.

    private RenderFragment LogToolbar(
        JobInspectionSummary job,
        IReadOnlyList<JobEvent> logLines,
        IReadOnlyList<JobEvent> visibleLogLines)
      => @<div class="sd-toolbar job-detail-log-toolbar">
              <Tabs TValue="DashboardLogLevelFilter" Items="LevelTabItems(logLines)" Value="_logFilter.Level" ValueChanged="SetLogLevel"
                    Label="Log level" Small="true" />
              @if (LogAttempts is { Count: > 1 } attempts)
              {
                  <DropdownMenu Label="Filter by attempt" Variant="ButtonVariant.Outline" AlignStart="true">
                      <TriggerContent>
                          <span class="sd-muted">Attempt:</span>
                          <span>@(_logFilter.Attempt?.ToString(CultureInfo.InvariantCulture) ?? "All")</span>
                      </TriggerContent>
                      <ChildContent>
                          <MenuLabel>Show lines from</MenuLabel>
                          @foreach (var attempt in attempts.Cast<int?>().Prepend(null))
                          {
                              var selected = attempt == _logFilter.Attempt;
                              <button type="button" role="menuitemradio" class="sd-menu__item" aria-checked="@(selected ? "true" : "false")"
                                      @key="attempt" @onclick="() => SetLogAttempt(attempt)">
                                  <span class="job-detail-menu-check" aria-hidden="true">
                                      @if (selected)
                                      {
                                          <Icon Name="check" />
                                      }
                                  </span>
                                  <span>@(attempt is { } number ? $"Attempt {number}" : "All attempts")</span>
                              </button>
                          }
                      </ChildContent>
                  </DropdownMenu>
              }
              <SearchInput Class="job-detail-log-search" Value="@_logFilter.Search" ValueChanged="SetLogSearch"
                           Placeholder="Search messages and fields" Label="Search log lines" Shortcut="true" />
              <span class="sd-toolbar__spacer"></span>
              <DropdownMenu Label="Display options" Variant="ButtonVariant.Ghost">
                  <TriggerContent>
                      <span>Display</span>
                  </TriggerContent>
                  <ChildContent>
                      <MenuLabel>Show</MenuLabel>
                      <button type="button" role="menuitemcheckbox" class="sd-menu__item" data-sd-keep-open="true"
                              aria-checked="@(_logFilter.IncludeProgress ? "true" : "false")" @onclick="ToggleProgressLines">
                          <span class="sd-menu__check" aria-hidden="true"><Icon Name="check" /></span>
                          <span>Progress updates</span>
                      </button>
                      <button type="button" role="menuitemcheckbox" class="sd-menu__item" data-sd-keep-open="true"
                              aria-checked="@(_showLogFields ? "true" : "false")" @onclick="ToggleLogFields">
                          <span class="sd-menu__check" aria-hidden="true"><Icon Name="check" /></span>
                          <span>Structured fields</span>
                      </button>
                  </ChildContent>
              </DropdownMenu>
              @if (IsLive(job) && !_logsPaused)
              {
                  <Switch Value="_followLogs" ValueChanged="SetFollowLogs">Follow new lines</Switch>
              }
              @if (IsLive(job) || _logsPaused)
              {
                  <Button Variant="ButtonVariant.Ghost" Icon="@(_logsPaused ? "play" : "pause")" OnClick="ToggleLogsPaused"
                          aria-pressed="@(_logsPaused ? "true" : "false")"
                          data-sd-tooltip="@(_logsPaused ? "Show new lines again" : "Stop adding new lines while you read")">
                      @(_logsPaused ? "Resume" : "Pause")
                  </Button>
              }
              <IconButton Icon="download" Label="Download the lines shown" Disabled="@(visibleLogLines.Count == 0)"
                          OnClick="() => DownloadLogAsync(visibleLogLines)" />
          </div>;

    private RenderFragment LogsPanel(
        IReadOnlyList<JobEvent> logLines,
        IReadOnlyList<JobEvent> visibleLogLines)
      => @<Card Flush="true" Class="job-detail-panel-card">
              @if (visibleLogLines.Count == 0 && !_logFilter.IsNarrowed)
              {
                  @if (logLines.Count == 0)
                  {
                      <EmptyState Flat="true" Icon="list" Title="No log lines yet">
                          Lines appear here when the job writes logs with <span class="sd-mono">ILogger</span>.
                      </EmptyState>
                  }
                  else
                  {
                      <EmptyState Flat="true" Icon="list" Title="No log lines yet">
                          <ChildContent>The job has only reported progress so far.</ChildContent>
                          <Actions>
                              <Button OnClick="ToggleProgressLines">Show progress updates</Button>
                          </Actions>
                      </EmptyState>
                  }
              }
              else if (visibleLogLines.Count == 0)
              {
                  <EmptyState Flat="true" Icon="search-x" Title="No lines match">
                      <ChildContent>Try a different level, attempt, or search.</ChildContent>
                      <Actions>
                          <Button OnClick="ClearLogFilters">Clear filters</Button>
                      </Actions>
                  </EmptyState>
              }
              else
              {
                  <div class="job-detail-log">
                      <div class="job-detail-log__row job-detail-log__head" aria-hidden="true">
                          <span>Time (UTC)</span>
                          <span>Level</span>
                          <span>Attempt</span>
                          <span>Message</span>
                      </div>
                      @foreach (var line in visibleLogLines)
                      {
                          <div class="@($"job-detail-log__row job-detail-log__row--{DashboardJobLog.LevelModifier(line)}")" @key="line.EventId">
                              <time class="job-detail-log__time" datetime="@line.OccurredAtUtc.ToString("O", CultureInfo.InvariantCulture)"
                                    title="@DashboardFormat.Utc(line.OccurredAtUtc)">@DashboardJobLog.Time(line)</time>
                              <span class="job-detail-log__level">@DashboardJobLog.LevelLabel(line)</span>
                              <span class="job-detail-log__attempt" title="@($"Attempt {line.AttemptNumber}")">@line.AttemptNumber</span>
                              <div class="job-detail-log__message">
                                  <span class="job-detail-log__text">@DashboardJobLog.Message(line)</span>
                                  @if (_showLogFields && line.Fields is { Count: > 0 })
                                  {
                                      <span class="job-detail-log__fields">
                                          @foreach (var field in DashboardJobLog.Fields(line))
                                          {
                                              <span class="job-detail-log__field"><span class="job-detail-log__key">@field.Key</span>=@field.Value</span>
                                          }
                                      </span>
                                  }
                              </div>
                          </div>
                      }
                  </div>
              }
              <footer class="sd-table__footer">
                  <span class="sd-num">@LogFooterText(visibleLogLines.Count, logLines.Count)</span>
                  @if (HasMoreEvents)
                  {
                      <Button Size="ButtonSize.Small" Icon="@(_isLoadingMoreEvents ? "loader-circle" : null)"
                              Disabled="_isLoadingMoreEvents" OnClick="LoadMoreEventsAsync">@LoadMoreEventsText</Button>
                  }
              </footer>
              <div @ref="_logEnd" aria-hidden="true"></div>
          </Card>;

    private RenderFragment TimelinePanel(IReadOnlyList<JobEvent> lifecycleEvents)
      => @<Card Flush="true" Class="job-detail-panel-card">
              @if (lifecycleEvents.Count == 0)
              {
                  <EmptyState Flat="true" Icon="activity" Title="No lifecycle events yet">
                      Events appear here as the job is queued, claimed, and finished.
                  </EmptyState>
              }
              else
              {
                  <ol class="job-detail-timeline">
                      @foreach (var jobEvent in lifecycleEvents)
                      {
                          var timelineDetail = DashboardJobDetailFormat.TimelineDetail(jobEvent);
                          <li class="@($"job-detail-timeline__item job-detail-timeline__item--{DashboardJobDetailFormat.TimelineTone(jobEvent)}")"
                              @key="jobEvent.EventId">
                              <span class="job-detail-timeline__dot" aria-hidden="true"></span>
                              <div class="job-detail-timeline__body">
                                  <span class="job-detail-timeline__title">@DashboardJobDetailFormat.TimelineTitle(jobEvent)</span>
                                  @if (timelineDetail is not null)
                                  {
                                      <p class="job-detail-timeline__detail">@timelineDetail</p>
                                  }
                              </div>
                              <TimestampBlock BaseClass="sd-timestamp" Value="jobEvent.OccurredAtUtc" AllowFutureRelative="false" AlignEnd />
                          </li>
                      }
                  </ol>
              }
              @if (HasMoreEvents)
              {
                  <footer class="sd-table__footer">
                      <span>Older events are loaded first; more may follow.</span>
                      <Button Size="ButtonSize.Small" Icon="@(_isLoadingMoreEvents ? "loader-circle" : null)"
                              Disabled="_isLoadingMoreEvents" OnClick="LoadMoreEventsAsync">@LoadMoreEventsText</Button>
                  </footer>
              }
          </Card>;

    private RenderFragment InvocationPanel(
        JobInspectionDetail detail,
        InvocationCall? call)
      => __builder =>
      {
          var job = detail.Summary;
          @if (detail.Invocation is { } invocation && call is not null)
          {
              <Card Title="Method call" Class="job-detail-panel-card">
                  <HeaderActions>
                      <CopyButton Value="@call.FullText" Label="invocation" Size="ButtonSize.Small" />
                  </HeaderActions>
                  <ChildContent>
                      <pre class="sd-code job-detail-code"><code><CodeTokens Tokens="call.FullCall" /></code></pre>
                      <dl class="job-detail-invocation-meta">
                          <div>
                              <dt>Handler</dt>
                              <dd class="sd-mono" title="@DashboardFormat.FullHandler(job)">@DashboardInvocationView.Handler(invocation)</dd>
                          </div>
                          <div>
                              <dt>Target</dt>
                              <dd>@invocation.TargetKind.ToString()</dd>
                          </div>
                          <div>
                              <dt>Arguments</dt>
                              <dd>
                                  <span class="sd-num">@DashboardFormat.Count(invocation.SerializedArgumentsByteCount) bytes</span>
                                  <span class="sd-muted sd-mono">@invocation.SerializedArgumentsContentType</span>
                              </dd>
                          </div>
                      </dl>
                  </ChildContent>
              </Card>

              @if (invocation.SerializedArgumentsStatus != JobSerializedArgumentsInspectionStatus.Displayable)
              {
                  <Alert Tone="AlertTone.Warning" Title="Argument values can't be shown">
                      @DashboardInvocationView.StatusMessage(invocation)
                  </Alert>
              }

              @if (call.Parameters.Count > 0)
              {
                  <Card Title="Parameters" Flush="true" Class="job-detail-panel-card">
                      <ol class="job-detail-params">
                          @foreach (var (argument, value) in call.Parameters)
                          {
                              <li class="job-detail-param" @key="argument.Index">
                                  <div class="job-detail-param__head">
                                      <span class="sd-muted sd-num">@string.Create(CultureInfo.InvariantCulture, $"#{argument.Index + 1}")</span>
                                      @if (argument.Name is not null)
                                      {
                                          <strong class="sd-mono">@argument.Name</strong>
                                      }
                                      <span class="job-detail-param__type sd-mono" title="@argument.ParameterType">@DashboardTypeName.Short(argument.ParameterType)</span>
                                      <Badge Variant="BadgeVariant.Secondary">@DashboardInvocationView.BindingLabel(argument)</Badge>
                                  </div>
                                  @if (argument.ValueJson is not null)
                                  {
                                      <pre class="sd-code job-detail-code"><code><CodeTokens Tokens="value" /></code></pre>
                                  }
                              </li>
                          }
                      </ol>
                  </Card>
              }
          }
          else
          {
              <EmptyState Icon="info" Title="No invocation details">
                  The store didn't return the method call for this job.
              </EmptyState>
          }
      };

    private RenderFragment RelatedPanel(JobInspectionDetail detail)
      => __builder =>
      {
          var relatedSections = RelatedSections(detail);
          @if (_relatedError is not null)
          {
              <Alert Tone="AlertTone.Destructive" Title="Couldn't load the related jobs">
                  <ChildContent>@_relatedError</ChildContent>
                  <Actions>
                      <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="RetryRelatedJobs">Try again</Button>
                  </Actions>
              </Alert>
          }
          @if (relatedSections.Count == 0)
          {
              <EmptyState Icon="git-fork" Title="No related jobs">
                  This job has no prerequisites or continuations, and it wasn't retried.
              </EmptyState>
          }
          @foreach (var section in relatedSections)
          {
              <Card Title="@section.Title" Description="@section.Description" Flush="true" Class="job-detail-panel-card" @key="section.Title">
                  <ChildContent>
                      <table class="sd-table job-detail-related">
                          <tbody>
                              @foreach (var relatedJobId in section.JobIds.Take(RelatedJobLimit))
                              {
                                  <tr data-href="@DashboardFormat.JobHref(relatedJobId)" @key="relatedJobId">
                                      @if (!_relatedJobs.TryGetValue(relatedJobId, out var relatedJob))
                                      {
                                          <td class="job-detail-related__state"><Skeleton Width="72px" /></td>
                                          <td><Skeleton Width="60%" /></td>
                                          @RelatedJobIdCell(relatedJobId)
                                          <td class="job-detail-related__time"><Skeleton Width="96px" /></td>
                                      }
                                      else if (relatedJob is null)
                                      {
                                          <td class="job-detail-related__state"><span class="sd-muted">Not found</span></td>
                                          <td><span class="sd-muted">Retention may have removed this job.</span></td>
                                          @RelatedJobIdCell(relatedJobId)
                                          <td class="job-detail-related__time"></td>
                                      }
                                      else
                                      {
                                          <td class="job-detail-related__state"><StatusBadge State="relatedJob.State" /></td>
                                          <td class="job-detail-related__handler" title="@DashboardFormat.FullHandler(relatedJob)">@DashboardFormat.ShortHandler(relatedJob)</td>
                                          @RelatedJobIdCell(relatedJobId)
                                          <td class="job-detail-related__time">
                                              <TimestampBlock BaseClass="sd-timestamp" Value="relatedJob.EnqueuedAtUtc" AllowFutureRelative="false"
                                                              Prefix="enqueued" Inline AlignEnd />
                                          </td>
                                      }
                                  </tr>
                              }
                          </tbody>
                      </table>
                      @if (section.JobIds.Count > RelatedJobLimit)
                      {
                          <footer class="sd-table__footer">
                              <span class="sd-num">@string.Create(CultureInfo.InvariantCulture, $"Showing {RelatedJobLimit} of {DashboardFormat.Count(section.JobIds.Count)}")</span>
                          </footer>
                      }
                  </ChildContent>
              </Card>
          }
      };

    private static RenderFragment RelatedJobIdCell(Guid relatedJobId)
      => @<td class="job-detail-related__id"><a class="job-detail-id-link" href="@DashboardFormat.JobHref(relatedJobId)" title="@DashboardFormat.JobId(relatedJobId)">@DashboardFormat.ShortJobId(relatedJobId)</a></td>;
}
