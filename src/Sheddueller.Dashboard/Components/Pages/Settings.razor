@page "/settings"
@inherits DashboardPageComponent
@inject IServiceProvider Services
@inject Microsoft.Extensions.Options.IOptions<ShedduellerOptions> ShedduellerOptions
@inject Microsoft.Extensions.Options.IOptions<ShedduellerDashboardOptions> DashboardOptions

<div class="settings-page">
    <header class="settings-header">
        <div>
            <h1>Settings</h1>
            <p>Persisted cluster cleanup controls.</p>
        </div>
    </header>

    @if (_store is null)
    {
        <section class="settings-message" aria-live="polite">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            <div>
                <h2>Persisted settings unavailable</h2>
                <p>The registered Sheddueller provider does not expose dashboard-editable cleanup settings.</p>
            </div>
        </section>
    }
    else if (_loadError is not null)
    {
        <section class="settings-message settings-message--error" aria-live="polite">
            <span class="material-symbols-outlined" aria-hidden="true">error</span>
            <div>
                <h2>Settings failed to load</h2>
                <p>@_loadError</p>
            </div>
        </section>
    }
    else if (_isLoading)
    {
        <section class="settings-message" aria-live="polite">
            <span class="material-symbols-outlined" aria-hidden="true">progress_activity</span>
            <div>
                <h2>Loading settings</h2>
                <p>Reading persisted cleanup settings.</p>
            </div>
        </section>
    }
    else
    {
        @if (_actionMessage is not null)
        {
            <DashboardInlineAlert CssClass="@ActionAlertClass" Icon="@ActionAlertIcon">
                <span>@_actionMessage</span>
            </DashboardInlineAlert>
        }

        <section class="settings-panel">
            <div class="settings-panel__header">
                <h2>Terminal Jobs</h2>
                <label class="settings-switch">
                    <input type="checkbox" @bind="_form.JobRetentionEnabled" disabled="@_isSaving" />
                    <span>Cleanup enabled</span>
                </label>
            </div>

            <div class="settings-grid">
                <label class="settings-field">
                    <span>Completed retention</span>
                    <div class="settings-retention-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.CompletedRetentionHours" disabled="@(_isSaving || _form.CompletedRetainForever)" />
                        <span>hours</span>
                        <label class="settings-inline-check">
                            <input type="checkbox" @bind="_form.CompletedRetainForever" disabled="@_isSaving" />
                            <span>Forever</span>
                        </label>
                    </div>
                </label>
                <label class="settings-field">
                    <span>Failed retention</span>
                    <div class="settings-retention-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.FailedRetentionHours" disabled="@(_isSaving || _form.FailedRetainForever)" />
                        <span>hours</span>
                        <label class="settings-inline-check">
                            <input type="checkbox" @bind="_form.FailedRetainForever" disabled="@_isSaving" />
                            <span>Forever</span>
                        </label>
                    </div>
                </label>
                <label class="settings-field">
                    <span>Canceled retention</span>
                    <div class="settings-retention-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.CanceledRetentionHours" disabled="@(_isSaving || _form.CanceledRetainForever)" />
                        <span>hours</span>
                        <label class="settings-inline-check">
                            <input type="checkbox" @bind="_form.CanceledRetainForever" disabled="@_isSaving" />
                            <span>Forever</span>
                        </label>
                    </div>
                </label>
                <label class="settings-field">
                    <span>Cleanup interval</span>
                    <div class="settings-unit-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.JobRetentionCleanupIntervalMinutes" disabled="@_isSaving" />
                        <span>minutes</span>
                    </div>
                </label>
                <label class="settings-field">
                    <span>Batch size</span>
                    <input class="settings-number-input" type="number" min="1" step="1"
                           @bind="_form.JobRetentionBatchSize" disabled="@_isSaving" />
                </label>
            </div>
        </section>

        <section class="settings-panel">
            <div class="settings-panel__header">
                <h2>Job Events</h2>
            </div>

            <div class="settings-grid">
                <label class="settings-field">
                    <span>Event retention</span>
                    <div class="settings-unit-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.JobEventRetentionHours" disabled="@_isSaving" />
                        <span>hours</span>
                    </div>
                </label>
                <label class="settings-field">
                    <span>Cleanup interval</span>
                    <div class="settings-unit-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.JobEventCleanupIntervalMinutes" disabled="@_isSaving" />
                        <span>minutes</span>
                    </div>
                </label>
            </div>
        </section>

        <section class="settings-panel">
            <div class="settings-panel__header">
                <h2>Metrics</h2>
            </div>

            <div class="settings-grid">
                <label class="settings-field">
                    <span>Metrics retention</span>
                    <div class="settings-unit-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.MetricsRetentionHours" disabled="@_isSaving" />
                        <span>hours</span>
                    </div>
                </label>
                <label class="settings-field">
                    <span>Cleanup interval</span>
                    <div class="settings-unit-row">
                        <input class="settings-number-input" type="number" min="1" step="1"
                               @bind="_form.MetricsCleanupIntervalMinutes" disabled="@_isSaving" />
                        <span>minutes</span>
                    </div>
                </label>
            </div>
        </section>

        <div class="settings-actions">
            <button class="settings-button settings-button--secondary" type="button" @onclick="LoadAsync" disabled="@_isSaving">
                <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
                <span>Reload</span>
            </button>
            <button class="settings-button settings-button--primary" type="button" @onclick="SaveAsync" disabled="@_isSaving">
                <span class="material-symbols-outlined" aria-hidden="true">save</span>
                <span>@SaveButtonText</span>
            </button>
        </div>
    }
</div>

<link href="_content/Sheddueller.Dashboard/styles/pages/settings.css?v=@DashboardAssets.Version" rel="stylesheet" />
