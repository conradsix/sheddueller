@page "/settings"
@inherits DashboardPageComponent
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject Microsoft.Extensions.Options.IOptions<ShedduellerOptions> ShedduellerOptions
@inject Microsoft.Extensions.Options.IOptions<ShedduellerDashboardOptions> DashboardOptions

<div class="@PageClass">
    <PageHeader Title="Settings"
                Description="Cleanup and retention shared by every node, saved in the job store. Preferences apply to this browser only.">
        <Actions>
            @if (_store is not null && _loadError is null)
            {
                <Button Icon="@(_isLoading ? "loader-circle" : "refresh-cw")" Disabled="@(_isLoading || _isSaving)"
                        OnClick="RequestReloadAsync">Reload</Button>
            }
        </Actions>
    </PageHeader>

    @if (_store is null)
    {
        <EmptyState Icon="settings" Title="Cleanup settings can't be edited with this store">
            The registered job store doesn't save cleanup settings, so cleanup uses the values set in code
            (<code>ShedduellerOptions.JobRetention</code> and <code>ShedduellerDashboardOptions.EventRetention</code>).
            To edit them here, register a store that implements <code>IShedduellerCleanupConfigurationStore</code>,
            such as PostgreSQL with <code>UsePostgres</code>.
        </EmptyState>
    }
    else if (_loadError is not null)
    {
        <Alert Tone="AlertTone.Destructive" Title="Settings couldn't be loaded">
            <ChildContent>@_loadError</ChildContent>
            <Actions>
                <Button Size="ButtonSize.Small" Icon="@(_isLoading ? "loader-circle" : "refresh-cw")" Disabled="_isLoading"
                        OnClick="LoadAsync">Try again</Button>
            </Actions>
        </Alert>
    }
    else if (_form is null)
    {
        <Card Title="Cleanup and retention" Description="Loading the saved settings…" Flush="true" aria-busy="true">
            <div class="settings-rows" aria-hidden="true">
                @for (var row = 0; row < SkeletonRowCount; row++)
                {
                    <div class="settings-row">
                        <div class="settings-row__text">
                            <Skeleton Width="@(row % 2 == 0 ? "34%" : "26%")" />
                            <Skeleton Width="@(row % 2 == 0 ? "62%" : "70%")" Height="12px" />
                        </div>
                        <div class="settings-row__control">
                            <Skeleton Width="216px" Height="32px" />
                        </div>
                    </div>
                }
            </div>
        </Card>
    }
    else
    {
        <Card Title="Terminal jobs" Flush="true"
              Description="Completed, failed, and canceled jobs are deleted from the job store once they're older than their retention.">
            <HeaderActions>
                <Switch Value="_form.JobRetentionEnabled" ValueChanged="SetJobRetentionEnabled" Disabled="_isSaving">Delete old jobs</Switch>
            </HeaderActions>
            <ChildContent>
                @if (!_form.JobRetentionEnabled)
                {
                    <p class="settings-card__note">
                        <Icon Name="info" />
                        <span>Job cleanup is off, so finished jobs are kept. The values below are saved but not used until it's turned back on.</span>
                    </p>
                }
                <div class="settings-rows">
                    @DurationRow(DashboardCleanupSetting.CompletedRetention, "Keep completed jobs for",
                                 "Completed jobs older than this are deleted.", "Completed jobs are never deleted.")
                    @DurationRow(DashboardCleanupSetting.FailedRetention, "Keep failed jobs for",
                                 "Failed jobs older than this are deleted.", "Failed jobs are never deleted.")
                    @DurationRow(DashboardCleanupSetting.CanceledRetention, "Keep canceled jobs for",
                                 "Canceled jobs older than this are deleted.", "Canceled jobs are never deleted.")
                    @DurationRow(DashboardCleanupSetting.JobCleanupInterval, "Run cleanup every",
                                 "How often cleanup looks for jobs to delete.")
                    @BatchSizeRow()
                </div>
            </ChildContent>
        </Card>

        <Card Title="Job events" Flush="true"
              Description="Lifecycle events, logs, and progress updates shown on each job's page.">
            <div class="settings-rows">
                @DurationRow(DashboardCleanupSetting.EventRetention, "Keep events for",
                             "Events are deleted once their job has been finished for longer than this.")
                @DurationRow(DashboardCleanupSetting.EventCleanupInterval, "Run cleanup every",
                             "How often cleanup looks for events to delete.")
            </div>
        </Card>

        <Card Title="Metrics" Flush="true" Description="Throughput and timing samples behind the Metrics page.">
            <div class="settings-rows">
                @DurationRow(DashboardCleanupSetting.MetricsRetention, "Keep metrics for",
                             "Samples older than this are deleted.")
                @DurationRow(DashboardCleanupSetting.MetricsCleanupInterval, "Run cleanup every",
                             "How often cleanup looks for samples to delete.")
            </div>
        </Card>
    }

    <Card Title="Preferences" Flush="true" Description="Saved in this browser only. They don't change anything for other people.">
        <div class="settings-rows">
            <div class="sd-field settings-row">
                <div class="settings-row__text">
                    <span class="settings-row__label" id="settings-theme-label">Theme</span>
                    <p class="sd-field__hint">System follows your device's light or dark setting.</p>
                </div>
                <div class="settings-row__control">
                    <div class="sd-tabs sd-tabs--sm settings-theme" role="radiogroup" aria-labelledby="settings-theme-label">
                        @foreach (var (theme, label, icon) in ThemeOptions)
                        {
                            <button type="button" class="sd-tabs__tab" role="radio" data-sd-theme="@theme"
                                    aria-checked="@ThemeChecked(theme)" @onclick="() => SelectTheme(theme)" @key="theme">
                                <Icon Name="@icon" />
                                @label
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </Card>
</div>

@if (IsDirty)
{
    <div class="sd-bulkbar settings-savebar" role="region" aria-label="Unsaved changes">
        <span class="sd-bulkbar__count" aria-live="polite">@SaveBarText</span>
        <span class="sd-bulkbar__divider" aria-hidden="true"></span>
        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Disabled="_isSaving" OnClick="OpenDiscardDialog">Discard</Button>
        <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Small" Icon="@(_isSaving ? "loader-circle" : "save")"
                Disabled="@(_isSaving || InvalidCount > 0)" OnClick="SaveAsync">Save changes</Button>
    </div>
}

<ConfirmDialog @bind-Open="_discardDialogOpen" Title="Discard unsaved changes?" ConfirmLabel="Discard changes"
               CancelLabel="Keep editing" Destructive="true" OnConfirm="DiscardChanges">
    <p>The settings go back to the values that were loaded. Nothing is saved.</p>
</ConfirmDialog>

<ConfirmDialog @bind-Open="_reloadDialogOpen" Title="Discard changes and reload?" ConfirmLabel="Discard and reload"
               CancelLabel="Keep editing" Destructive="true" OnConfirm="LoadAsync">
    <p>Reloading reads the saved settings again, and your unsaved changes are lost.</p>
</ConfirmDialog>

<ConfirmDialog @bind-Open="_leaveDialogOpen" Title="Leave without saving?" ConfirmLabel="Leave page" CancelLabel="Stay"
               Destructive="true" OnConfirm="ConfirmLeave">
    <p>Your changes to the cleanup settings haven't been saved and will be lost.</p>
</ConfirmDialog>

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@code {
    private const int SkeletonRowCount = 5;
    private const string SettingsPath = "settings";

    private static readonly (string Theme, string Label, string Icon)[] ThemeOptions =
    [
        ("system", "System", "monitor"),
        ("light", "Light", "sun"),
        ("dark", "Dark", "moon"),
    ];

    private readonly HashSet<DashboardCleanupSetting> _touched = [];
    private IShedduellerCleanupConfigurationStore? _store;
    private ShedduellerCleanupConfiguration? _loaded;
    private DashboardCleanupSettingsForm? _baseline;
    private DashboardCleanupSettingsForm? _form;
    private string? _loadError;
    private string? _pendingNavigation;
    private bool _isLoading;
    private bool _isSaving;
    private bool _showAllErrors;
    private bool _leaveConfirmed;
    private bool _discardDialogOpen;
    private bool _reloadDialogOpen;
    private bool _leaveDialogOpen;

    // sheddueller-ui.js applies and stores the theme (data-sd-theme); the page mirrors it only for aria-checked.
    private string? _theme;

    private bool IsDirty
      => this._form is not null && this._baseline is not null && this._form.HasChangesFrom(this._baseline);

    private int InvalidCount
      => this._form?.InvalidSettings.Count ?? 0;

    private string PageClass
      => this.IsDirty ? "sd-page settings-page settings-page--dirty" : "sd-page settings-page";

    private string SaveBarText
      => this.InvalidCount switch
      {
          0 => "You have unsaved changes",
          1 => "1 setting needs fixing",
          var count => string.Create(CultureInfo.InvariantCulture, $"{count} settings need fixing"),
      };

    protected override async Task OnInitializedAsync()
    {
        this._store = Services.GetService<IShedduellerCleanupConfigurationStore>();
        if (this._store is not null)
        {
            await this.LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await this.ReadThemeAsync();
        }

        await this.FlushToastsAsync();
    }

    private async Task LoadAsync()
    {
        if (this._store is null)
        {
            return;
        }

        this._isLoading = true;

        try
        {
            var configuration = await this._store.GetCleanupConfigurationAsync(this.CreateDefaultConfiguration());
            this.SetLoaded(configuration);
            this._form = DashboardCleanupSettingsForm.FromConfiguration(configuration);
            this._loadError = null;
        }
        catch (Exception exception)
        {
            if (this._form is null)
            {
                this._loadError = exception.Message;
            }
            else
            {
                this.ShowToast("Couldn't reload settings", exception.Message, AlertTone.Destructive);
            }
        }
        finally
        {
            this._isLoading = false;
        }
    }

    private async Task RequestReloadAsync()
    {
        if (this.IsDirty)
        {
            this._reloadDialogOpen = true;
            return;
        }

        await this.LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (this._store is null || this._form is null || this._isSaving)
        {
            return;
        }

        if (!this._form.TryCreateConfiguration(out var configuration))
        {
            this._showAllErrors = true;
            this.ShowToast("Some settings need fixing", "Fix the highlighted fields, then save again.", AlertTone.Destructive);
            return;
        }

        this._isSaving = true;

        try
        {
            await this._store.SetCleanupConfigurationAsync(configuration);

            // Keep the values as typed (1.5 hours stays 1.5 hours); the baseline is what the store now holds.
            this.SetLoaded(configuration);
            this.ShowToast("Settings saved", "Cleanup uses the new values on its next run.", AlertTone.Success);
        }
        catch (Exception exception)
        {
            this.ShowToast("Couldn't save settings", exception.Message, AlertTone.Destructive);
        }
        finally
        {
            this._isSaving = false;
        }
    }

    private void OpenDiscardDialog()
      => this._discardDialogOpen = true;

    private void DiscardChanges()
    {
        if (this._loaded is not null)
        {
            this._form = DashboardCleanupSettingsForm.FromConfiguration(this._loaded);
            this.ResetValidation();
        }
    }

    private void SetLoaded(ShedduellerCleanupConfiguration configuration)
    {
        this._loaded = configuration;
        this._baseline = DashboardCleanupSettingsForm.FromConfiguration(configuration);
        this.ResetValidation();
    }

    private void OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (this._leaveConfirmed
            || !this.IsDirty
            || DashboardQueryString.IsPath(Navigation.ToBaseRelativePath(Navigation.ToAbsoluteUri(context.TargetLocation).AbsoluteUri), SettingsPath))
        {
            return;
        }

        context.PreventNavigation();
        this._pendingNavigation = context.TargetLocation;
        this._leaveDialogOpen = true;
    }

    private void ConfirmLeave()
    {
        if (this._pendingNavigation is { } target)
        {
            this._leaveConfirmed = true;
            Navigation.NavigateTo(target);
        }
    }

    private void SetJobRetentionEnabled(bool enabled)
    {
        if (this._form is not null)
        {
            this._form.JobRetentionEnabled = enabled;
        }
    }

    private void SetAmount(DashboardCleanupSetting setting, ChangeEventArgs args)
    {
        if (this._form is not null)
        {
            this._form.SetDuration(setting, this._form.Duration(setting) with { Amount = args.Value as string ?? string.Empty });
        }
    }

    private void SetUnit(DashboardCleanupSetting setting, ChangeEventArgs args)
    {
        if (this._form is not null && Enum.TryParse<DashboardDurationUnit>(args.Value as string, out var unit))
        {
            this._form.SetDuration(setting, this._form.Duration(setting) with { Unit = unit });
            this._touched.Add(setting);
        }
    }

    private void SetKeptForever(DashboardCleanupSetting setting, ChangeEventArgs args)
    {
        if (this._form is not null)
        {
            this._form.SetKeptForever(setting, args.Value is true);
            this._touched.Add(setting);
        }
    }

    private void SetBatchSize(ChangeEventArgs args)
    {
        if (this._form is not null)
        {
            this._form.BatchSize = args.Value as string ?? string.Empty;
        }
    }

    // Errors show once a field is committed (blur or Enter) or a save is attempted, then update as you type.
    private void Touch(DashboardCleanupSetting setting)
      => this._touched.Add(setting);

    private void ResetValidation()
    {
        this._touched.Clear();
        this._showAllErrors = false;
    }

    private string? VisibleError(DashboardCleanupSetting setting)
      => this._form is not null && (this._showAllErrors || this._touched.Contains(setting))
        ? this._form.Error(setting)
        : null;

    private static string InputId(DashboardCleanupSetting setting)
      => string.Concat("settings-", setting.ToString());

    private static string DescribedBy(DashboardCleanupSetting setting, string? error)
      => error is null
        ? string.Concat(InputId(setting), "-hint")
        : string.Concat(InputId(setting), "-hint ", InputId(setting), "-error");

    private RenderFragment DurationRow(
        DashboardCleanupSetting setting,
        string label,
        string hint,
        string? foreverHint = null)
    {
        var form = this._form!;
        var duration = form.Duration(setting);
        var canKeepForever = DashboardCleanupSettingsForm.CanKeepForever(setting);
        var keptForever = form.IsKeptForever(setting);
        var error = this.VisibleError(setting);
        var id = InputId(setting);

        return @<div class="sd-field settings-row" @key="setting">
            <div class="settings-row__text">
                <label class="settings-row__label" for="@id">@label</label>
                <p class="sd-field__hint" id="@($"{id}-hint")">@(keptForever ? foreverHint : hint)</p>
            </div>
            <div class="settings-row__control">
                <div class="settings-duration">
                    <input id="@id" class="sd-input settings-duration__amount" type="text" inputmode="decimal" autocomplete="off"
                           spellcheck="false" value="@duration.Amount" disabled="@(keptForever || _isSaving)"
                           aria-invalid="@(error is null ? null : "true")" aria-describedby="@DescribedBy(setting, error)"
                           @oninput="args => SetAmount(setting, args)" @onchange="() => Touch(setting)" />
                    <span class="sd-select settings-duration__unit">
                        <select aria-label="@($"{label}, unit")" value="@duration.Unit.ToString()" disabled="@(keptForever || _isSaving)"
                                @onchange="args => SetUnit(setting, args)">
                            @foreach (var unit in DashboardDurationInput.Units)
                            {
                                <option value="@unit.ToString()">@DashboardDurationInput.UnitLabel(unit, duration.IsSingular)</option>
                            }
                        </select>
                        <Icon Name="chevron-down" />
                    </span>
                </div>
                @if (canKeepForever)
                {
                    <label class="sd-switch-label settings-forever">
                        <input type="checkbox" class="sd-checkbox" checked="@keptForever" disabled="@_isSaving"
                               @onchange="args => SetKeptForever(setting, args)" />
                        Keep forever
                    </label>
                }
                @if (error is not null)
                {
                    <p class="sd-field__error" id="@($"{id}-error")">@error</p>
                }
            </div>
        </div>;
    }

    private RenderFragment BatchSizeRow()
    {
        var form = this._form!;
        var setting = DashboardCleanupSetting.JobBatchSize;
        var error = this.VisibleError(setting);
        var id = InputId(setting);

        return @<div class="sd-field settings-row" @key="setting">
            <div class="settings-row__text">
                <label class="settings-row__label" for="@id">Batch size</label>
                <p class="sd-field__hint" id="@($"{id}-hint")">Most jobs deleted in one transaction. Smaller batches hold locks for less time.</p>
            </div>
            <div class="settings-row__control">
                <div class="settings-duration">
                    <input id="@id" class="sd-input settings-duration__amount" type="text" inputmode="numeric" autocomplete="off"
                           spellcheck="false" value="@form.BatchSize" disabled="@_isSaving"
                           aria-invalid="@(error is null ? null : "true")" aria-describedby="@DescribedBy(setting, error)"
                           @oninput="SetBatchSize" @onchange="() => Touch(setting)" />
                    <span class="settings-unit">jobs</span>
                </div>
                @if (error is not null)
                {
                    <p class="sd-field__error" id="@($"{id}-error")">@error</p>
                }
            </div>
        </div>;
    }

    private async Task ReadThemeAsync()
    {
        try
        {
            var theme = await JsRuntime.InvokeAsync<string?>("sheddueller.theme");
            this._theme = theme is "light" or "dark" ? theme : "system";
            this.StateHasChanged();
        }
        catch (JSException)
        {
        }
    }

    private void SelectTheme(string theme)
      => this._theme = theme;

    private string? ThemeChecked(string theme)
      => this._theme is null ? null : string.Equals(this._theme, theme, StringComparison.Ordinal) ? "true" : "false";

    private ShedduellerCleanupConfiguration CreateDefaultConfiguration()
      => new(
        JobRetentionCleanupConfiguration.FromOptions(ShedduellerOptions.Value.JobRetention),
        new JobEventCleanupConfiguration(DashboardOptions.Value.EventRetention, JobEventCleanupConfiguration.DefaultCleanupInterval),
        MetricsCleanupConfiguration.Default);
}
