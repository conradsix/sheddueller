@page "/schedules"
@inherits DashboardPageComponent
@inject IScheduleInspectionReader Reader
@inject IRecurringScheduleManager ScheduleManager

<div class="sd-page schedules-page">
    <PageHeader Title="Schedules"
                Description="Recurring jobs your app registers. Cron expressions run in UTC. Run, pause, or resume a schedule from its row menu." />

    <div class="sd-toolbar schedules-toolbar">
        <SearchInput Class="schedules-search" Value="@_filters.ScheduleKey" ValueChanged="SetScheduleKeyFilter"
                     Placeholder="Filter by schedule key" Label="Filter schedules by key" Shortcut="true" />
        <Tabs TValue="string" Items="StateTabs" Value="_filters.PauseState" ValueChanged="SetPauseStateFilterAsync"
              Label="Filter schedules by state" />
        @if (_filters.HasAppliedFilters)
        {
            <Button Variant="ButtonVariant.Ghost" Icon="x" OnClick="ClearFiltersAsync">Reset</Button>
        }
    </div>

    @if (_loadError is not null)
    {
        <Alert Tone="AlertTone.Destructive" Title="Schedules couldn't be loaded">
            <ChildContent>@_loadError</ChildContent>
            <Actions>
                <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="LoadAsync">Try again</Button>
            </Actions>
        </Alert>
    }

    @if (_page is not null || _loadError is null)
    {
        <Card Flush="true" Class="@TableCardClass">
            <div class="schedules-table-wrap">
                <table class="sd-table schedules-table" aria-busy="@(_isLoading ? "true" : "false")">
                    <thead>
                        <tr>
                            <th scope="col">Schedule</th>
                            <th scope="col">Handler</th>
                            <th scope="col" class="schedules-table__cron">Cron (UTC)</th>
                            <th scope="col">Next run</th>
                            <th scope="col">State</th>
                            <th scope="col" class="schedules-table__tags">Tags</th>
                            <th scope="col" class="schedules-table__actions"><span class="sd-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_page is null)
                        {
                            @for (var row = 0; row < SkeletonRowCount; row++)
                            {
                                <tr class="schedules-table__skeleton" aria-hidden="true">
                                    @for (var column = 0; column < ColumnCount - 1; column++)
                                    {
                                        <td class="@SkeletonColumnClasses[column]"><Skeleton Width="@SkeletonWidth(row, column)" /></td>
                                    }
                                    <td class="schedules-table__actions"></td>
                                </tr>
                            }
                        }
                        else if (_schedules.Count == 0)
                        {
                            <tr class="schedules-table__empty">
                                <td colspan="@ColumnCount">
                                    <EmptyState Flat="true" Icon="@(_filters.HasAppliedFilters ? "search" : "calendar-clock")" Title="@EmptyTitle">
                                        <ChildContent>@EmptyText</ChildContent>
                                        <Actions>
                                            @if (_filters.HasAppliedFilters)
                                            {
                                                <Button OnClick="ClearFiltersAsync">Reset filters</Button>
                                            }
                                        </Actions>
                                    </EmptyState>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var schedule in _schedules)
                            {
                                var busy = IsBusy(schedule.ScheduleKey);
                                var details = ExecutionDetails(schedule);
                                <tr @key="schedule.ScheduleKey">
                                    <td class="schedules-table__key">
                                        <span class="schedules-key" title="@schedule.ScheduleKey">@schedule.ScheduleKey</span>
                                    </td>
                                    <td>
                                        <span class="schedules-handler" title="@FullHandler(schedule)">@ShortHandler(schedule)</span>
                                        @if (details is not null)
                                        {
                                            <span class="schedules-secondary" title="@details">@details</span>
                                        }
                                    </td>
                                    <td class="schedules-table__cron">
                                        <span class="schedules-cron" title="Cron expression, evaluated in UTC">@schedule.CronExpression</span>
                                    </td>
                                    <td>
                                        <TimestampBlock BaseClass="sd-timestamp" Value="schedule.NextFireAtUtc"
                                                        EmptyText="@NextRunEmptyText(schedule)" />
                                    </td>
                                    <td>
                                        @if (schedule.IsPaused)
                                        {
                                            <Badge Class="sd-status schedules-state schedules-state--paused" title="No jobs are enqueued until it is resumed">
                                                <Icon Name="pause" Class="schedules-state__icon" />Paused
                                            </Badge>
                                        }
                                        else
                                        {
                                            <Badge Class="sd-status schedules-state schedules-state--active" title="Enqueues a job at each cron time">
                                                <span class="sd-status__dot" aria-hidden="true"></span>Active
                                            </Badge>
                                        }
                                    </td>
                                    <td class="schedules-table__tags">
                                        <TagList Values="@DashboardFormat.Tags(schedule.Tags)" Title="@DashboardFormat.TagsTitle(schedule.Tags)"
                                                 HrefFactory="DashboardJobFilterQuery.TagHref" TooltipPrefix="Show jobs tagged" />
                                    </td>
                                    <td class="schedules-table__actions">
                                        <DropdownMenu Label="@($"Actions for {schedule.ScheduleKey}")" Icon="@(busy ? "loader-circle" : "ellipsis")"
                                                      Size="ButtonSize.Small" Disabled="busy">
                                            <MenuItem Icon="play" OnClick="() => OpenConfirmDialog(ScheduleAction.Trigger, schedule)">Trigger now…</MenuItem>
                                            @if (schedule.IsPaused)
                                            {
                                                <MenuItem Icon="circle-play" OnClick="() => ResumeAsync(schedule)">Resume</MenuItem>
                                            }
                                            else
                                            {
                                                <MenuItem Icon="pause" OnClick="() => OpenConfirmDialog(ScheduleAction.Pause, schedule)">Pause…</MenuItem>
                                            }
                                            <MenuSeparator />
                                            <MenuItem Icon="list-filter" Href="@HandlerJobsHref(schedule)">Jobs with this handler</MenuItem>
                                            <MenuItem Icon="copy" data-sd-copy="@schedule.ScheduleKey" data-sd-copy-label="schedule key">Copy schedule key</MenuItem>
                                        </DropdownMenu>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <footer class="sd-table__footer">
                <span class="sd-num">@FooterText</span>
                <span class="schedules-footer-actions">
                    @if (_loadMoreError is not null)
                    {
                        <span class="sd-field__error" role="alert">Couldn't load more: @_loadMoreError</span>
                    }
                    @if (_page?.ContinuationToken is not null)
                    {
                        <Button Size="ButtonSize.Small" Icon="@(_isLoadingMore ? "loader-circle" : null)"
                                Disabled="@(_isLoading || _isLoadingMore)" OnClick="LoadMoreAsync">Load more</Button>
                    }
                </span>
            </footer>
        </Card>
    }
</div>

<ConfirmDialog @bind-Open="_confirmDialogOpen" Title="@ConfirmTitle" ConfirmLabel="@ConfirmLabel"
               Busy="@(_confirmSchedule is not null && IsBusy(_confirmSchedule.ScheduleKey))" OnConfirm="ConfirmScheduleActionAsync">
    @foreach (var paragraph in ConfirmParagraphs)
    {
        <p>@paragraph</p>
    }
</ConfirmDialog>

@code {
    private static readonly TimeSpan PageRefreshInterval = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan FilterDebounce = TimeSpan.FromMilliseconds(300);
    private const int DefaultPageSize = 25;
    private const int SkeletonRowCount = 5;
    private const int ColumnCount = 7;
    // Matches the data columns, so skeleton cells hide with their column on narrow screens.
    private static readonly string?[] SkeletonColumnClasses = [null, null, "schedules-table__cron", null, null, "schedules-table__tags"];
    internal const string ScheduleNotFoundActionFailureMessage = "Schedule action failed: Schedule was not found.";

    private static readonly IReadOnlyList<TabItem<string>> StateTabs =
    [
        new(string.Empty, "All"),
        new(DashboardScheduleFilters.ActiveStateFilter, "Active"),
        new(DashboardScheduleFilters.PausedStateFilter, "Paused"),
    ];

    private readonly DashboardScheduleFilters _filters = new();
    private readonly List<ScheduleInspectionSummary> _schedules = [];
    private readonly HashSet<string> _busyKeys = new(StringComparer.Ordinal);
    private ScheduleInspectionPage? _page;
    private CancellationTokenSource? _filterDebounceCts;
    private ScheduleInspectionSummary? _confirmSchedule;
    private ScheduleAction _confirmAction;
    private string? _loadError;
    private string? _loadMoreError;
    private int _queryVersion;
    private bool _isLoading;
    private bool _isLoadingMore;
    private bool _confirmDialogOpen;

    private enum ScheduleAction
    {
        Trigger,
        Pause,
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private string TableCardClass
      => this._isLoading && this._page is not null
        ? "sd-table-card schedules-table-card sd-table-card--loading"
        : "sd-table-card schedules-table-card";

    private string EmptyTitle
      => this._filters.HasAppliedFilters ? "No schedules match" : "No recurring schedules yet";

    private string EmptyText
      => this._filters.HasAppliedFilters
        ? "Nothing matches the key and state filters. Try a shorter part of the key, or reset the filters."
        : "Schedules appear here once your app registers them with IRecurringScheduleManager.";

    private string FooterText
    {
        get
        {
            var total = this._page?.TotalCount ?? this._schedules.Count;
            return string.Concat(
              "Showing ",
              DashboardFormat.Count(this._schedules.Count),
              " of ",
              DashboardFormat.Count(total),
              total == 1 ? " schedule" : " schedules");
        }
    }

    private string ConfirmTitle
      => this._confirmSchedule is not { } schedule
        ? string.Empty
        : this._confirmAction == ScheduleAction.Trigger
          ? string.Concat("Run ", schedule.ScheduleKey, " now?")
          : string.Concat("Pause ", schedule.ScheduleKey, "?");

    private string ConfirmLabel
      => this._confirmAction == ScheduleAction.Trigger ? "Run now" : "Pause schedule";

    private IReadOnlyList<string> ConfirmParagraphs
    {
        get
        {
            if (this._confirmSchedule is not { } schedule)
            {
                return [];
            }

            if (this._confirmAction == ScheduleAction.Pause)
            {
                return
                [
                    "No new jobs are enqueued from this schedule until you resume it. Jobs that are already queued or running aren't affected.",
                ];
            }

            var paragraphs = new List<string>(2)
            {
                schedule.IsPaused
                  ? "Enqueues one job from this schedule straight away. The schedule stays paused."
                  : "Enqueues one job from this schedule straight away. Its regular cron times don't change.",
            };
            if (schedule.OverlapMode == RecurringOverlapMode.Skip)
            {
                paragraphs.Add("If an earlier run is still queued or running, nothing is enqueued.");
            }

            return paragraphs;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _ = this._filters.CopyFrom(DashboardScheduleFilterQuery.ParseUri(this.Navigation.Uri));
        this.TrackLocation(this.Navigation, DashboardScheduleFilterQuery.Path, this.ApplyLocationAsync);
        this.InitializeLiveRefresh(
          this.RefreshCurrentQueryAsync,
          showRefreshing: false,
          lastUpdatedUtc: nowUtc => this.LiveRefresh.LastUpdatedUtc ?? (this._page is null ? null : nowUtc));

        await this.LoadAsync();
        this.StartPeriodicRefresh(PageRefreshInterval);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
      => this.FlushToastsAsync();

    private protected override ValueTask DisposePageAsync()
    {
        this.CancelPendingFilterLoad();
        return ValueTask.CompletedTask;
    }

    // Typing filters after a short pause and replaces the current history entry rather than pushing one per burst.
    private void SetScheduleKeyFilter(string value)
    {
        if (string.Equals(this._filters.ScheduleKey, value, StringComparison.Ordinal))
        {
            return;
        }

        this._filters.ScheduleKey = value;
        this.ScheduleDebouncedLoad();
    }

    private async Task SetPauseStateFilterAsync(string value)
    {
        if (string.Equals(this._filters.PauseState, value, StringComparison.Ordinal))
        {
            return;
        }

        this._filters.PauseState = value;
        await this.ApplyDiscreteFilterChangeAsync();
    }

    private async Task ClearFiltersAsync()
    {
        if (!this._filters.HasAppliedFilters)
        {
            return;
        }

        _ = this._filters.CopyFrom(new DashboardScheduleFilters());
        await this.ApplyDiscreteFilterChangeAsync();
    }

    // Discrete changes push a history entry so Back steps through them.
    private async Task ApplyDiscreteFilterChangeAsync()
    {
        this.CancelPendingFilterLoad();
        this.NavigateToLocation(DashboardScheduleFilterQuery.ToHref(this._filters), replace: false);
        await this.LoadAsync();
    }

    private async Task ApplyLocationAsync(string location)
    {
        if (!this._filters.CopyFrom(DashboardScheduleFilterQuery.ParseUri(location)))
        {
            return;
        }

        this.CancelPendingFilterLoad();
        await this.LoadAsync();
    }

    private void ScheduleDebouncedLoad()
    {
        this._filterDebounceCts?.Cancel();

        var next = new CancellationTokenSource();
        this._filterDebounceCts = next;
        _ = this.RunDebouncedLoadAsync(next);
    }

    private async Task RunDebouncedLoadAsync(CancellationTokenSource cancellationTokenSource)
    {
        try
        {
            await Task.Delay(FilterDebounce, cancellationTokenSource.Token);
            await this.InvokeAsync(async () =>
            {
                this.NavigateToLocation(DashboardScheduleFilterQuery.ToHref(this._filters), replace: true);
                var load = this.LoadAsync();
                this.StateHasChanged();
                await load;
                this.StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(this._filterDebounceCts, cancellationTokenSource))
            {
                this._filterDebounceCts = null;
            }

            cancellationTokenSource.Dispose();
        }
    }

    private void CancelPendingFilterLoad()
    {
        var cancellationTokenSource = this._filterDebounceCts;
        this._filterDebounceCts = null;
        cancellationTokenSource?.Cancel();
    }

    private async Task LoadAsync()
    {
        var queryVersion = ++this._queryVersion;
        this._loadError = null;
        this._loadMoreError = null;
        this.LiveRefresh.ClearError();
        this._isLoading = true;

        try
        {
            var page = await Reader.SearchSchedulesAsync(this.CreateQuery(DefaultPageSize, continuationToken: null));
            if (queryVersion != this._queryVersion)
            {
                return;
            }

            this.ReplaceSchedules(page);
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            if (queryVersion == this._queryVersion)
            {
                this._loadError = exception.Message;
            }
        }
        finally
        {
            if (queryVersion == this._queryVersion)
            {
                this._isLoading = false;
                this.NotifyShellRefreshChanged();
            }
        }
    }

    private async Task LoadMoreAsync()
    {
        if (this._page?.ContinuationToken is null || this._isLoading || this._isLoadingMore)
        {
            return;
        }

        var queryVersion = this._queryVersion;
        this._loadMoreError = null;
        this._isLoadingMore = true;

        try
        {
            var page = await Reader.SearchSchedulesAsync(this.CreateQuery(DefaultPageSize, this._page.ContinuationToken));
            if (queryVersion != this._queryVersion)
            {
                return;
            }

            this._schedules.AddRange(page.Schedules);
            this._page = page;
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            // Keep the loaded rows; the failure is shown next to the Load more control.
            if (queryVersion == this._queryVersion)
            {
                this._loadMoreError = exception.Message;
            }
        }
        finally
        {
            this._isLoadingMore = false;
            this.NotifyShellRefreshChanged();
        }
    }

    private async Task RefreshCurrentQueryAsync(CancellationToken cancellationToken)
    {
        var queryVersion = this._queryVersion;
        var visiblePageSize = Math.Max(DefaultPageSize, this._schedules.Count);
        var page = await Reader.SearchSchedulesAsync(this.CreateQuery(visiblePageSize, continuationToken: null), cancellationToken);

        await this.ApplyPageStateAsync(() =>
        {
            if (queryVersion == this._queryVersion)
            {
                this.ReplaceSchedules(page);
            }
        });
    }

    private ScheduleInspectionQuery CreateQuery(
        int pageSize,
        string? continuationToken)
      => this._filters.ToQuery(pageSize, continuationToken);

    private void ReplaceSchedules(ScheduleInspectionPage page)
    {
        this._schedules.Clear();
        this._schedules.AddRange(page.Schedules);
        this._page = page;
        this._loadError = null;
        this._loadMoreError = null;
    }

    private bool IsBusy(string scheduleKey)
      => this._busyKeys.Contains(scheduleKey);

    private void OpenConfirmDialog(ScheduleAction action, ScheduleInspectionSummary schedule)
    {
        this._confirmAction = action;
        this._confirmSchedule = schedule;
        this._confirmDialogOpen = true;
    }

    private Task ConfirmScheduleActionAsync()
      => this._confirmSchedule is not { } schedule
        ? Task.CompletedTask
        : this._confirmAction == ScheduleAction.Trigger
          ? this.TriggerNowAsync(schedule)
          : this.PauseOrResumeAsync(schedule, pause: true);

    private Task ResumeAsync(ScheduleInspectionSummary schedule)
      => this.PauseOrResumeAsync(schedule, pause: false);

    private async Task PauseOrResumeAsync(ScheduleInspectionSummary schedule, bool pause)
    {
        var scheduleKey = schedule.ScheduleKey;
        if (!this._busyKeys.Add(scheduleKey))
        {
            return;
        }

        // The row stays busy until the list has refreshed, so it never shows the old state as actionable.
        try
        {
            var succeeded = pause
              ? await ScheduleManager.PauseAsync(scheduleKey)
              : await ScheduleManager.ResumeAsync(scheduleKey);

            if (succeeded)
            {
                this.ShowToast(string.Concat("Schedule ", scheduleKey, pause ? " paused." : " resumed."), tone: AlertTone.Success);
            }
            else
            {
                this.ShowToast(ScheduleNotFoundActionFailureMessage, "It may have been removed. The list has been refreshed.", AlertTone.Destructive);
            }

            await this.LiveRefresh.RefreshNowAsync();
        }
        catch (Exception exception)
        {
            this.ShowToast(string.Concat(pause ? "Couldn't pause " : "Couldn't resume ", scheduleKey), exception.Message, AlertTone.Destructive);
        }
        finally
        {
            _ = this._busyKeys.Remove(scheduleKey);
        }
    }

    private async Task TriggerNowAsync(ScheduleInspectionSummary schedule)
    {
        var scheduleKey = schedule.ScheduleKey;
        if (!this._busyKeys.Add(scheduleKey))
        {
            return;
        }

        try
        {
            var result = await ScheduleManager.TriggerAsync(scheduleKey);
            var refresh = true;
            switch (result.Status)
            {
                case RecurringScheduleTriggerStatus.Enqueued:
                    this.ShowToast(CreateTriggerSuccessMessage(scheduleKey), result.JobId?.ToString("D"), AlertTone.Success);
                    break;
                case RecurringScheduleTriggerStatus.SkippedActiveOccurrence:
                    this.ShowToast(
                      CreateTriggerSkippedMessage(scheduleKey),
                      "It skips overlapping runs, so nothing was enqueued.",
                      AlertTone.Warning);
                    refresh = false;
                    break;
                case RecurringScheduleTriggerStatus.NotFound:
                    this.ShowToast(ScheduleNotFoundActionFailureMessage, "It may have been removed. The list has been refreshed.", AlertTone.Destructive);
                    break;
                default:
                    this.ShowToast(
                      string.Concat("Couldn't trigger ", scheduleKey),
                      string.Create(CultureInfo.InvariantCulture, $"The trigger returned an unsupported status, {result.Status}."),
                      AlertTone.Destructive);
                    refresh = false;
                    break;
            }

            if (refresh)
            {
                await this.LiveRefresh.RefreshNowAsync();
            }
        }
        catch (Exception exception)
        {
            this.ShowToast(string.Concat("Couldn't trigger ", scheduleKey), exception.Message, AlertTone.Destructive);
        }
        finally
        {
            _ = this._busyKeys.Remove(scheduleKey);
        }
    }

    private static string FullHandler(ScheduleInspectionSummary schedule)
      => string.Concat(schedule.ServiceType, ".", schedule.MethodName);

    public static string ShortHandler(ScheduleInspectionSummary job)
        => string.Concat(DashboardFormat.ShortTypeName(job.ServiceType), ".", job.MethodName);

    // Concurrency groups and any non-default priority or overlap mode, shown under the handler.
    private static string? ExecutionDetails(ScheduleInspectionSummary schedule)
    {
        var details = new List<string>(3);
        if (schedule.ConcurrencyGroupKeys.Count > 0)
        {
            details.Add(string.Concat(
              schedule.ConcurrencyGroupKeys.Count == 1 ? "Group " : "Groups ",
              string.Join(", ", schedule.ConcurrencyGroupKeys)));
        }

        if (schedule.Priority != 0)
        {
            details.Add(string.Create(CultureInfo.InvariantCulture, $"Priority {schedule.Priority}"));
        }

        if (schedule.OverlapMode == RecurringOverlapMode.Allow)
        {
            details.Add("Overlap allowed");
        }

        return details.Count == 0 ? null : string.Join(" · ", details);
    }

    private static string NextRunEmptyText(ScheduleInspectionSummary schedule)
      => schedule.IsPaused ? "—" : "Not scheduled";

    private static string HandlerJobsHref(ScheduleInspectionSummary schedule)
      => DashboardJobFilterQuery.HandlerHref(ShortHandler(schedule));

    internal static string CreateTriggerSuccessMessage(string scheduleKey)
      => string.Create(CultureInfo.InvariantCulture, $"Schedule {scheduleKey} triggered as job");

    internal static string CreateTriggerSkippedMessage(string scheduleKey)
      => string.Create(CultureInfo.InvariantCulture, $"Schedule {scheduleKey} already has an active occurrence.");

    private static string SkeletonWidth(int row, int column)
      => string.Create(CultureInfo.InvariantCulture, $"{45 + (((row * 7) + (column * 13)) % 45)}%");
}
