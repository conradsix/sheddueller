@page "/concurrency-groups"
@inherits DashboardPageComponent
@inject IConcurrencyGroupInspectionReader Reader
@inject IServiceProvider Services

<div class="sd-page groups-page">
    <PageHeader Title="Concurrency groups"
                Description="How many jobs each group runs at once and how fast new ones start. Limits apply across every worker." />

    <div class="sd-toolbar groups-toolbar">
        <SearchInput Class="groups-search" Value="@_filters.GroupKey" ValueChanged="SetGroupKeyFilter"
                     Placeholder="Filter loaded groups by key" Label="Filter loaded concurrency groups by key" Shortcut="true" />
        <Switch Value="_filters.SaturatedOnly" ValueChanged="SetSaturatedOnlyAsync">Saturated only</Switch>
        <Switch Value="_filters.RateLimitedOnly" ValueChanged="SetRateLimitedOnlyAsync">Rate-limited only</Switch>
        <Switch Value="_filters.HasBlockedJobsOnly" ValueChanged="SetHasBlockedJobsOnlyAsync">Has blocked jobs</Switch>
        @if (HasAppliedFilters)
        {
            <Button Variant="ButtonVariant.Ghost" Icon="x" OnClick="ClearFiltersAsync">Reset</Button>
        }
    </div>

    @if (_groups.LoadError is not null)
    {
        <Alert Tone="AlertTone.Destructive" Title="Concurrency groups couldn't be loaded">
            <ChildContent>@_groups.LoadError</ChildContent>
            <Actions>
                <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="LoadAsync">Try again</Button>
            </Actions>
        </Alert>
    }

    @if (_groups.HasPage || _groups.LoadError is null)
    {
        var visibleGroups = FilteredGroups;
        <Card Flush="true" Class="@DashboardTableFormat.CardClass("groups-table-card", _groups.IsReloading)">
            <div class="sd-table-scroll sd-table-scroll--x">
                <table class="sd-table groups-table" data-sd-keyboard="true" aria-busy="@(_groups.IsLoading ? "true" : "false")">
                    <thead>
                        <tr>
                            <th scope="col">Group</th>
                            <th scope="col" class="sd-table__num">Limit</th>
                            <th scope="col">Rate</th>
                            <th scope="col" class="groups-table__permit">Next permit</th>
                            <th scope="col" class="sd-table__num">Running</th>
                            <th scope="col" class="sd-table__num">Blocked</th>
                            <th scope="col">State</th>
                            <th scope="col" class="groups-table__updated">Updated</th>
                            <th scope="col" class="groups-table__actions"><span class="sd-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_groups.HasPage)
                        {
                            @for (var row = 0; row < SkeletonRowCount; row++)
                            {
                                <tr class="groups-table__skeleton" aria-hidden="true">
                                    @for (var column = 0; column < ColumnCount - 1; column++)
                                    {
                                        <td class="@SkeletonColumnClasses[column]"><Skeleton Width="@DashboardTableFormat.SkeletonWidth(row, column)" /></td>
                                    }
                                    <td class="groups-table__actions"></td>
                                </tr>
                            }
                        }
                        else if (visibleGroups.Count == 0)
                        {
                            <tr class="sd-table__empty">
                                <td colspan="@ColumnCount">
                                    <EmptyState Flat="true" Icon="@(HasAppliedFilters ? "search" : "layers")" Title="@EmptyTitle">
                                        <ChildContent>@EmptyText</ChildContent>
                                        <Actions>
                                            @if (HasAppliedFilters)
                                            {
                                                <Button OnClick="ClearFiltersAsync">Reset filters</Button>
                                            }
                                        </Actions>
                                    </EmptyState>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var group in visibleGroups)
                            {
                                var busy = IsBusy(group.GroupKey);
                                var state = DashboardConcurrencyGroupFormat.State(group);
                                <tr @key="group.GroupKey" data-href="@GroupJobsHref(group)">
                                    <td class="groups-table__key">
                                        <a class="groups-key" href="@GroupJobsHref(group)" title="@group.GroupKey">@group.GroupKey</a>
                                    </td>
                                    <td class="sd-table__num">
                                        <span class="groups-value">@DashboardFormat.Count(group.EffectiveLimit)</span>
                                        <span class="@SourceClass(group.OverrideLimit is not null)"
                                              title="@DashboardConcurrencyGroupFormat.LimitSourceTitle(group)">@DashboardConcurrencyGroupFormat.LimitSource(group)</span>
                                    </td>
                                    <td>
                                        <span class="groups-value">@DashboardConcurrencyGroupFormat.Rate(group.EffectiveRateLimit)</span>
                                        <span class="@SourceClass(group.HasRateLimitOverride)"
                                              title="@DashboardConcurrencyGroupFormat.RateSourceTitle(group)">@DashboardConcurrencyGroupFormat.RateSource(group)</span>
                                    </td>
                                    <td class="groups-table__permit">
                                        @if (group.EffectiveRateLimit is null)
                                        {
                                            <span class="sd-muted" title="No start rate limit">—</span>
                                        }
                                        else if (!group.IsRateLimited)
                                        {
                                            <span title="A job can start as soon as a slot is free">Now</span>
                                        }
                                        else
                                        {
                                            <TimestampBlock BaseClass="sd-timestamp" Value="group.NextRatePermitAtUtc" Inline="true"
                                                            EmptyText="Now" AllowFutureRelative="true" />
                                        }
                                    </td>
                                    <td class="sd-table__num" title="@DashboardConcurrencyGroupFormat.OccupancyTitle(group)">@DashboardFormat.Count(group.CurrentOccupancy)</td>
                                    <td class="sd-table__num">
                                        @if (group.BlockedJobCount > 0)
                                        {
                                            <a class="groups-blocked" href="@BlockedJobsHref(group)"
                                               title="@BlockedLinkTitle(group)">@DashboardFormat.Count(group.BlockedJobCount)</a>
                                        }
                                        else
                                        {
                                            <span class="sd-muted">0</span>
                                        }
                                    </td>
                                    <td>
                                        <Badge Class="@StateBadgeClass(state)" title="@DashboardConcurrencyGroupFormat.StateTitle(group)">
                                            <span class="sd-status__dot" aria-hidden="true"></span>@StateLabel(state)
                                        </Badge>
                                    </td>
                                    <td class="groups-table__updated">
                                        <TimestampBlock BaseClass="sd-timestamp" Value="group.UpdatedAtUtc" Inline="true"
                                                        EmptyText="—" AllowFutureRelative="false" />
                                    </td>
                                    <td class="groups-table__actions">
                                        <DropdownMenu Label="@($"Actions for {group.GroupKey}")" Icon="@(busy ? "loader-circle" : "ellipsis")"
                                                      Size="ButtonSize.Small" Disabled="busy">
                                            @if (CanEditLimits)
                                            {
                                                <MenuItem Icon="pencil" OnClick="() => OpenEditDialog(group)">Edit limits…</MenuItem>
                                                <MenuSeparator />
                                                <MenuItem Icon="rotate-ccw" Disabled="@(group.OverrideLimit is null)"
                                                          OnClick="() => OpenConfirmDialog(GroupAction.ResetLimit, group)">Reset limit to default…</MenuItem>
                                                <MenuItem Icon="rotate-ccw" Disabled="@(!group.HasRateLimitOverride)"
                                                          OnClick="() => OpenConfirmDialog(GroupAction.ResetRate, group)">Reset rate to default…</MenuItem>
                                                <MenuItem Icon="infinity" Destructive="true" Disabled="@(group.EffectiveRateLimit is null)"
                                                          OnClick="() => OpenConfirmDialog(GroupAction.RemoveRate, group)">Remove rate limit…</MenuItem>
                                                <MenuSeparator />
                                            }
                                            <MenuItem Icon="list-filter" Href="@GroupJobsHref(group)">Jobs in this group</MenuItem>
                                            <MenuItem Icon="copy" data-sd-copy="@group.GroupKey" data-sd-copy-label="group key">Copy group key</MenuItem>
                                        </DropdownMenu>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <LoadMoreFooter Text="@FooterText" Error="@_groups.LoadMoreError" CanLoadMore="_groups.CanLoadMore"
                            IsLoading="_groups.IsLoading" IsLoadingMore="_groups.IsLoadingMore" OnLoadMore="LoadMoreAsync" />
        </Card>
    }
</div>

<Dialog @bind-Open="_editDialogOpen" Title="Edit limits" Class="groups-edit-dialog">
    <ChildContent>
        @if (_editForm is { } form && _editGroup is { } editGroup)
        {
            <form id="@EditFormId" class="groups-edit-form" novalidate @onsubmit="SaveEditAsync" @onsubmit:preventDefault="true">
                <p>
                    For <span class="sd-mono groups-edit-key">@form.GroupKey</span>. Saved values are overrides and apply on
                    every worker straight away.
                </p>
                <div class="sd-field">
                    <label for="groups-edit-limit">Concurrency limit</label>
                    <input id="groups-edit-limit" class="sd-input groups-edit-number" type="number" inputmode="numeric" min="1"
                           step="1" autocomplete="off" value="@form.Limit" disabled="@_isSaving"
                           aria-invalid="@(form.LimitError is null ? null : "true")"
                           aria-describedby="groups-edit-limit-hint groups-edit-limit-error"
                           @oninput="args => form.Limit = args.Value as string ?? string.Empty" />
                    @if (form.LimitError is not null)
                    {
                        <span id="groups-edit-limit-error" class="sd-field__error" role="alert">@form.LimitError</span>
                    }
                    <span id="groups-edit-limit-hint" class="sd-field__hint">@LimitHint(editGroup)</span>
                </div>
                <div class="sd-field" role="group" aria-labelledby="groups-edit-rate-label">
                    <span id="groups-edit-rate-label">Start rate</span>
                    <Tabs TValue="bool" Items="RateModeItems" Value="form.RateUnlimited" ValueChanged="SetRateUnlimited"
                          Label="Start rate" Small="true" />
                    @if (!form.RateUnlimited)
                    {
                        <div class="groups-edit-rate">
                            <input class="sd-input groups-edit-number" type="number" inputmode="numeric" min="1" step="1"
                                   autocomplete="off" value="@form.RatePermits" disabled="@_isSaving"
                                   aria-label="Jobs that may start in each period"
                                   aria-invalid="@(form.RatePermitsError is null ? null : "true")"
                                   aria-describedby="groups-edit-rate-error"
                                   @oninput="args => form.RatePermits = args.Value as string ?? string.Empty" />
                            <span>jobs per</span>
                            <input class="sd-input groups-edit-number" type="number" inputmode="decimal" min="0" step="any"
                                   autocomplete="off" value="@form.RatePeriod" disabled="@_isSaving"
                                   aria-label="Period length"
                                   aria-invalid="@(form.RatePeriodError is null ? null : "true")"
                                   aria-describedby="groups-edit-rate-error"
                                   @oninput="args => form.RatePeriod = args.Value as string ?? string.Empty" />
                            <span class="sd-select">
                                <select aria-label="Period unit" value="@form.RatePeriodUnit" disabled="@_isSaving"
                                        @onchange="args => SetRatePeriodUnit(form, args)">
                                    <option value="@DashboardRatePeriodUnit.Seconds">seconds</option>
                                    <option value="@DashboardRatePeriodUnit.Minutes">minutes</option>
                                    <option value="@DashboardRatePeriodUnit.Hours">hours</option>
                                </select>
                                <Icon Name="chevron-down" />
                            </span>
                        </div>
                        @if (form.RatePermitsError is not null || form.RatePeriodError is not null)
                        {
                            <span id="groups-edit-rate-error" class="sd-field__error groups-edit-errors" role="alert">
                                @if (form.RatePermitsError is not null)
                                {
                                    <span>@form.RatePermitsError</span>
                                }
                                @if (form.RatePeriodError is not null)
                                {
                                    <span>@form.RatePeriodError</span>
                                }
                            </span>
                        }
                    }
                    <span class="sd-field__hint">@RateHint(form, editGroup)</span>
                </div>
            </form>
        }
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Outline" Disabled="_isSaving" OnClick="CloseEditDialog">Cancel</Button>
        <Button Type="submit" form="@EditFormId" Variant="ButtonVariant.Primary" Disabled="_isSaving"
                Icon="@(_isSaving ? "loader-circle" : null)">Save</Button>
    </Footer>
</Dialog>

<ConfirmDialog @bind-Open="_confirmDialogOpen" Title="@ConfirmTitle" ConfirmLabel="@ConfirmLabel"
               Destructive="@(_confirmAction == GroupAction.RemoveRate)" Busy="@(_confirmGroup is not null && IsBusy(_confirmGroup.GroupKey))"
               OnConfirm="ConfirmGroupActionAsync">
    <p>@ConfirmDescription</p>
</ConfirmDialog>

@code {
    private static readonly TimeSpan PageRefreshInterval = TimeSpan.FromSeconds(5);
    private const int DefaultPageSize = 25;
    private const int SkeletonRowCount = 5;
    private const int ColumnCount = 9;
    private const string EditFormId = "groups-edit-form";

    // Matches the data columns, so skeleton cells hide with their column on narrow screens.
    private static readonly string?[] SkeletonColumnClasses =
      [null, "sd-table__num", null, "groups-table__permit", "sd-table__num", "sd-table__num", null, "groups-table__updated"];

    private static readonly IReadOnlyList<TabItem<bool>> RateModeItems =
    [
        new(false, "Limit starts"),
        new(true, "Unlimited"),
    ];

    private readonly DashboardPagedList<ConcurrencyGroupInspectionSummary> _groups = new();
    private readonly DashboardConcurrencyGroupFilters _filters = new();
    private readonly HashSet<string> _busyKeys = new(StringComparer.Ordinal);
    private IConcurrencyGroupManager? _manager;
    private ConcurrencyGroupInspectionSummary? _editGroup;
    private DashboardConcurrencyGroupLimitForm? _editForm;
    private ConcurrencyGroupInspectionSummary? _confirmGroup;
    private GroupAction _confirmAction;
    private bool _isSaving;
    private bool _editDialogOpen;
    private bool _confirmDialogOpen;

    private enum GroupAction
    {
        ResetLimit,
        ResetRate,
        RemoveRate,
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private IReadOnlyList<ConcurrencyGroupInspectionSummary> FilteredGroups
      => this._filters.ApplyClientFilter(this._groups.Rows);

    private bool CanEditLimits
      => this._manager is not null;

    private bool HasServerFilters
      => this._filters.SaturatedOnly || this._filters.RateLimitedOnly || this._filters.HasBlockedJobsOnly;

    private bool HasKeyFilter
      => !string.IsNullOrWhiteSpace(this._filters.GroupKey);

    private bool HasAppliedFilters
      => this.HasServerFilters || this.HasKeyFilter;

    private string EmptyTitle
      => this._groups.Rows.Count > 0
        ? "No loaded group matches that key"
        : this.HasServerFilters ? "No groups match" : "No concurrency groups yet";

    private string EmptyText
      => this._groups.Rows.Count > 0
        ? !this._groups.CanLoadMore
          ? "Try a shorter part of the key, or clear the search."
          : "Only loaded groups are searched. Load more groups, or clear the search."
        : this.HasServerFilters
          ? "No group is in that condition right now. Try removing a filter."
          : "Groups appear here once a job that uses one is enqueued, or a limit is set for one.";

    private string FooterText
    {
        get
        {
            var loaded = this._groups.Rows.Count;
            var text = string.Concat(
              "Showing ",
              DashboardFormat.Count(loaded),
              " of ",
              DashboardFormat.Count(this._groups.TotalCount ?? loaded),
              this._groups.TotalCount == 1 ? " group" : " groups");
            if (!this.HasKeyFilter)
            {
                return text;
            }

            var visible = this.FilteredGroups.Count;
            return string.Concat(text, " · ", DashboardFormat.Count(visible), visible == 1 ? " matches the key" : " match the key");
        }
    }

    private string ConfirmTitle
      => this._confirmGroup is not { } group
        ? string.Empty
        : this._confirmAction switch
        {
            GroupAction.ResetLimit => string.Concat("Reset the limit for ", group.GroupKey, "?"),
            GroupAction.ResetRate => string.Concat("Reset the start rate for ", group.GroupKey, "?"),
            _ => string.Concat("Remove the start rate limit for ", group.GroupKey, "?"),
        };

    private string ConfirmLabel
      => this._confirmAction switch
      {
          GroupAction.ResetLimit => "Reset limit",
          GroupAction.ResetRate => "Reset rate",
          _ => "Remove rate limit",
      };

    private string ConfirmDescription
    {
        get
        {
            if (this._confirmGroup is not { } group)
            {
                return string.Empty;
            }

            return this._confirmAction switch
            {
                GroupAction.ResetLimit => string.Concat(
                  "The override of ",
                  DashboardFormat.Count(group.OverrideLimit ?? group.EffectiveLimit),
                  " is removed and the limit goes back to ",
                  DashboardConcurrencyGroupFormat.DefaultLimitText(group),
                  ". Jobs that are already running keep running."),
                GroupAction.ResetRate => string.Concat(
                  "The override (",
                  DashboardConcurrencyGroupFormat.Rate(group.OverrideRateLimit).ToLowerInvariant(),
                  ") is removed and the start rate goes back to ",
                  DashboardConcurrencyGroupFormat.DefaultRateText(group),
                  "."),
                _ => group.DefaultRateLimit is { } defaultRate
                  ? string.Concat(
                    "Jobs in this group start as soon as a slot is free. This is saved as an override, so it also replaces the code default of ",
                    DashboardConcurrencyGroupFormat.Rate(defaultRate),
                    " until you reset the rate.")
                  : "Jobs in this group start as soon as a slot is free. You can set a start rate again from Edit limits.",
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        this._manager = Services.GetService<IConcurrencyGroupManager>();
        _ = this._filters.CopyFrom(DashboardConcurrencyGroupFilterQuery.ParseUri(this.Navigation.Uri));
        this.TrackLocation(this.Navigation, DashboardConcurrencyGroupFilterQuery.Path, this.ApplyLocationAsync);
        this.InitializeLiveRefresh(
          this.RefreshCurrentQueryAsync,
          showRefreshing: false,
          lastUpdatedUtc: nowUtc => this.LiveRefresh.LastUpdatedUtc ?? (this._groups.HasPage ? nowUtc : null));

        await this.LoadAsync();
        this.StartPeriodicRefresh(PageRefreshInterval);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
      => this.FlushToastsAsync();

    private async Task SetSaturatedOnlyAsync(bool value)
    {
        this._filters.SaturatedOnly = value;
        this.WriteFiltersToLocation(replace: false);

        await this.LoadAsync();
    }

    private async Task SetHasBlockedJobsOnlyAsync(bool value)
    {
        this._filters.HasBlockedJobsOnly = value;
        this.WriteFiltersToLocation(replace: false);

        await this.LoadAsync();
    }

    private async Task SetRateLimitedOnlyAsync(bool value)
    {
        this._filters.RateLimitedOnly = value;
        this.WriteFiltersToLocation(replace: false);

        await this.LoadAsync();
    }

    // The key filter narrows the loaded groups in the browser, so typing only rewrites the URL.
    private void SetGroupKeyFilter(string value)
    {
        this._filters.GroupKey = value;
        this.WriteFiltersToLocation(replace: true);
    }

    private async Task ClearFiltersAsync()
    {
        var reload = this.HasServerFilters;
        _ = this._filters.CopyFrom(new DashboardConcurrencyGroupFilters());
        this.WriteFiltersToLocation(replace: false);
        if (reload)
        {
            await this.LoadAsync();
        }
    }

    private void WriteFiltersToLocation(bool replace)
      => this.NavigateToLocation(DashboardConcurrencyGroupFilterQuery.ToHref(this._filters), replace);

    private async Task ApplyLocationAsync(string location)
    {
        var next = DashboardConcurrencyGroupFilterQuery.ParseUri(location);
        var queryChanged = next.SaturatedOnly != this._filters.SaturatedOnly
          || next.HasBlockedJobsOnly != this._filters.HasBlockedJobsOnly
          || next.RateLimitedOnly != this._filters.RateLimitedOnly;
        if (!this._filters.CopyFrom(next))
        {
            return;
        }

        if (queryChanged)
        {
            await this.LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        this.LiveRefresh.ClearError();
        var current = await this._groups.LoadAsync(
          () => Reader.SearchConcurrencyGroupsAsync(this._filters.ToQuery(DefaultPageSize, continuationToken: null)),
          page =>
          {
              this.ReplaceGroups(page);
              this.LiveRefresh.MarkUpdated();
          });
        if (current)
        {
            this.NotifyShellRefreshChanged();
        }
    }

    // A failure keeps the loaded rows and is shown next to the Load more control.
    private async Task LoadMoreAsync()
    {
        var requested = await this._groups.LoadMoreAsync(
          continuationToken => Reader.SearchConcurrencyGroupsAsync(this._filters.ToQuery(DefaultPageSize, continuationToken)),
          page =>
          {
              this._groups.Append(page.Groups, page.ContinuationToken, page.TotalCount);
              this.LiveRefresh.MarkUpdated();
          });
        if (requested)
        {
            this.NotifyShellRefreshChanged();
        }
    }

    private async Task RefreshCurrentQueryAsync(CancellationToken cancellationToken)
    {
        var queryVersion = this._groups.QueryVersion;
        var visiblePageSize = Math.Max(DefaultPageSize, this._groups.Rows.Count);
        var page = await Reader.SearchConcurrencyGroupsAsync(
          this._filters.ToQuery(visiblePageSize, continuationToken: null),
          cancellationToken);

        await this.ApplyPageStateAsync(() =>
        {
            if (this._groups.IsCurrent(queryVersion))
            {
                this.ReplaceGroups(page);
            }
        });
    }

    private void ReplaceGroups(ConcurrencyGroupInspectionPage page)
      => this._groups.Replace(page.Groups, page.ContinuationToken, page.TotalCount);

    private bool IsBusy(string groupKey)
      => this._busyKeys.Contains(groupKey);

    private void OpenEditDialog(ConcurrencyGroupInspectionSummary group)
    {
        this._editGroup = group;
        this._editForm = DashboardConcurrencyGroupLimitForm.For(group);
        this._editDialogOpen = true;
    }

    private void CloseEditDialog()
      => this._editDialogOpen = false;

    private void SetRateUnlimited(bool unlimited)
    {
        if (this._editForm is { } form)
        {
            form.RateUnlimited = unlimited;
        }
    }

    private static void SetRatePeriodUnit(DashboardConcurrencyGroupLimitForm form, ChangeEventArgs args)
    {
        if (Enum.TryParse<DashboardRatePeriodUnit>(args.Value as string, out var unit))
        {
            form.RatePeriodUnit = unit;
        }
    }

    // Saves the concurrency limit and then the start rate, each only when it changed. Field errors keep the dialog
    // open; so does a failed save, with the saved part recorded so a retry doesn't repeat it.
    private async Task SaveEditAsync()
    {
        if (this._manager is null || this._editForm is not { } form || this._isSaving)
        {
            return;
        }

        if (!form.TryGetChanges(out var changes))
        {
            return;
        }

        if (changes.IsEmpty)
        {
            this._editDialogOpen = false;
            this.ShowToast(string.Concat("No changes to save for ", form.GroupKey));
            return;
        }

        var groupKey = form.GroupKey;
        var saved = new List<string>(2);
        this._isSaving = true;
        _ = this._busyKeys.Add(groupKey);

        try
        {
            if (changes.Limit is { } limit)
            {
                await this._manager.SetLimitAsync(groupKey, limit);
                form.MarkLimitSaved(limit);
                saved.Add(string.Concat("Concurrency limit: ", DashboardFormat.Count(limit), "."));
            }

            if (changes.RateChanged)
            {
                if (changes.Rate is { } rate)
                {
                    await this._manager.SetRateLimitAsync(groupKey, rate);
                }
                else
                {
                    await this._manager.SetUnlimitedRateLimitAsync(groupKey);
                }

                form.MarkRateSaved(changes.Rate);
                saved.Add(string.Concat("Start rate: ", DashboardConcurrencyGroupFormat.Rate(changes.Rate).ToLowerInvariant(), "."));
            }

            this._editDialogOpen = false;
            this.ShowToast(string.Concat("Saved limits for ", groupKey), string.Join(" ", saved), AlertTone.Success);
            await this.LiveRefresh.RefreshNowAsync();
        }
        catch (Exception exception)
        {
            this.ShowToast(
              saved.Count == 0
                ? string.Concat("Couldn't save limits for ", groupKey)
                : string.Concat("Couldn't save the start rate for ", groupKey),
              saved.Count == 0 ? exception.Message : string.Concat(exception.Message, " The concurrency limit was saved."),
              AlertTone.Destructive);
            if (saved.Count > 0)
            {
                await this.LiveRefresh.RefreshNowAsync();
            }
        }
        finally
        {
            this._isSaving = false;
            _ = this._busyKeys.Remove(groupKey);
        }
    }

    private void OpenConfirmDialog(GroupAction action, ConcurrencyGroupInspectionSummary group)
    {
        this._confirmAction = action;
        this._confirmGroup = group;
        this._confirmDialogOpen = true;
    }

    private async Task ConfirmGroupActionAsync()
    {
        if (this._manager is null || this._confirmGroup is not { } group || !this._busyKeys.Add(group.GroupKey))
        {
            return;
        }

        var groupKey = group.GroupKey;
        var action = this._confirmAction;

        // The row stays busy until the list has refreshed, so it never shows the old values as actionable.
        try
        {
            switch (action)
            {
                case GroupAction.ResetLimit:
                    await this._manager.ClearLimitOverrideAsync(groupKey);
                    this.ShowToast(
                      string.Concat("Reset the limit for ", groupKey),
                      string.Concat("It's back to ", DashboardConcurrencyGroupFormat.DefaultLimitText(group), "."),
                      AlertTone.Success);
                    break;
                case GroupAction.ResetRate:
                    await this._manager.ClearRateLimitOverrideAsync(groupKey);
                    this.ShowToast(
                      string.Concat("Reset the start rate for ", groupKey),
                      string.Concat("It's back to ", DashboardConcurrencyGroupFormat.DefaultRateText(group), "."),
                      AlertTone.Success);
                    break;
                default:
                    await this._manager.SetUnlimitedRateLimitAsync(groupKey);
                    this.ShowToast(
                      string.Concat("Removed the start rate limit for ", groupKey),
                      "Jobs in this group start as soon as a slot is free.",
                      AlertTone.Success);
                    break;
            }

            await this.LiveRefresh.RefreshNowAsync();
        }
        catch (Exception exception)
        {
            var title = action switch
            {
                GroupAction.ResetLimit => "Couldn't reset the limit for ",
                GroupAction.ResetRate => "Couldn't reset the start rate for ",
                _ => "Couldn't remove the start rate limit for ",
            };
            this.ShowToast(string.Concat(title, groupKey), exception.Message, AlertTone.Destructive);
        }
        finally
        {
            _ = this._busyKeys.Remove(groupKey);
        }
    }

    private static string LimitHint(ConcurrencyGroupInspectionSummary group)
      => string.Concat(
        "The most jobs in this group that run at the same time. Without an override it is ",
        DashboardConcurrencyGroupFormat.DefaultLimitText(group),
        ".");

    private static string RateHint(
        DashboardConcurrencyGroupLimitForm form,
        ConcurrencyGroupInspectionSummary group)
      => string.Concat(
        form.RateUnlimited
          ? "Jobs start as soon as a slot is free."
          : "Starts are spaced evenly across the period.",
        " Without an override the rate is ",
        DashboardConcurrencyGroupFormat.DefaultRateText(group),
        ".");

    private static string BlockedLinkTitle(ConcurrencyGroupInspectionSummary group)
      => string.Concat(DashboardConcurrencyGroupFormat.BlockedTitle(group), " Show queued jobs in this group.");

    private static string SourceClass(bool isOverride)
      => isOverride ? "groups-source groups-source--override" : "groups-source";

    private static string StateLabel(DashboardConcurrencyGroupState state)
      => state switch
      {
          DashboardConcurrencyGroupState.Blocked => "Blocked",
          DashboardConcurrencyGroupState.Saturated => "Saturated",
          DashboardConcurrencyGroupState.High => "High",
          _ => "Nominal",
      };

    private static string StateBadgeClass(DashboardConcurrencyGroupState state)
      => string.Concat("sd-status groups-state groups-state--", state.ToString().ToLowerInvariant());

    private static string GroupJobsHref(ConcurrencyGroupInspectionSummary group)
      => DashboardJobFilterQuery.GroupHref(group.GroupKey);

    private static string BlockedJobsHref(ConcurrencyGroupInspectionSummary group)
      => DashboardJobFilterQuery.QueuedInGroupHref(group.GroupKey);
}
