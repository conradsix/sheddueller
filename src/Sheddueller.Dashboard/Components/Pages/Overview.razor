@page "/"
@inherits DashboardPageComponent
@inject IJobInspectionReader Reader
@inject DashboardLiveUpdateStream LiveUpdates
@inject Microsoft.Extensions.Options.IOptions<ShedduellerDashboardOptions> DashboardOptions

<div class="sd-page overview-page">
    <PageHeader Title="Overview" Description="Jobs by state, and what is running, failing and waiting right now." />

    @if (_overview is null)
    {
        @if (_loadError is not null)
        {
            <Alert Tone="AlertTone.Destructive" Title="The overview couldn't be loaded">
                <ChildContent>@_loadError</ChildContent>
                <Actions>
                    <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="RetryLoadAsync">Try again</Button>
                </Actions>
            </Alert>
        }
        else
        {
            <div class="overview-stats" aria-busy="true" aria-label="Loading the overview">
                @foreach (var state in StateOrder)
                {
                    <div class="overview-stat" aria-hidden="true">
                        <Skeleton Width="55%" />
                        <Skeleton Width="40%" Height="28px" />
                    </div>
                }
            </div>
            <Card Flush="true" Class="overview-list" aria-hidden="true">
                <table class="sd-table overview-table">
                    <tbody>
                        @for (var row = 0; row < SkeletonRowCount; row++)
                        {
                            <tr>
                                <td><Skeleton Width="@SkeletonWidth(row, 0)" /></td>
                                <td><Skeleton Width="@SkeletonWidth(row, 1)" /></td>
                                <td><Skeleton Width="@SkeletonWidth(row, 2)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </Card>
        }
    }
    else
    {
        @if (LiveRefresh.RefreshError is not null)
        {
            <Alert Tone="AlertTone.Warning" Meta="StaleDataNote" Title="Couldn't refresh the overview">
                <ChildContent>@LiveRefresh.RefreshError</ChildContent>
                <Actions>
                    <Button Size="ButtonSize.Small" Icon="refresh-cw" OnClick="RetryRefreshAsync">Try again</Button>
                </Actions>
            </Alert>
        }

        <section class="overview-stats" aria-label="Jobs by state">
            @foreach (var state in StateOrder)
            {
                var count = GetStateCount(_overview, state);
                <a class="@StatClass(state, count)" href="@DashboardJobFilterQuery.StateHref(state)"
                   aria-label="@StatLabel(state, count)">
                    <span class="overview-stat__label">
                        <span class="@StateDotClass(state)" aria-hidden="true"></span>
                        @StatusBadge.StateLabel(state)
                        <Icon Name="chevron-right" />
                    </span>
                    <span class="overview-stat__value">@DashboardFormat.Count(count)</span>
                </a>
            }
        </section>

        <Card Flush="true" Title="Running" Description="Most recently started first." Class="overview-list">
            <HeaderActions>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@RunningHref" IconEnd="chevron-right">View all</Button>
            </HeaderActions>
            <ChildContent>
                @if (_overview.RunningJobs.Count == 0)
                {
                    <EmptyState Flat="true" Icon="circle-pause" Title="Nothing is running">
                        Jobs show up here while a node is working on them.
                    </EmptyState>
                }
                else
                {
                    <div class="sd-table-scroll">
                        <table class="sd-table overview-table">
                            <colgroup>
                                <col class="overview-col--job" />
                                <col class="overview-col--handler" />
                                <col class="overview-col--time" />
                                <col />
                                <col class="overview-col--tags" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Job</th>
                                    <th>Handler</th>
                                    <th>Started</th>
                                    <th>Progress</th>
                                    <th>Tags</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in _overview.RunningJobs)
                                {
                                    <tr @key="job.JobId" data-href="@DashboardFormat.JobHref(job.JobId)">
                                        <td>@JobIdLink(job)</td>
                                        <td>@HandlerLink(job)</td>
                                        <td><TimestampBlock BaseClass="sd-timestamp" Value="job.ClaimedAtUtc" AllowFutureRelative="false" Inline EmptyText="—" /></td>
                                        <td>
                                            @if (job.LatestProgress?.Percent is { } percent)
                                            {
                                                <span class="overview-progress" title="@job.LatestProgress.Message">
                                                    <Progress Value="percent" Label="@($"Progress {percent:0}%")" />
                                                    <span class="sd-num">@DashboardFormat.ProgressText(job.LatestProgress, string.Empty)</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="sd-muted" title="@job.LatestProgress?.Message">@(job.LatestProgress?.Message ?? "—")</span>
                                            }
                                        </td>
                                        <td>@TagCell(job)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ChildContent>
        </Card>

        <Card Flush="true" Title="Recently failed" Description="Most recent failures first." Class="overview-list">
            <HeaderActions>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@FailedHref" IconEnd="chevron-right">View all</Button>
            </HeaderActions>
            <ChildContent>
                @if (_overview.RecentlyFailedJobs.Count == 0)
                {
                    <EmptyState Flat="true" Icon="circle-check" Title="No failed jobs">
                        Jobs that fail after their last attempt show up here.
                    </EmptyState>
                }
                else
                {
                    <div class="sd-table-scroll">
                        <table class="sd-table overview-table">
                            <colgroup>
                                <col class="overview-col--job" />
                                <col class="overview-col--handler" />
                                <col class="overview-col--time" />
                                <col />
                                <col class="overview-col--tags" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Job</th>
                                    <th>Handler</th>
                                    <th>Failed</th>
                                    <th>Error</th>
                                    <th>Tags</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in _overview.RecentlyFailedJobs)
                                {
                                    var failure = FailureMessage(job);
                                    <tr @key="job.JobId" data-href="@DashboardFormat.JobHref(job.JobId)">
                                        <td>@JobIdLink(job)</td>
                                        <td>@HandlerLink(job)</td>
                                        <td><TimestampBlock BaseClass="sd-timestamp" Value="DashboardFormat.TerminalTimestamp(job)" AllowFutureRelative="false" Inline EmptyText="—" /></td>
                                        <td>
                                            @if (failure is null)
                                            {
                                                <span class="sd-muted">No error message</span>
                                            }
                                            else
                                            {
                                                <span class="overview-error" title="@failure">@failure</span>
                                            }
                                        </td>
                                        <td>@TagCell(job)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ChildContent>
        </Card>

        <div class="overview-queues">
            <Card Flush="true" Title="Next up" Description="Ready to run, in claim order." Class="overview-list overview-list--compact">
                <HeaderActions>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@QueuedHref" IconEnd="chevron-right">View all</Button>
                </HeaderActions>
                <ChildContent>
                    @if (_overview.QueuedJobs.Count == 0)
                    {
                        <EmptyState Flat="true" Icon="inbox" Title="Nothing is ready">
                            No queued jobs can be claimed right now.
                        </EmptyState>
                    }
                    else
                    {
                        <table class="sd-table overview-table">
                            <colgroup>
                                <col class="overview-col--job" />
                                <col />
                                <col class="overview-col--when" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Job</th>
                                    <th>Handler</th>
                                    <th>Enqueued</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in _overview.QueuedJobs)
                                {
                                    <tr @key="job.JobId" data-href="@DashboardFormat.JobHref(job.JobId)">
                                        <td>@JobIdLink(job)</td>
                                        <td>@HandlerLink(job)</td>
                                        <td><TimestampBlock BaseClass="sd-timestamp" Value="job.EnqueuedAtUtc" AllowFutureRelative="false" Inline /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </ChildContent>
            </Card>

            <Card Flush="true" Title="Waiting to retry" Description="Failed an attempt and will run again." Class="overview-list overview-list--compact">
                <HeaderActions>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@QueuedHref" IconEnd="chevron-right">View all</Button>
                </HeaderActions>
                <ChildContent>
                    @if (_overview.RetryWaitingJobs.Count == 0)
                    {
                        <EmptyState Flat="true" Icon="rotate-ccw" Title="No retries pending">
                            Jobs whose attempt failed wait here until their next try.
                        </EmptyState>
                    }
                    else
                    {
                        <table class="sd-table overview-table">
                            <colgroup>
                                <col class="overview-col--job" />
                                <col />
                                <col class="overview-col--attempts" />
                                <col class="overview-col--when" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Job</th>
                                    <th>Handler</th>
                                    <th class="overview-num" title="Attempts so far, of the maximum">Tries</th>
                                    <th>Next try</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in _overview.RetryWaitingJobs)
                                {
                                    <tr @key="job.JobId" data-href="@DashboardFormat.JobHref(job.JobId)" title="@FailureMessage(job)">
                                        <td>@JobIdLink(job)</td>
                                        <td>@HandlerLink(job)</td>
                                        <td class="overview-num">@DashboardFormat.Attempts(job, compact: true)</td>
                                        <td><TimestampBlock BaseClass="sd-timestamp" Value="job.NotBeforeUtc" Inline EmptyText="—" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </ChildContent>
            </Card>

            <Card Flush="true" Title="Delayed" Description="Enqueued to start at a later time." Class="overview-list overview-list--compact">
                <HeaderActions>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@QueuedHref" IconEnd="chevron-right">View all</Button>
                </HeaderActions>
                <ChildContent>
                    @if (_overview.DelayedJobs.Count == 0)
                    {
                        <EmptyState Flat="true" Icon="clock" Title="No delayed jobs">
                            Jobs enqueued with a later start time wait here.
                        </EmptyState>
                    }
                    else
                    {
                        <table class="sd-table overview-table">
                            <colgroup>
                                <col class="overview-col--job" />
                                <col />
                                <col class="overview-col--when" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Job</th>
                                    <th>Handler</th>
                                    <th>Starts</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in _overview.DelayedJobs)
                                {
                                    <tr @key="job.JobId" data-href="@DashboardFormat.JobHref(job.JobId)">
                                        <td>@JobIdLink(job)</td>
                                        <td>@HandlerLink(job)</td>
                                        <td><TimestampBlock BaseClass="sd-timestamp" Value="job.NotBeforeUtc" Inline EmptyText="—" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </ChildContent>
            </Card>
        </div>
    }
</div>

@code {
    private static readonly RenderFragment StaleDataNote = @<span class="sd-alert__meta">The counts and lists below are from the last successful refresh.</span>;

    private const int SkeletonRowCount = 4;

    // Live work first, then outcomes. Claimed is shown as Running.
    private static readonly JobState[] StateOrder = [JobState.Queued, JobState.Claimed, JobState.Failed, JobState.Completed, JobState.Canceled];

    private static readonly string QueuedHref = DashboardJobFilterQuery.StateHref(JobState.Queued);
    private static readonly string RunningHref = DashboardJobFilterQuery.StateHref(JobState.Claimed);
    private static readonly string FailedHref = CreateFailedHref();

    private JobInspectionOverview? _overview;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        this.InitializeLiveRefresh(
          this.RefreshOverviewAsync,
          showRefreshing: true,
          lastUpdatedUtc: nowUtc => this.LiveRefresh.LastUpdatedUtc ?? (this._overview is null ? null : nowUtc));
        LiveUpdates.JobEventPublished += this.OnJobEventPublishedAsync;
        await this.LoadOverviewAsync();
    }

    private protected override ValueTask DisposePageAsync()
    {
        LiveUpdates.JobEventPublished -= this.OnJobEventPublishedAsync;
        return ValueTask.CompletedTask;
    }

    private async ValueTask OnJobEventPublishedAsync(
        JobEvent jobEvent,
        CancellationToken cancellationToken)
    {
        _ = cancellationToken;

        await this.ApplyPageStateAsync(() => this.LiveRefresh.MarkLiveActivity(jobEvent.OccurredAtUtc));
        this.LiveRefresh.QueueRefresh();
    }

    private async Task LoadOverviewAsync()
    {
        try
        {
            var overview = await Reader.GetOverviewAsync();
            this._overview = overview;
            this._loadError = null;
            this.LiveRefresh.MarkUpdated();
            this.NotifyShellRefreshChanged();
            await this.InvokeAsync(this.StateHasChanged);
        }
        catch (Exception exception)
        {
            this._loadError = exception.Message;
        }
    }

    private Task RetryLoadAsync()
    {
        // Show the loading placeholders again while the retry runs.
        this._loadError = null;
        return this.LoadOverviewAsync();
    }

    private Task RetryRefreshAsync()
      => this.LiveRefresh.RefreshNowAsync();

    private async Task RefreshOverviewAsync(CancellationToken cancellationToken)
    {
        var overview = await Reader.GetOverviewAsync(cancellationToken);

        await this.ApplyPageStateAsync(() =>
        {
            this._overview = overview;
            this._loadError = null;
        });
    }

    private static int GetStateCount(JobInspectionOverview overview, JobState state)
      => overview.StateCounts.TryGetValue(state, out var count) ? count : 0;

    private static string CreateFailedHref()
    {
        var filters = new DashboardJobFilters();
        _ = filters.ReplaceStates([JobState.Failed]);
        _ = filters.SetSort(JobInspectionSort.NewestFirst);
        return DashboardJobFilterQuery.ToHref(filters);
    }

    private static string StatClass(JobState state, int count)
      => state == JobState.Failed && count > 0 ? "overview-stat overview-stat--attention" : "overview-stat";

    private static string StateDotClass(JobState state)
      => string.Concat("sd-state-dot sd-state-dot--", DashboardFormat.StateCssModifier(state));

    private static string StatLabel(JobState state, int count)
      => string.Create(
        CultureInfo.InvariantCulture,
        $"{StatusBadge.StateLabel(state)}: {DashboardFormat.Count(count)}. Show these jobs");

    private static string SkeletonWidth(int row, int column)
      => string.Create(CultureInfo.InvariantCulture, $"{45 + ((row * 7 + column * 13) % 45)}%");

    // The failure reason recorded with the job, or null when there is none to show.
    private static string? FailureMessage(JobInspectionSummary job)
      => new[] { job.LatestProgress?.Message, job.QueuePosition?.Reason }.FirstOrDefault(static value => !string.IsNullOrWhiteSpace(value));

    private static string ShortJobId(Guid jobId)
      => jobId.ToString("D")[..8];

    private static RenderFragment JobIdLink(JobInspectionSummary job)
      => @<a class="overview-job-id" href="@DashboardFormat.JobHref(job.JobId)" title="@DashboardFormat.JobId(job.JobId)">@ShortJobId(job.JobId)</a>;

    private static RenderFragment HandlerLink(JobInspectionSummary job)
      => @<a class="overview-handler" href="@DashboardJobFilterQuery.HandlerHref(DashboardFormat.ShortHandler(job))"
             data-sd-tooltip="@string.Concat("Show only ", DashboardFormat.FullHandler(job))">@DashboardFormat.ShortHandler(job)</a>;

    private RenderFragment TagCell(JobInspectionSummary job)
    {
        var tags = DashboardTagOrder.Apply(job.Tags, DashboardOptions.Value.TagDisplayOrder);
        return @<TagList Values="@DashboardFormat.Tags(tags)" Title="@DashboardFormat.TagsTitle(tags)"
                         HrefFactory="DashboardJobFilterQuery.TagHref" TooltipPrefix="Show only tag" />;
    }
}
