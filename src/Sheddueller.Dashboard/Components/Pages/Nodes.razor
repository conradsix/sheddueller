@page "/nodes"
@inherits DashboardPageComponent
@inject INodeInspectionReader NodeReader

<div class="sd-page nodes-page">
    <PageHeader Title="Nodes" Description="Workers that send heartbeats to this job store, with their health and how much work each one is running." />

    <nav class="nodes-health" aria-label="Filter nodes by health">
        @foreach (var tile in HealthTiles)
        {
            var selected = IsTileSelected(tile.State);
            <a class="@TileClass(tile)" href="@TileHref(tile.State)" aria-current="@(selected ? "true" : null)"
               title="@TileTitle(tile, selected)" @key="tile.Label">
                <span class="nodes-health__label">
                    @if (tile.State is not null)
                    {
                        <span class="nodes-health__dot" aria-hidden="true"></span>
                    }
                    @tile.Label
                </span>
                @if (_healthCounts is null && _loadError is null)
                {
                    <Skeleton Width="48px" Height="30px" />
                }
                else
                {
                    <span class="nodes-health__count">@DashboardFormat.Count(TileCount(tile.State))</span>
                }
                <span class="nodes-health__caption">@tile.Caption</span>
            </a>
        }
    </nav>

    <div class="sd-toolbar nodes-toolbar">
        <SearchInput Class="nodes-search" Value="@_filters.NodeId" ValueChanged="SetNodeIdFilter" Placeholder="Filter by node ID"
                     Label="Filter loaded nodes by node ID" Shortcut="true" />
        @if (HasFilters)
        {
            <Button Variant="ButtonVariant.Ghost" Icon="x" OnClick="ResetFiltersAsync">Reset</Button>
        }
    </div>

    @if (_loadError is not null)
    {
        <Alert Tone="AlertTone.Destructive" Title="Nodes couldn't be loaded">
            <ChildContent>@_loadError</ChildContent>
            <Actions>
                <Button Size="ButtonSize.Small" Icon="@(_isLoading ? "loader-circle" : "refresh-cw")" Disabled="_isLoading"
                        OnClick="LoadAsync">Try again</Button>
            </Actions>
        </Alert>
    }
    else if (LiveRefresh.RefreshError is not null)
    {
        <Alert Tone="AlertTone.Warning" Title="Live refresh failed">
            Showing the nodes from the last successful refresh. @LiveRefresh.RefreshError
        </Alert>
    }

    @if (_nodePage is not null || _loadError is null)
    {
        var visibleNodes = FilteredNodes;

        <Card Flush="true" Class="@TableCardClass">
            <div class="nodes-table-wrap">
                <table class="sd-table nodes-table" aria-busy="@(_isLoading ? "true" : "false")">
                    <colgroup>
                        <col />
                        <col class="nodes-table__col-health" />
                        <col class="nodes-table__col-time" />
                        <col class="nodes-table__col-time" />
                        <col class="nodes-table__col-running" />
                        <col class="nodes-table__col-claimed" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Node</th>
                            <th scope="col">Health</th>
                            <th scope="col">Last heartbeat</th>
                            <th scope="col">First seen</th>
                            <th scope="col" class="nodes-table__num" title="Jobs executing on the node now, out of its execution slots">Running</th>
                            <th scope="col" class="nodes-table__num" title="Jobs the node has claimed">Claimed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_nodePage is null)
                        {
                            @for (var row = 0; row < SkeletonRowCount; row++)
                            {
                                <tr class="nodes-table__skeleton" aria-hidden="true">
                                    <td><Skeleton Width="@(row % 2 == 0 ? "62%" : "48%")" /></td>
                                    <td><Skeleton Width="64px" /></td>
                                    <td><Skeleton Width="70%" /></td>
                                    <td><Skeleton Width="70%" /></td>
                                    <td><Skeleton Width="80%" /></td>
                                    <td><Skeleton Width="40%" /></td>
                                </tr>
                            }
                        }
                        else if (visibleNodes.Count == 0)
                        {
                            <tr class="nodes-table__empty">
                                <td colspan="6">
                                    <EmptyState Flat="true" Icon="@(HasFilters ? "search-x" : "server")" Title="@EmptyTitle">
                                        <ChildContent>@EmptyText</ChildContent>
                                        <Actions>
                                            @if (HasFilters)
                                            {
                                                <Button OnClick="ResetFiltersAsync">Reset filters</Button>
                                            }
                                        </Actions>
                                    </EmptyState>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var node in visibleNodes)
                            {
                                <tr @key="node.NodeId">
                                    <td>
                                        <span class="nodes-id-cell">
                                            <span class="nodes-id" title="@node.NodeId">@node.NodeId</span>
                                            <span class="nodes-copy"><CopyButton Value="@node.NodeId" Label="node ID" /></span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="@HealthBadgeClass(node.State)">
                                            <span class="sd-status__dot" aria-hidden="true"></span>
                                            @HealthLabel(node.State)
                                        </span>
                                    </td>
                                    <td><TimestampBlock BaseClass="sd-timestamp" Value="node.LastHeartbeatAtUtc" AllowFutureRelative="false" Inline /></td>
                                    <td><TimestampBlock BaseClass="sd-timestamp" Value="node.FirstSeenAtUtc" AllowFutureRelative="false" Inline /></td>
                                    <td class="nodes-table__num">
                                        <span class="nodes-load" title="@RunningTitle(node)">
                                            <Progress Value="@LoadPercent(node)" Class="@LoadBarClass(node)" Label="@RunningTitle(node)" />
                                            <span class="nodes-load__text">@RunningText(node)</span>
                                        </span>
                                    </td>
                                    <td class="nodes-table__num">@DashboardFormat.Count(node.ClaimedJobCount)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <footer class="sd-table__footer">
                <span class="sd-num">@FooterText</span>
                <span class="nodes-footer-actions">
                    @if (_loadMoreError is not null)
                    {
                        <span class="sd-field__error" role="alert">Couldn't load more: @_loadMoreError</span>
                    }
                    @if (_nodePage?.ContinuationToken is not null)
                    {
                        <Button Size="ButtonSize.Small" Icon="@(_isLoadingMore ? "loader-circle" : null)"
                                Disabled="@(_isLoading || _isLoadingMore)" OnClick="LoadMoreAsync">Load more</Button>
                    }
                </span>
            </footer>
        </Card>
    }
</div>

@code {
    private static readonly TimeSpan PageRefreshInterval = TimeSpan.FromSeconds(5);
    private const int DefaultPageSize = 25;
    private const int SkeletonRowCount = 4;

    private static readonly IReadOnlyList<HealthTile> HealthTiles =
    [
        new(null, "All nodes", "Every node with a heartbeat record", "all"),
        new(NodeHealthState.Active, "Active", "Heartbeating on time", "success"),
        new(NodeHealthState.Stale, "Stale", "Missed recent heartbeats", "warning"),
        new(NodeHealthState.Dead, "Dead", "Stopped heartbeating", "destructive"),
    ];

    private readonly List<NodeInspectionSummary> _nodes = [];
    private readonly DashboardNodeFilters _filters = new();
    private NodeInspectionPage? _nodePage;
    private NodeHealthCounts? _healthCounts;
    private string? _loadError;
    private string? _loadMoreError;
    private int _queryVersion;
    private bool _isLoading;
    private bool _isLoadingMore;

    private IReadOnlyList<NodeInspectionSummary> FilteredNodes
      => this._filters.ApplyClientFilter(this._nodes);

    private int ActiveNodeCount
      => this._healthCounts?.ActiveNodeCount ?? this._nodes.Count(node => node.State == NodeHealthState.Active);

    private int StaleNodeCount
      => this._healthCounts?.StaleNodeCount ?? this._nodes.Count(node => node.State == NodeHealthState.Stale);

    private int DeadNodeCount
      => this._healthCounts?.DeadNodeCount ?? this._nodes.Count(node => node.State == NodeHealthState.Dead);

    private int TotalNodeCount
      => this._healthCounts?.TotalNodeCount ?? this.ActiveNodeCount + this.StaleNodeCount + this.DeadNodeCount;

    private bool HasNodeIdFilter
      => !string.IsNullOrWhiteSpace(this._filters.NodeId);

    private bool HasFilters
      => this._filters.StateFilter is not null || this.HasNodeIdFilter;

    private string TableCardClass
      => this._isLoading && this._nodePage is not null
        ? "sd-table-card nodes-table-card sd-table-card--loading"
        : "sd-table-card nodes-table-card";

    private string EmptyTitle
    {
        get
        {
            if (this._nodes.Count > 0)
            {
                return string.Concat("No loaded nodes match “", this._filters.NodeId.Trim(), "”");
            }

            return this._filters.StateFilter is { } state
              ? string.Concat("No ", HealthLabel(state).ToLowerInvariant(), " nodes")
              : this.HasNodeIdFilter ? "No nodes match" : "No nodes yet";
        }
    }

    private string EmptyText
    {
        get
        {
            if (this._nodes.Count > 0)
            {
                return this._nodePage?.ContinuationToken is not null
                  ? "The node ID filter only checks nodes that are loaded. Load more nodes, or reset the filters."
                  : "Try a different node ID, or reset the filters.";
            }

            return this._filters.StateFilter is { } state
              ? string.Concat("No nodes are ", HealthLabel(state).ToLowerInvariant(), " right now.")
              : "Nodes appear here once a worker sends its first heartbeat.";
        }
    }

    private string FooterText
    {
        get
        {
            var loadedCount = this._nodes.Count;
            var totalCount = this._nodePage?.TotalCount ?? loadedCount;
            if (this.HasNodeIdFilter)
            {
                return string.Create(
                  CultureInfo.InvariantCulture,
                  $"{DashboardFormat.Count(this.FilteredNodes.Count)} of {DashboardFormat.Count(loadedCount)} loaded nodes match the node ID filter");
            }

            return string.Create(
              CultureInfo.InvariantCulture,
              $"Showing {DashboardFormat.Count(loadedCount)} of {DashboardFormat.Count(totalCount)} {(totalCount == 1 ? "node" : "nodes")}");
        }
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _ = this._filters.CopyFrom(DashboardNodeFilterQuery.ParseUri(this.Navigation.Uri));
        this.TrackLocation(this.Navigation, DashboardNodeFilterQuery.Path, this.ApplyLocationAsync);
        this.InitializeLiveRefresh(
          this.RefreshCurrentQueryAsync,
          showRefreshing: false,
          lastUpdatedUtc: nowUtc => this.LiveRefresh.LastUpdatedUtc ?? (this._nodePage is null ? null : nowUtc));

        await this.LoadAsync();
        this.StartPeriodicRefresh(PageRefreshInterval);
    }

    private void SetNodeIdFilter(string value)
    {
        this._filters.NodeId = value;
        this.NavigateToLocation(DashboardNodeFilterQuery.ToHref(this._filters), replace: true);
    }

    private async Task ResetFiltersAsync()
    {
        var stateChanged = this._filters.StateFilter is not null;
        this._filters.State = string.Empty;
        this._filters.NodeId = string.Empty;
        this.NavigateToLocation(DashboardNodeFilterQuery.ToHref(this._filters), replace: false);

        if (stateChanged)
        {
            await this.LoadAsync();
        }
    }

    // Health tiles are links: following one changes the URL, and the location tracker applies the new state.
    private async Task ApplyLocationAsync(string location)
    {
        var next = DashboardNodeFilterQuery.ParseUri(location);
        var stateChanged = !string.Equals(next.State, this._filters.State, StringComparison.Ordinal);
        if (this._filters.CopyFrom(next) && stateChanged)
        {
            await this.LoadAsync();
        }
    }

    // A newer query (a health filter change) supersedes slower earlier reads: only its results are applied.
    private async Task LoadAsync()
    {
        var queryVersion = ++this._queryVersion;
        this._loadError = null;
        this._loadMoreError = null;
        this.LiveRefresh.ClearError();
        this._isLoading = true;

        try
        {
            var snapshot = await this.ReadSnapshotAsync(
              continuationToken: null,
              pageSize: DefaultPageSize,
              CancellationToken.None);
            if (queryVersion != this._queryVersion)
            {
                return;
            }

            this.ApplySnapshot(snapshot, append: false);
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            if (queryVersion == this._queryVersion)
            {
                this._loadError = exception.Message;
            }
        }
        finally
        {
            if (queryVersion == this._queryVersion)
            {
                this._isLoading = false;
                this.NotifyShellRefreshChanged();
            }
        }
    }

    private async Task LoadMoreAsync()
    {
        if (this._nodePage?.ContinuationToken is null || this._isLoading || this._isLoadingMore)
        {
            return;
        }

        var queryVersion = this._queryVersion;
        this._loadMoreError = null;
        this._isLoadingMore = true;

        try
        {
            var snapshot = await this.ReadSnapshotAsync(
              this._nodePage.ContinuationToken,
              DefaultPageSize,
              CancellationToken.None);
            if (queryVersion != this._queryVersion)
            {
                return;
            }

            this.ApplySnapshot(snapshot, append: true);
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            // Keep the loaded rows; the failure is shown next to the Load more control.
            if (queryVersion == this._queryVersion)
            {
                this._loadMoreError = exception.Message;
            }
        }
        finally
        {
            this._isLoadingMore = false;
            this.NotifyShellRefreshChanged();
        }
    }

    private async Task RefreshCurrentQueryAsync(CancellationToken cancellationToken)
    {
        var queryVersion = this._queryVersion;
        var visiblePageSize = Math.Max(DefaultPageSize, this._nodes.Count);
        var snapshot = await this.ReadSnapshotAsync(
          continuationToken: null,
          pageSize: visiblePageSize,
          cancellationToken);

        await this.ApplyPageStateAsync(() =>
        {
            if (queryVersion == this._queryVersion)
            {
                this.ApplySnapshot(snapshot, append: false);
            }
        });
    }

    private async Task<NodesSnapshot> ReadSnapshotAsync(
        string? continuationToken,
        int pageSize,
        CancellationToken cancellationToken)
    {
        var nodePageTask = NodeReader.SearchNodesAsync(
          this._filters.ToQuery(pageSize, continuationToken),
          cancellationToken)
          .AsTask();
        var activeCountTask = this.ReadNodeHealthCountAsync(NodeHealthState.Active, cancellationToken);
        var staleCountTask = this.ReadNodeHealthCountAsync(NodeHealthState.Stale, cancellationToken);
        var deadCountTask = this.ReadNodeHealthCountAsync(NodeHealthState.Dead, cancellationToken);

        await Task.WhenAll(nodePageTask, activeCountTask, staleCountTask, deadCountTask);

        return new NodesSnapshot(
          nodePageTask.Result,
          new NodeHealthCounts(
            activeCountTask.Result,
            staleCountTask.Result,
            deadCountTask.Result));
    }

    private async Task<int> ReadNodeHealthCountAsync(
        NodeHealthState state,
        CancellationToken cancellationToken)
    {
        var page = await NodeReader.SearchNodesAsync(
          new NodeInspectionQuery(State: state, PageSize: 1),
          cancellationToken)
          .ConfigureAwait(false);

        return Convert.ToInt32(page.TotalCount, CultureInfo.InvariantCulture);
    }

    private void ApplySnapshot(
        NodesSnapshot snapshot,
        bool append)
    {
        if (!append)
        {
            this._nodes.Clear();
        }

        this._nodes.AddRange(snapshot.Page.Nodes);
        this._nodePage = snapshot.Page;
        this._healthCounts = snapshot.HealthCounts;
        this._loadError = null;
    }

    private bool IsTileSelected(NodeHealthState? state)
      => this._filters.StateFilter == state;

    private int TileCount(NodeHealthState? state)
      => state switch
      {
          NodeHealthState.Active => this.ActiveNodeCount,
          NodeHealthState.Stale => this.StaleNodeCount,
          NodeHealthState.Dead => this.DeadNodeCount,
          _ => this.TotalNodeCount,
      };

    // Selecting the active tile again clears the health filter; the node ID filter is kept either way.
    private string TileHref(NodeHealthState? state)
      => DashboardNodeFilterQuery.ToHref(new DashboardNodeFilters
      {
          State = state is { } value && !this.IsTileSelected(value) ? value.ToString() : string.Empty,
          NodeId = this._filters.NodeId,
      });

    private string TileClass(HealthTile tile)
      => string.Concat(
        "nodes-health__tile nodes-health__tile--",
        tile.Tone,
        (tile.State is NodeHealthState.Stale or NodeHealthState.Dead) && this.TileCount(tile.State) > 0
          ? " nodes-health__tile--attention"
          : string.Empty);

    private static string TileTitle(HealthTile tile, bool selected)
      => tile.State is null || selected
        ? "Show all nodes"
        : string.Concat("Show only ", tile.Label.ToLowerInvariant(), " nodes");

    private static string HealthLabel(NodeHealthState state)
      => state switch
      {
          NodeHealthState.Active => "Active",
          NodeHealthState.Stale => "Stale",
          NodeHealthState.Dead => "Dead",
          _ => state.ToString(),
      };

    private static string HealthBadgeClass(NodeHealthState state)
      => state switch
      {
          NodeHealthState.Active => "sd-badge sd-status nodes-badge nodes-badge--success",
          NodeHealthState.Stale => "sd-badge sd-status nodes-badge nodes-badge--warning",
          NodeHealthState.Dead => "sd-badge sd-status nodes-badge nodes-badge--destructive",
          _ => "sd-badge sd-status nodes-badge",
      };

    private static string RunningText(NodeInspectionSummary node)
      => string.Create(CultureInfo.InvariantCulture, $"{DashboardFormat.Count(node.CurrentExecutionCount)} / {DashboardFormat.Count(node.MaxConcurrentExecutionsPerNode)}");

    private static string RunningTitle(NodeInspectionSummary node)
      => string.Create(
        CultureInfo.InvariantCulture,
        $"{DashboardFormat.Count(node.CurrentExecutionCount)} of {DashboardFormat.Count(node.MaxConcurrentExecutionsPerNode)} execution slots in use");

    private static double LoadPercent(NodeInspectionSummary node)
      => node.MaxConcurrentExecutionsPerNode <= 0
        ? 0
        : Math.Clamp((double)node.CurrentExecutionCount / node.MaxConcurrentExecutionsPerNode * 100, 0, 100);

    // Muted when the node isn't heartbeating or has nothing running; amber from 80% of its slots.
    private static string LoadBarClass(NodeInspectionSummary node)
    {
        if (node.CurrentExecutionCount <= 0 || node.State != NodeHealthState.Active)
        {
            return "nodes-load__bar nodes-load__bar--idle";
        }

        return LoadPercent(node) >= 80
          ? "nodes-load__bar nodes-load__bar--busy"
          : "nodes-load__bar";
    }

    private sealed record HealthTile(
        NodeHealthState? State,
        string Label,
        string Caption,
        string Tone);

    private sealed record NodesSnapshot(
        NodeInspectionPage Page,
        NodeHealthCounts HealthCounts);

    private sealed record NodeHealthCounts(
        int ActiveNodeCount,
        int StaleNodeCount,
        int DeadNodeCount)
    {
        public int TotalNodeCount
          => this.ActiveNodeCount + this.StaleNodeCount + this.DeadNodeCount;
    }
}
