@implements IAsyncDisposable

<span class="@Class" title="@DashboardFormat.Utc(Since)">@DashboardFormat.Elapsed(ClockSubscription.NowUtc - Since)</span>

@code {
    private DashboardClockSubscription? _clockSubscription;

    [Inject]
    private DashboardClock Clock { get; set; } = null!;

    /// <summary>
    /// When the still-running wait or attempt began.
    /// </summary>
    [Parameter, EditorRequired]
    public DateTimeOffset Since { get; set; }

    [Parameter]
    public string? Class { get; set; }

    // Created on first use, after injection.
    private DashboardClockSubscription ClockSubscription
      => this._clockSubscription ??= new DashboardClockSubscription(this.Clock, this.InvokeAsync, this.StateHasChanged);

    protected override void OnParametersSet()
      => this.ClockSubscription.Refresh();

    protected override void OnAfterRender(bool firstRender)
    {
        // Counts up on the shared circuit clock, like the relative timestamps.
        if (firstRender)
        {
            this.ClockSubscription.Start();
        }
    }

    public ValueTask DisposeAsync()
    {
        this.ClockSubscription.Dispose();
        return ValueTask.CompletedTask;
    }
}
