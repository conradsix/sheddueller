@implements IAsyncDisposable

<div class="@CssClass" title="@Tooltip" aria-label="@AccessibleLabel">
    <span class="@RelativeClass">@RelativeText</span>
    @if (Inline && Value is not null)
    {
        <span class="@SeparatorClass" aria-hidden="true">·</span>
        <span class="@AbsoluteClass">@DashboardFormat.UtcMinute(Value)</span>
    }
    else if (!Inline)
    {
        <span class="@AbsoluteClass">@DashboardFormat.Utc(Value)</span>
    }
</div>

@code {
    private DateTimeOffset _nowUtc;
    private bool _subscribed;
    private bool _disposed;

    [Inject]
    private DashboardClock Clock { get; set; } = null!;

    [Parameter]
    public DateTimeOffset? Value { get; set; }

    [Parameter]
    public DateTimeOffset? NowUtc { get; set; }

    [Parameter]
    public string? Prefix { get; set; }

    [Parameter]
    public bool AllowFutureRelative { get; set; } = true;

    [Parameter]
    public bool AlignEnd { get; set; }

    [Parameter]
    public bool Inline { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "-";

    [Parameter]
    public string BaseClass { get; set; } = "sd-timestamp";

    private DateTimeOffset CurrentNowUtc
      => this.NowUtc ?? this._nowUtc;

    private string RelativeText
      => DashboardFormat.Relative(this.Value, this.CurrentNowUtc, this.Prefix, this.EmptyText, this.AllowFutureRelative);

    private string? Tooltip
      => this.Inline && this.Value is not null ? DashboardFormat.Utc(this.Value) : null;

    private string? AccessibleLabel
      => this.Inline && this.Value is not null
        ? string.Concat(this.RelativeText, ", ", DashboardFormat.Utc(this.Value))
        : null;

    private string CssClass
      => string.Concat(
        this.BaseClass,
        this.Inline ? string.Concat(" ", this.BaseClass, "--inline") : string.Empty,
        this.AlignEnd ? string.Concat(" ", this.BaseClass, "--end") : string.Empty);

    private string RelativeClass
      => string.Concat(this.BaseClass, "__relative");

    private string AbsoluteClass
      => string.Concat(this.BaseClass, "__absolute");

    private string SeparatorClass
      => string.Concat(this.BaseClass, "__separator");

    protected override void OnParametersSet()
      => this._nowUtc = this.Clock.UtcNow;

    protected override void OnAfterRender(bool firstRender)
    {
        // Relative text only needs the shared circuit clock; one timer serves every timestamp on the page.
        if (firstRender && this.NowUtc is null && !this._disposed)
        {
            this.Clock.Ticked += this.OnClockTicked;
            this._subscribed = true;
        }
    }

    public ValueTask DisposeAsync()
    {
        this._disposed = true;
        if (this._subscribed)
        {
            this.Clock.Ticked -= this.OnClockTicked;
            this._subscribed = false;
        }

        return ValueTask.CompletedTask;
    }

    private void OnClockTicked()
      => _ = this.InvokeAsync(() =>
      {
          if (!this._disposed)
          {
              this._nowUtc = this.Clock.UtcNow;
              this.StateHasChanged();
          }
      });
}
