@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject DashboardNavigationState NavigationState

<CascadingValue Name="DashboardShellRefresh" Value="_refreshContext">
    <div class="sd-shell">
        <aside class="sd-sidebar" aria-label="Dashboard navigation">
            <a class="sd-brand" href="">
                <span class="sd-brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 18 18" fill="currentColor">
                        <rect x="2" y="3" width="9" height="2.6" rx="1.3" />
                        <rect x="5" y="7.7" width="11" height="2.6" rx="1.3" />
                        <rect x="2" y="12.4" width="6" height="2.6" rx="1.3" />
                        <rect x="10" y="12.4" width="6" height="2.6" rx="1.3" opacity=".55" />
                    </svg>
                </span>
                <span class="sd-brand__text">
                    <span class="sd-brand__name">Sheddueller</span>
                    <span class="sd-brand__caption">Dashboard</span>
                </span>
            </a>

            <nav class="sd-nav" aria-label="Primary">
                <div class="sd-nav__label">Monitor</div>
                @foreach (var item in MonitorNavigation)
                {
                    <NavLink class="sd-nav__item" href="@item.Href" Match="@item.Match" data-sd-nav="@item.Key" data-sd-nav-key="@item.ShortcutKey"
                             data-sd-tooltip="@item.Label" data-sd-tooltip-when="collapsed" data-sd-tooltip-side="right">
                        <Icon Name="@item.Icon" />
                        <span class="sd-nav__text">@item.Label</span>
                    </NavLink>
                }

                <div class="sd-nav__label">Configure</div>
                <NavLink class="sd-nav__item" href="settings" data-sd-nav="settings"
                         data-sd-tooltip="Settings" data-sd-tooltip-when="collapsed" data-sd-tooltip-side="right">
                    <Icon Name="settings" />
                    <span class="sd-nav__text">Settings</span>
                </NavLink>
            </nav>

            <div class="sd-sidebar__footer">
                <div class="sd-theme-row">
                    <span>Theme</span>
                    <div class="sd-tabs sd-tabs--sm" role="radiogroup" aria-label="Theme">
                        <button type="button" class="sd-tabs__tab" role="radio" data-sd-theme="system" aria-label="Match system theme" data-sd-tooltip="System">
                            <Icon Name="monitor" />
                        </button>
                        <button type="button" class="sd-tabs__tab" role="radio" data-sd-theme="light" aria-label="Light theme" data-sd-tooltip="Light">
                            <Icon Name="sun" />
                        </button>
                        <button type="button" class="sd-tabs__tab" role="radio" data-sd-theme="dark" aria-label="Dark theme" data-sd-tooltip="Dark">
                            <Icon Name="moon" />
                        </button>
                    </div>
                </div>
                <button type="button" class="sd-nav__item" data-sd-open-dialog="sd-shortcuts"
                        data-sd-tooltip="Keyboard shortcuts" data-sd-tooltip-when="collapsed" data-sd-tooltip-side="right">
                    <Icon Name="keyboard" />
                    <span class="sd-nav__text">Keyboard shortcuts</span>
                    <Kbd>?</Kbd>
                </button>
            </div>
        </aside>
        <div class="sd-scrim" data-sd-action="close-nav"></div>

        <div class="sd-inset">
            <header class="sd-topbar">
                <IconButton Icon="panel-left" Label="Toggle sidebar" data-sd-action="toggle-sidebar" />
                <span class="sd-topbar__divider" aria-hidden="true"></span>
                <nav class="sd-breadcrumbs" aria-label="Breadcrumb">
                    @if (_breadcrumbParent is { } parent)
                    {
                        <a href="@parent.Href">@parent.Label</a>
                        <Icon Name="chevron-right" />
                    }
                    <span aria-current="page">@_breadcrumbCurrent</span>
                </nav>
                <span class="sd-topbar__spacer"></span>

                <button type="button" class="sd-command-trigger" data-sd-action="command" aria-label="Open command menu">
                    <Icon Name="search" />
                    <span class="sd-command-trigger__text">Go to a page, job or action…</span>
                    <Kbd><span data-sd-mod-key></span>K</Kbd>
                </button>

                @if (CurrentRefresh is { } refresh)
                {
                    <IconButton Icon="refresh-cw" Label="Refresh now" Disabled="refresh.Coordinator.IsRefreshing"
                                OnClick="RefreshNowAsync" data-sd-action-refresh="true" />
                    <button type="button" class="@LiveClass(refresh)" aria-pressed="@(refresh.Coordinator.AutoRefreshEnabled ? "true" : "false")"
                            data-sd-action-live="true" data-sd-tooltip="@LiveTooltip(refresh)" @onclick="ToggleShellAutoRefreshAsync">
                        <span class="sd-live__dot" aria-hidden="true"></span>
                        <span>@LiveText(refresh)</span>
                    </button>
                }
            </header>

            <main class="sd-main">
                @Body
            </main>
        </div>
    </div>

    <dialog id="sd-command" class="sd-command" aria-label="Command menu" closedby="any">
        <div class="sd-command__input">
            <Icon Name="search" />
            <input id="sd-command-input" placeholder="Go to a page, open a job by ID, or run an action…" autocomplete="off"
                   spellcheck="false" role="combobox" aria-expanded="true" aria-controls="sd-command-list" aria-label="Command" />
        </div>
        <div class="sd-command__list" id="sd-command-list" role="listbox" aria-label="Results"></div>
        <div class="sd-command__footer">
            <span><Kbd>↑</Kbd><Kbd>↓</Kbd> Move</span>
            <span><Kbd>↵</Kbd> Open</span>
            <span><Kbd>Esc</Kbd> Close</span>
        </div>
    </dialog>

    <dialog id="sd-shortcuts" class="sd-dialog" aria-labelledby="sd-shortcuts-title" closedby="any">
        <h2 id="sd-shortcuts-title" class="sd-dialog__title">Keyboard shortcuts</h2>
        <div class="sd-shortcuts">
            @foreach (var shortcut in Shortcuts)
            {
                <div class="sd-shortcuts__row">
                    <span>@shortcut.Description</span>
                    <span class="sd-shortcuts__keys">
                        @foreach (var key in shortcut.Keys)
                        {
                            @if (key == "mod")
                            {
                                <Kbd data-sd-mod-key="true"></Kbd>
                            }
                            else
                            {
                                <Kbd>@key</Kbd>
                            }
                        }
                    </span>
                </div>
            }
        </div>
        <div class="sd-dialog__footer">
            <Button Variant="ButtonVariant.Primary" data-sd-close-dialog="true">Done</Button>
        </div>
    </dialog>
</CascadingValue>

@code {
    private static readonly NavigationItem[] MonitorNavigation =
    [
        new("overview", "Overview", "", "layout-dashboard", "o", NavLinkMatch.All),
        new("jobs", "Jobs", "jobs", "list", "j", NavLinkMatch.Prefix),
        new("schedules", "Schedules", "schedules", "calendar-clock", "s", NavLinkMatch.Prefix),
        new("concurrency-groups", "Concurrency groups", "concurrency-groups", "layers", "c", NavLinkMatch.Prefix),
        new("nodes", "Nodes", "nodes", "server", "n", NavLinkMatch.Prefix),
        new("metrics", "Metrics", "metrics", "activity", "m", NavLinkMatch.Prefix),
    ];

    private static readonly ShortcutItem[] Shortcuts =
    [
        new("Open the command menu", ["mod", "K"]),
        new("Focus the page search", ["/"]),
        new("Go to Overview, Jobs, Schedules", ["G", "O", "·", "G", "J", "·", "G", "S"]),
        new("Go to Concurrency groups, Nodes, Metrics", ["G", "C", "·", "G", "N", "·", "G", "M"]),
        new("Pause or resume live updates", ["P"]),
        new("Collapse the sidebar", ["["]),
        new("Close a dialog or menu", ["Esc"]),
        new("Show this list", ["?"]),
    ];

    private readonly DashboardShellRefreshContext _refreshContext = new();
    private (string Label, string Href)? _breadcrumbParent;
    private string _breadcrumbCurrent = "Overview";
    private bool _disposed;

    private DashboardShellRefreshRegistration? CurrentRefresh
      => this._refreshContext.Current;

    protected override void OnInitialized()
    {
        this._refreshContext.Changed += this.OnRefreshContextChanged;
        this.Navigation.LocationChanged += this.OnLocationChanged;
        this.UpdateBreadcrumbs();
    }

    public void Dispose()
    {
        this._disposed = true;
        this._refreshContext.Changed -= this.OnRefreshContextChanged;
        this.Navigation.LocationChanged -= this.OnLocationChanged;
    }

    private void OnRefreshContextChanged()
    {
        if (!this._disposed)
        {
            _ = this.InvokeAsync(this.StateHasChanged);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (!this._disposed)
        {
            _ = this.InvokeAsync(() =>
            {
                this.UpdateBreadcrumbs();
                this.StateHasChanged();
            });
        }
    }

    private void UpdateBreadcrumbs()
    {
        var path = this.Navigation.ToBaseRelativePath(this.Navigation.Uri);
        var end = path.IndexOfAny(['?', '#']);
        var segments = (end >= 0 ? path[..end] : path).Split('/', StringSplitOptions.RemoveEmptyEntries);

        this._breadcrumbParent = null;
        if (segments.Length == 0)
        {
            this._breadcrumbCurrent = "Overview";
            return;
        }

        if (segments.Length > 1 && string.Equals(segments[0], "jobs", StringComparison.OrdinalIgnoreCase))
        {
            this._breadcrumbParent = ("Jobs", this.NavigationState.JobsListHref);
            var id = Uri.UnescapeDataString(segments[1]);
            this._breadcrumbCurrent = string.Concat("Job ", id.Length > 8 ? id[..8] : id);
            return;
        }

        this._breadcrumbCurrent = segments[0].ToLowerInvariant() switch
        {
            "jobs" => "Jobs",
            "schedules" => "Schedules",
            "concurrency-groups" => "Concurrency groups",
            "nodes" => "Nodes",
            "metrics" => "Metrics",
            "settings" => "Settings",
            _ => "Not found",
        };
    }

    private async Task ToggleShellAutoRefreshAsync()
      => await this._refreshContext.ToggleCurrentAutoRefreshAsync();

    private async Task RefreshNowAsync()
      => await this._refreshContext.RefreshCurrentAsync();

    private static string LiveClass(DashboardShellRefreshRegistration refresh)
    {
        var coordinator = refresh.Coordinator;
        var state = coordinator.RefreshError is not null
          ? "sd-live--error"
          : !coordinator.AutoRefreshEnabled
            ? "sd-live--paused"
            : coordinator.IsRefreshing && refresh.ShowRefreshing ? "sd-live--refreshing" : null;

        return UiClasses.Join(UiClasses.Button(ButtonVariant.Outline, ButtonSize.Small, iconOnly: false), "sd-live", state);
    }

    private static string LiveText(DashboardShellRefreshRegistration refresh)
      => refresh.Coordinator.RefreshError is not null
        ? "Refresh failed"
        : refresh.Coordinator.AutoRefreshEnabled ? "Live" : "Paused";

    private static string LiveTooltip(DashboardShellRefreshRegistration refresh)
    {
        var coordinator = refresh.Coordinator;
        if (coordinator.RefreshError is { } error)
        {
            return string.Concat("Last refresh failed: ", error);
        }

        var nowUtc = DateTimeOffset.UtcNow;
        var lastUpdatedUtc = refresh.GetLastUpdatedUtc(nowUtc);
        var updated = lastUpdatedUtc is null
          ? "Not updated yet"
          : DashboardFormat.Relative(lastUpdatedUtc, nowUtc, prefix: "Updated", allowFuture: false);
        return coordinator.AutoRefreshEnabled
          ? string.Concat(updated, ". Click to pause live updates.")
          : string.Concat(updated, ". Live updates are paused; click to resume.");
    }

    private sealed record NavigationItem(string Key, string Label, string Href, string Icon, string ShortcutKey, NavLinkMatch Match);

    private sealed record ShortcutItem(string Description, string[] Keys);
}
