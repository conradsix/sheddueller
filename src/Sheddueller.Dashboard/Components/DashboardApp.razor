@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<ShedduellerDashboardOptions> DashboardOptions

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Navigation.BaseUri" />
    <title>Sheddueller</title>
    <link rel="icon" type="image/svg+xml" href="_content/Sheddueller.Dashboard/favicon.svg" />
    <link rel="preload" href="_content/Sheddueller.Dashboard/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link href="_content/Sheddueller.Dashboard/css/sheddueller.css?v=@DashboardAssetVersion" rel="stylesheet" />
    @foreach (var page in PageStyleSheets)
    {
        <link href="_content/Sheddueller.Dashboard/css/pages/@(page).css?v=@DashboardAssetVersion" rel="stylesheet" />
    }
    <link href="_content/Sheddueller.Dashboard/vendor/uplot/uPlot.min.css" rel="stylesheet" />
    <script src="_content/Sheddueller.Dashboard/sheddueller-theme.js?v=@DashboardAssetVersion"></script>
</head>
<body>
    <Routes @rendermode="DashboardRenderMode" />
    <script src="_content/Sheddueller.Dashboard/vendor/uplot/uPlot.iife.min.js"></script>
    <script src="_content/Sheddueller.Dashboard/sheddueller-ui.js?v=@DashboardAssetVersion"></script>
    <script src="_content/Sheddueller.Dashboard/vendor/sheddueller-job-views.js?v=@DashboardAssetVersion"></script>
    <script src="_content/Sheddueller.Dashboard/vendor/sheddueller-throughput-chart.js?v=@DashboardAssetVersion"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // One stylesheet per page (css/pages/*.css, all in the "pages" cascade layer).
    private static readonly string[] PageStyleSheets =
      ["jobs", "job-detail", "overview", "schedules", "concurrency-groups", "nodes", "metrics", "settings"];

    private IComponentRenderMode DashboardRenderMode
      => DashboardOptions.Value.Prerender
        ? InteractiveServer
        : new InteractiveServerRenderMode(prerender: false);

    // Cache-busts the dashboard's own assets. The assembly doesn't change while the app runs, so this is worked out
    // (reflection and a file check) once rather than for every asset link on every request.
    private static readonly string DashboardAssetVersion = CreateAssetVersion();

    private static string CreateAssetVersion()
    {
        var assembly = typeof(ShedduellerDashboardOptions).Assembly;
        var attribute = (System.Reflection.AssemblyInformationalVersionAttribute?)Attribute.GetCustomAttribute(
          assembly,
          typeof(System.Reflection.AssemblyInformationalVersionAttribute));
        var version = attribute?.InformationalVersion ?? assembly.GetName().Version?.ToString() ?? "dev";
        var location = assembly.Location;
        var stamp = string.IsNullOrEmpty(location) || !File.Exists(location)
          ? assembly.ManifestModule.ModuleVersionId.ToString("N")
          : File.GetLastWriteTimeUtc(location).Ticks.ToString(System.Globalization.CultureInfo.InvariantCulture);

        return Uri.EscapeDataString(string.Concat(version, ".", stamp));
    }
}
