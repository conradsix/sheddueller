<Button Variant="Variant" Size="Size" IconOnly="true" Icon="@Icon" Href="@Href" Disabled="Disabled" Class="@Class"
        OnClick="OnClick" aria-label="@Label" data-sd-tooltip="@(ShowTooltip ? Label : null)"
        @attributes="AdditionalAttributes" />

@code {
    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    /// <summary>
    /// Accessible name, also shown as the tooltip.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Default;

    [Parameter]
    public bool ShowTooltip { get; set; } = true;

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
