@if (Href is null)
{
    <button type="button" role="menuitem" class="@CssClass" disabled="@Disabled" @onclick="OnClick" @attributes="AdditionalAttributes">
        @if (Icon is not null)
        {
            <Icon Name="@Icon" />
        }
        <span>@ChildContent</span>
    </button>
}
else
{
    <a role="menuitem" class="@CssClass" href="@Href" @attributes="AdditionalAttributes">
        @if (Icon is not null)
        {
            <Icon Name="@Icon" />
        }
        <span>@ChildContent</span>
    </a>
}

@code {
    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool Destructive { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
      => UiClasses.Join("sd-menu__item", this.Destructive ? "sd-menu__item--destructive" : null);
}
