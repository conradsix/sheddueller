@if (Href is null)
{
    <button type="@Type" class="@CssClass" disabled="@Disabled" @onclick="OnClick" @attributes="AdditionalAttributes">
        @if (Icon is not null)
        {
            <Icon Name="@Icon" />
        }
        @ChildContent
        @if (IconEnd is not null)
        {
            <Icon Name="@IconEnd" />
        }
    </button>
}
else
{
    <a href="@Href" class="@CssClass" aria-disabled="@(Disabled ? "true" : null)" @attributes="AdditionalAttributes">
        @if (Icon is not null)
        {
            <Icon Name="@Icon" />
        }
        @ChildContent
        @if (IconEnd is not null)
        {
            <Icon Name="@IconEnd" />
        }
    </a>
}

@code {
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Default;

    /// <summary>
    /// Square button sized for a single icon. Give it an <c>aria-label</c>, or use <see cref="IconButton" />.
    /// </summary>
    [Parameter]
    public bool IconOnly { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? IconEnd { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    /// <summary>
    /// Renders a link styled as a button.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
      => UiClasses.Button(this.Variant, this.Size, this.IconOnly, this.Class);
}
