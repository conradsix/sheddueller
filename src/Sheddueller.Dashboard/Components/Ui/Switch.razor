<label class="sd-switch-label">
    <input type="checkbox" role="switch" class="sd-switch" checked="@Value" disabled="@Disabled"
           @onchange="OnChangeAsync" @attributes="AdditionalAttributes" />
    @ChildContent
</label>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnChangeAsync(ChangeEventArgs args)
    {
        this.Value = args.Value is true;
        await this.ValueChanged.InvokeAsync(this.Value);
    }
}
